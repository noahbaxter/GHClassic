; The campaign picker's blue pages from the games' own campaigns to the
; hacks with a career of their own (campaigns.dta), each named by its file,
; and green on one goes into its career as any other's does.
#include common/first_boot.dta
{gamecfg set mode career}
{campaign set_profile_name "The Testers" 0}
{ui goto_screen chooseprof_screen}
(wait_screen chooseprof_screen)
(press green)
(wait_screen ghc_campaign_screen)
(wait 1)
(expect {ghc_campaign_panel get page} 0)
(shot official)
(press blue)
(wait 1)
(expect {ghc_campaign_panel get page} 1)
(expect {elem {ghc_campaign_panel get games} 0} {elem {hacks career} 0})
(shot bonus)
(press green)
(wait_screen sel_difficulty_screen 40)
(expect {campaigns active} {elem {hacks career} 0})
(shot difficulty)
(quit)

; Every venue of every game, a song started twice in each: the guitarist is
; on the venue's start mark, never the origin a guitarist never placed stands
; at. Each start prints the game whose room it is and the venue. A song left
; puts the venues back to GH2's, so another game's are set before each start.
(needs gh1 gh80s)
#include common/first_boot.dta
{func ghc_spawn_set ($v)
   {game set_song iloverockandroll}
   {{game get_player_config 0} set autoplay TRUE}
   {game set_quickplay}
   {game set_venue $v}
}
{func ghc_spawn_from ($g $v)
   {campaigns venues_from $g}
   {ghc_spawn_set $v}
}


; The 360 GH2 on easy has no encore: it ends at the arena's fifth song.
(needs gh2x)
{set $pick gh2x}
{set $d1 none}
{set $d2 none}
{set $d3 none}
{set $v1 down}
{set $finale_venue arena}
{set $b1 x_madhouse}
{set $b2 x_trooper}
{set $b3 x_rockthistown}
{set $b4 x_laidtorest}
{set $idx 4}
{set $play x_psychobilly}
#include common/finale_direct.dta

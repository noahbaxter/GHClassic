; GH1's Battle Axe (gh1/career.cpp, gh1/menus.dta): no band's in a new
; career, and won by beating the career on expert, on the second page of
; its win screen with the guitar turning on it.
(needs gh1)
#include common/first_boot.dta
{set $pick gh1}
#include common/career_start.dta
(expect {campaign is_unlocked gh2_battleaxe} 0)
(expect {localize gh2_battleaxe} "Battle Axe")
(expect {localize gh2_battleaxe_desc} "Judge this race not by its remains.")
; The same band's expert career.
{ui goto_screen sel_difficulty_screen}
(wait_screen sel_difficulty_screen)
(wait 1)
(press down)
(press down)
(press green)
(wait_screen sel_character_new_screen)
(wait_until {char_single are_chars_loaded})
(wait 1)
(press green)
(wait_screen sel_guitar_new_screen)
(wait 3)
(press green)
(wait_screen career_screen 40)
(wait 1)
(expect {game get_difficulty 0} 3)
(expect {campaign is_unlocked gh2_battleaxe} 0)
{foreach $s
   (gh1_iloverockandroll gh1_iwannabesedated gh1_thunderkiss65 gh1_smokeonthewater gh1_infected
      gh1_ironman gh1_morethanafeeling gh1_yougotanotherthingcomin gh1_takemeout gh1_sharpdressedman
      gh1_killerqueen gh1_heyyou gh1_stellar gh1_heartfullofblack gh1_symphofdestruction
      gh1_ziggystardust gh1_fatlip gh1_cochise gh1_takeitoff gh1_unsung
      gh1_spanishcastlemagic gh1_higherground gh1_nooneknows gh1_aceofspades gh1_crossroads
      gh1_godzilla gh1_texasflood gh1_frankenstein gh1_cowboysfromhell)
   {campaign cheat_beat_song $s 100000}}
(press green)
(wait_screen sel_venue_screen 40)
(wait 1)
{game set_venue gh1_arena}
{ui goto_screen sel_song_screen}
(wait_screen sel_song_screen)
(wait 1)
{set $index 4}
#include common/career_song.dta
(expect {gamecfg get_song} gh1_barkatthemoon)
(wait 3)
{player0 win 5}
(wait_screen win_game_screen 60)
(wait_until {win_game_screen can_continue} 30)
(wait 1)
(shot won)
(expect {campaign is_unlocked gh2_battleaxe} 0)
(press green)
(wait 0.5)
(shot to_white)
(wait 6)
(shot battleaxe)
(expect {campaign is_unlocked gh2_battleaxe} 1)
(wait 2)
(press green)
(wait 6)
; In the band's guitars from then on.
{ui goto_screen sel_guitar_new_screen}
(wait_screen sel_guitar_new_screen)
(wait 2)
(press up)
(wait 2)
(shot picker)
(quit)

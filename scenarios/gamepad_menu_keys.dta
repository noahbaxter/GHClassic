; A gamepad in a menu reads A to pick and B to back out whatever its frets
; are mapped to, as a console does. Its green is moved onto LB here, as a
; player with frets on LB, LT, RB, RT and A has it: LB then picks nothing in a
; menu, and A (a fret of theirs in a song) still picks.
#include common/first_boot.dta
(controller pad "045e:028e" pad)
(wait 0.5)
(press dpdown pad)
(expect {seat_has 0 pad} 1)
{ui goto_screen ghc_controllers_screen}
(wait_screen ghc_controllers_screen)
(wait 1)
(key Return)
(wait 0.3)
(expect {ghc_controllers rebinding} 1)
(hold pad leftshoulder)
(wait 0.3)
(hold pad)
(wait 0.3)
(expect {ghc_controllers rebinding} 0)
(key Escape)
(wait_screen options_screen)
(wait 1)
{ui goto_screen main_screen}
(wait_screen main_screen)
(wait 1)
(expect {main_screen focus_name} main_options.btn)
(press leftshoulder pad)
(wait 0.5)
(expect {{ui current_screen} name} main_screen)
(press a pad)
(wait_screen options_screen 10)
(press b pad)
(wait_screen main_screen 10)
(quit)

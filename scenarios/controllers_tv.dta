; The Controllers screen's TV: snow until a control is pressed, then that
; control's own channel, the same one each time, both strums one.
#include common/first_boot.dta
(device guitar)
(press down guitar)
{ui goto_screen ghc_controllers_screen}
(wait_screen ghc_controllers_screen)
(wait 1)
(expect {ghc_controllers channel} tv_bad_snow_1.tex)
(shot snow)
(hold guitar green)
(wait 0.3)
(expect {ghc_controllers channel} tv_good_rocker_1.tex)
(shot green)
(hold guitar red)
(wait 0.3)
(expect {ghc_controllers channel} tv_good_city_fire_1.tex)
(shot red)
(hold guitar yellow)
(wait 0.3)
(expect {ghc_controllers channel} tv_good_caution_1.tex)
(shot yellow)
(hold guitar blue)
(wait 0.3)
(expect {ghc_controllers channel} tv_freq.tex)
(shot blue)
(hold guitar orange)
(wait 0.3)
(expect {ghc_controllers channel} tv_amplitude.tex)
(shot orange)
(hold guitar up)
(wait 0.3)
(expect {ghc_controllers channel} tv_good_equalizer.tex)
(hold guitar)
(wait 0.3)
(hold guitar down)
(wait 0.3)
(expect {ghc_controllers channel} tv_good_equalizer.tex)
(shot strum)
(hold guitar star_power)
(wait 0.3)
(expect {ghc_controllers channel} tv_good_nuke.tex)
(shot star_power)
(hold guitar start)
(wait 0.3)
(expect {ghc_controllers channel} tv_good_anarchy.tex)
(shot start)
(hold guitar tilt)
(wait 0.3)
(expect {ghc_controllers channel} tv_bad_skull1.tex)
(shot tilt)
; Pressed again, green is its channel again.
(hold guitar green)
(wait 0.3)
(expect {ghc_controllers channel} tv_good_rocker_1.tex)
(hold guitar)
(quit)

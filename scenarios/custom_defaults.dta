; A custom song in quickplay with song defaults on plays its own cast
; (custom/cast.h), whatever the setup has picked: the fixture's guitar is
; an sg and its venue small1.
(songs songs)
#include common/first_boot.dta
{quickplay song_defaults 1}
{quickplay pick outfit gh2_punk1}
{quickplay pick guitar tobac}
{quickplay pick skin tobac_sunburst}
{quickplay pick venue gh1_basement}
{quickplay pick venue_game gh1}
{gamecfg set mode quickplay}
{setlist select custom}
{ui goto_screen qp_selsong_screen}
(wait_screen qp_selsong_screen)
(wait 3)
(press green)
(wait_screen qp_diff_screen)
(wait 1)
{{game get_player_config 0} set autoplay TRUE}
(press green)
(wait_screen game_screen 60)
(expect {custom ours {game get_song}} 1)
(print "cast " {game get_character_outfit} " " {game get_guitar} " " {game get_guitar_skin} " " {game get_venue} " " {campaigns venue_game})
(expect {!= {game get_character_outfit} gh2_punk1} 1)
(expect {game get_guitar} sg)
(expect {game get_venue} gh2_small1)
(expect {campaigns venue_game} gh2)
(wait 8)
(shot own_cast)
(quit)

; GH1's finishes in its campaign (gh1/guitars.cpp): each guitar holds GH1's
; own, and the ones built from GH1's disc load and play, shot from the front
; and close on the guitarist's hands: the six guitars GH2 has no model of,
; the three that are a texture on GH2's model, two GH2's scenes hold unsold,
; and two of GH2's own to set them against.
(needs gh1)
#include common/first_boot.dta
; As its career has them: out of one the guitars are GH2's with every
; game's finishes (qp_guitars.dta).
{set $pick gh1}
#include common/career_start.dta
(expect {campaigns live} gh1)
(expect {size {find $syscfg guitars sg skins}} 5)
(expect {elem {elem {find $syscfg guitars sg skins} 2} 0} sg_worn)
(expect {elem {find $syscfg guitars sg skins sg_worn outfit} 1} gh1_sg)
(expect {elem {elem {find $syscfg guitars es335 skins} 1} 0} es_triburst)
(expect {elem {elem {find $syscfg guitars battleaxe skins} 1} 0} battleaxe_gh1)
(expect {elem {elem {find $syscfg guitars scythe skins} 1} 0} scythe_gh1)
(expect {elem {find $syscfg store skin sg_ebony price} 1} 150)
(expect {elem {find $syscfg store skin lp_dbl_custom price} 1} 250)
(expect {size {find $syscfg store skin}} 32)
(expect {elem {find $syscfg store skin fv_black price} 1} 250)
; GH1's names, for a finish of GH2's and for ones that are not.
(expect {localize sg_cherry} "Cherry Gibson SG")
(expect {localize sg_ebony} "Ebony Gibson SG")
(expect {localize fv_worn} "Worn Cherry Gibson Flying V")
(expect {localize battleaxe_gh1} "Battle Axe")
(expect {localize scythe_gh1} "Scythe")
; Every finish to pick from, as the unlock-all cheat leaves them. The songs
; are quickplay's, out of the career, where each is lent to GH2's guitar.
{set $cheat_enabled_unlock_all 1}
{campaign set_all_access 1}
{set $disable_save 1}

{set $ghc_character metalgh1}
{set $ghc_guitar sg}
{set $ghc_finish sg_cherry}
#include common/guitar_shot.dta
(shot sg_cherry_far)
#include common/guitar_near.dta
(shot sg_cherry_near)
{set $ghc_finish sg_ebony}
#include common/guitar_shot.dta
(shot sg_ebony_far)
#include common/guitar_near.dta
(shot sg_ebony_near)
{set $ghc_finish sg_worn}
#include common/guitar_shot.dta
(shot sg_worn_far)
#include common/guitar_near.dta
(shot sg_worn_near)

{set $ghc_guitar flying_v}
{set $ghc_finish fv_white}
#include common/guitar_shot.dta
(shot fv_white_far)
#include common/guitar_near.dta
(shot fv_white_near)
{set $ghc_finish fv_bluecrack}
#include common/guitar_shot.dta
(shot fv_bluecrack_far)
#include common/guitar_near.dta
(shot fv_bluecrack_near)
{set $ghc_finish fv_worn}
#include common/guitar_shot.dta
(shot fv_worn_far)
#include common/guitar_near.dta
(shot fv_worn_near)

{set $ghc_guitar es335}
{set $ghc_finish es_triburst}
#include common/guitar_shot.dta
(shot es_triburst_far)
#include common/guitar_near.dta
(shot es_triburst_near)

{set $ghc_guitar lespaul_doublecut}
{set $ghc_finish lp_dbl_custom}
#include common/guitar_shot.dta
(shot lp_dbl_custom_far)
#include common/guitar_near.dta
(shot lp_dbl_custom_near)
{set $ghc_finish lp_dbl_red}
#include common/guitar_shot.dta
(shot lp_dbl_red_far)
#include common/guitar_near.dta
(shot lp_dbl_red_near)

{set $ghc_guitar battleaxe_reward}
{set $ghc_finish battleaxe_gh1}
#include common/guitar_shot.dta
(shot battleaxe_gh1_far)
#include common/guitar_near.dta
(shot battleaxe_gh1_near)

; The Grim Ripper's own.
{set $ghc_character grimgh1}
{set $ghc_guitar scythe}
{set $ghc_finish scythe_gh1}
#include common/guitar_shot.dta
(shot scythe_gh1_far)
#include common/guitar_near.dta
(shot scythe_gh1_near)

{set $ghc_character metalgh1}
{set $ghc_guitar lespaul}
{set $ghc_finish lp_gold}
#include common/guitar_shot.dta
(shot lp_gold_far)
#include common/guitar_near.dta
(shot lp_gold_near)

{set $ghc_guitar corvus}
{set $ghc_finish cor_snake}
#include common/guitar_shot.dta
(shot cor_snake_far)
#include common/guitar_near.dta
(shot cor_snake_near)

; The three Flying V finishes GH1's disc holds as loose textures, repainted
; for the V that shipped.
{set $ghc_guitar flying_v}
{set $ghc_finish fv_black}
#include common/guitar_shot.dta
(shot fv_black_far)
#include common/guitar_near.dta
(shot fv_black_near)
{set $ghc_finish fv_blue}
#include common/guitar_shot.dta
#include common/guitar_near.dta
(shot fv_blue_near)
{set $ghc_finish fv_yellow}
#include common/guitar_shot.dta
#include common/guitar_near.dta
(shot fv_yellow_near)

; The guitar on GH1's disc that nothing there names.
{set $ghc_guitar tobac}
{set $ghc_finish tobac_sunburst}
#include common/guitar_shot.dta
(shot tobac_far)
#include common/guitar_near.dta
(shot tobac_near)
(quit)

; The 80s on easy has no encore: it ends at fest's fourth song.
(needs gh80s)
{set $pick gh80s}
{set $d1 none}
{set $d2 none}
{set $d3 none}
{set $v1 down}
{set $finale_venue fest}
{set $b1 gh80s_aintnothinbut}
{set $b2 gh80s_lonelyisthenight}
{set $b3 gh80s_bathroomwall}
{set $b4 gh80s_bathroomwall}
{set $idx 3}
{set $play gh80s_losangeles}
#include common/finale_direct.dta

; Controllers plugged into SDL as real ones are (input.h), by their USB IDs:
; each gets its family's layout from the catalogue and plays through it on
; the Controllers screen and in the game, one rebinds there, and P1's is
; pulled out mid-song and plugged back into its seat.
#include common/first_boot.dta
(controller xplorer "1430:4748" pad)
(controller raphnet "289b:0080" joystick)
(controller dualsense "054c:0ce6" pad)
(wait 0.5)
; The first press takes P1: strum, which picks nothing on the main menu.
(press dpdown xplorer)
(expect {seat_has 0 xplorer} 1)
{ui goto_screen ghc_controllers_screen}
(wait_screen ghc_controllers_screen)
(wait 1)
; The X-plorer: frets on A B Y X LB, strum on the d-pad, star power on
; Back, tilt on right stick Y either way.
(hold xplorer a dpdown back righty-)
(wait 0.3)
(expect {ghc_controllers text title} "XBOX 360 GUITAR HERO GUITAR")
(expect {ghc_controllers held green} 1 0.01)
(expect {ghc_controllers held strum_down} 1 0.01)
(expect {ghc_controllers held star_power} 1 0.01)
(expect {ghc_controllers held tilt} 1 0.01)
; A row reads its first control and how many more, a chip a name cut to fit.
(expect {ghc_controllers text read 10} "RB +2")
(expect {ghc_controllers text chip 0} "P1  XBOX 360 GUITAR")
(shot xplorer)
(hold xplorer righty+ leftshoulder)
(wait 0.3)
(expect {ghc_controllers held tilt} 1 0.01)
(expect {ghc_controllers held orange} 1 0.01)
(hold xplorer)
; The raphnet Wii guitar, a plain joystick: buttons and its whammy's axis.
(hold raphnet button1 button6 axis2+)
(wait 0.3)
(expect {ghc_controllers text title} "WII GUITAR (RAPHNET)")
(expect {ghc_controllers held red} 1 0.01)
(expect {ghc_controllers held start} 1 0.01)
(expect {ghc_controllers held whammy} 1 0.01)
(shot raphnet)
(hold raphnet)
; A DualSense: GH2's joypad layout.
(hold dualsense leftshoulder rightshoulder back)
(wait 0.3)
(expect {ghc_controllers text title} DUALSENSE)
(expect {ghc_controllers held red} 1 0.01)
(expect {ghc_controllers held yellow} 1 0.01)
(expect {ghc_controllers held star_power} 1 0.01)
(shot dualsense)
(hold dualsense)
; The X-plorer's green rebound to X, then played by it. A rebind catches
; the raw button under SDL's layout, so it reads by number.
(hold xplorer a)
(wait 0.3)
(hold xplorer)
(wait 0.3)
(expect {ghc_controllers text title} "XBOX 360 GUITAR HERO GUITAR")
(expect {ghc_controllers focus} 0)
(key Return)
(wait 0.3)
(expect {ghc_controllers rebinding} 1)
(hold xplorer x)
(wait 0.3)
(hold xplorer)
(wait 0.3)
(expect {ghc_controllers rebinding} 0)
(expect {ghc_controllers text read 0} "Button 3")
(hold xplorer x)
(wait 0.3)
(expect {ghc_controllers held green} 1 0.01)
(hold xplorer)
(shot rebound)
; The DualSense's whammy rebound to its right stick, pushed and let go.
(hold dualsense back)
(wait 0.3)
(hold dualsense)
(wait 0.3)
(expect {ghc_controllers text title} DUALSENSE)
(key Up)
(key Up)
(key Up)
(expect {ghc_controllers focus} 9)
(key Return)
(wait 0.3)
(expect {ghc_controllers rebinding} 1)
(hold dualsense rightx+)
(wait 0.3)
(hold dualsense)
(wait 0.5)
(expect {ghc_controllers rebinding} 0)
(expect {ghc_controllers text read 9} "Axis 3 +")
(hold dualsense rightx+)
(wait 0.3)
(expect {ghc_controllers held whammy} 1 0.01)
(hold dualsense)
(key Escape)
(wait_screen options_screen)
(wait 1)
; Mid-song, P1's X-plorer pulled out pauses the song; the DualSense's press
; takes nothing, and the X-plorer back is P1 again, its green resuming.
{game set_song shoutatthedevil}
{{game get_player_config 0} set_difficulty easy}
{{game get_player_config 0} set autoplay TRUE}
{game set_quickplay}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait 1)
(expect {seat_has 0 xplorer} 1)
(unplug xplorer)
(wait_screen pause_controller_screen 10)
(press a dualsense)
(wait 1)
(expect {seat_has 0 dualsense} 0)
(wait_screen pause_controller_screen 1)
(controller xplorer "1430:4748" pad)
(wait 0.5)
(expect {seat_has 0 xplorer} 1)
(press x xplorer)
(wait_screen game_screen 10)
(quit)

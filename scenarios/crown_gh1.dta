; The full combo crown on GH1's song list, its own type built from GH2's: a
; GH1 song full combo'd on easy in quickplay wears it there.
(needs gh1)
#include common/first_boot.dta
{gamecfg set mode quickplay}
{game set_song iwannabesedated}
{{game get_player_config 0} set_difficulty easy}
{{game get_player_config 0} set autoplay TRUE}
{game set_quickplay}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait_screen endgame_screen 900)
(expect {campaigns full_combo iwannabesedated 0} 1)
{ui goto_screen main_screen}
(wait_screen main_screen)
{gamecfg set mode quickplay}
{setlist select gh1}
; The list's difficulty, which the menus put back to medium.
{{game get_player_config 0} set_difficulty easy}
{ui goto_screen qp_selsong_screen}
(wait_screen qp_selsong_screen)
(wait 2)
(shot gh1_list)
(quit)

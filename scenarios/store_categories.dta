; The store lists the categories its campaign sells in. GH2's has all six;
; GH1's has no Outfits, which it has none of, and no Videos, and down from
; Characters wraps to Guitars.
(needs gh1)
#include common/first_boot.dta
{set $pick gh2}
#include common/career_start.dta
{ui goto_screen store_screen}
(wait_screen store_screen)
(wait 2)
(expect {{store_panel find st_outfits.btn} showing} 1)
(expect {{store_panel find st_videos.btn} showing} 1)
(press up)
(expect {store_panel get category} video)
(press down)
(expect {store_panel get category} guitar)

{set $pick gh1}
#include common/career_start.dta
{ui goto_screen store_screen}
(wait_screen store_screen)
(wait 2)
(shot store)
(expect {{store_panel find st_characters.btn} showing} 1)
(expect {{store_panel find st_outfits.btn} showing} 0)
(expect {{store_panel find st_videos.btn} showing} 0)
(expect {store_panel get category} guitar)
(press down)
(press down)
(press down)
(expect {store_panel get category} character)
(press down)
(expect {store_panel get category} guitar)
(press up)
(expect {store_panel get category} character)
(quit)

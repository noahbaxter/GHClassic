; A gamepad plays a song as GH2 plays a DualShock, a fret press strumming;
; a guitar as a guitar. The seat's mode is set as its controller sits; the
; menus before the song answer the guitar either way.
#include common/first_boot.dta
(device pad)
(device guitar)
(press down pad)
(expect {seat_has 0 pad} 1)
(expect {game get_controller 0} guitar)
{game set_song shoutatthedevil}
{{game get_player_config 0} set_difficulty easy}
{{game get_player_config 0} set autoplay TRUE}
{game set_quickplay}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait 1)
(expect {game get_controller 0} joypad_guitar)
(quit)

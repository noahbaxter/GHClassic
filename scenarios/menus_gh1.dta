; GH1's campaign shows GH1's own menus, driven by GH2's scripts: its main
; menu down its buttons and round, and back to GH2's main menu.
(needs gh1)
#include common/first_boot.dta
(wait 1)
(shot gh2_main)
{set $ghc_switch gh1}
{set $ghc_switch_next main_screen}
{ui goto_screen ghc_switch_screen}
(wait 3)
(wait_screen main_screen)
(expect {campaigns active} gh1)
(wait 2)
(shot main)
(press down)
(press down)
(press down)
(press down)
(press down)
(press down)
(wait 1)
(shot main_round)
{set $ghc_switch gh2}
{set $ghc_switch_next main_screen}
{ui goto_screen ghc_switch_screen}
(wait 3)
(wait_screen main_screen)
(expect {campaigns active} gh2)
(wait 2)
(shot gh2_again)
(quit)

; Song speed: set on the quickplay song list's Select menu, green faster and
; yellow slower; in quickplay the song runs at 150% against the clock with
; its audio stretched to match (ghc_speed/...), its own audio name back once
; the song is left. Practice's is practice.dta's.
#include common/first_boot.dta
{ui goto_screen qp_selsong_screen}
(wait_screen qp_selsong_screen)
(wait 2)
(press star_power)
(wait 0.5)
(expect {ghc_pick_panel get open} TRUE)
(press green)
(expect {song_speed} 105)
(press yellow)
(press yellow)
(expect {song_speed} 95)
(shot speed_menu)
(press star_power)
(wait 0.5)
{quickplay song_defaults 0}
{gamecfg set mode quickplay}
{{game get_player_config 0} set_difficulty expert}
{{game get_player_config 0} set autoplay TRUE}
{game set_song shoutatthedevil}
{game set_quickplay}
{song_speed set 150}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(expect {elem {find $syscfg songs shoutatthedevil song name} 1} ghc_speed/150/songs/shoutatthedevil/shoutatthedevil)
; The song's clock runs at the speed once the song starts.
(wait_until {> {taskmgr seconds} 5} 60)
{set $ghc_t0 {taskmgr ui_seconds}}
{set $ghc_s0 {taskmgr seconds}}
(record on quickplay_150)
(print {taskmgr seconds})
(wait 20)
(record off)
(print {'/' {'-' {taskmgr seconds} $ghc_s0} {'-' {taskmgr ui_seconds} $ghc_t0}})
(expect {'/' {'-' {taskmgr seconds} $ghc_s0} {'-' {taskmgr ui_seconds} $ghc_t0}} 1.5 0.03)
{song_speed set 100}
{ui goto_screen main_screen}
(wait_screen main_screen 30)
(expect {elem {find $syscfg songs shoutatthedevil song name} 1} songs/shoutatthedevil/shoutatthedevil)

; A song won at 150% is kept at that speed alone, and skips GH2's own high
; score table.
{quickplay song_defaults 0}
{gamecfg set mode quickplay}
{{game get_player_config 0} set_difficulty expert}
{game set_song shoutatthedevil}
{game set_quickplay}
{song_speed set 150}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait 5)
{player0 win 5}
(wait_screen endgame_screen 60)
(wait 2)
(press green)
(wait_screen complete_screen 30)
(expect {> {best score shoutatthedevil expert} 0} 1)
{song_speed set 100}
(expect {best score shoutatthedevil expert} 0)
(quit)

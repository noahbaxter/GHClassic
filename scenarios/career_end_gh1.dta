; A GH1 career on medium taken to its end, songs passed by the game's
; cheats: four of a venue's five open the next, the map opens on each new
; venue in turn (GameConfig's venue list is the campaign's), and the last
; venue's fourth song won ends the career with no encore.
(needs gh1)
#include common/first_boot.dta
{set $pick gh1}
#include common/career_start.dta
(press green)
(wait_screen sel_venue_screen 40)
(wait 1)
(press green)
(wait_screen sel_song_screen)
(wait 1)
(expect {game get_song} gh1_iloverockandroll)
{foreach $s (gh1_iloverockandroll gh1_iwannabesedated gh1_thunderkiss65 gh1_smokeonthewater) {campaign cheat_beat_song $s 100000}}
(press red)
(wait_screen sel_venue_screen 40)
(wait 1)
(expect {game get_venue} gh1_small_club)
(press green)
(wait_screen sel_song_screen)
(wait 1)
(expect {game get_song} gh1_ironman)
{foreach $s (gh1_ironman gh1_morethanafeeling gh1_yougotanotherthingcomin gh1_takemeout) {campaign cheat_beat_song $s 100000}}
(press red)
(wait_screen sel_venue_screen 40)
(wait 1)
(expect {game get_venue} gh1_big_club)
(press green)
(wait_screen sel_song_screen)
(wait 1)
(expect {game get_song} gh1_killerqueen)
{foreach $s (gh1_killerqueen gh1_heyyou gh1_stellar gh1_heartfullofblack) {campaign cheat_beat_song $s 100000}}
(press red)
(wait_screen sel_venue_screen 40)
(wait 1)
(expect {game get_venue} gh1_theatre)
(press green)
(wait_screen sel_song_screen)
(wait 1)
(expect {game get_song} gh1_ziggystardust)
{foreach $s (gh1_ziggystardust gh1_fatlip gh1_cochise gh1_takeitoff) {campaign cheat_beat_song $s 100000}}
(press red)
(wait_screen sel_venue_screen 40)
(wait 1)
(expect {game get_venue} gh1_fest)
(press green)
(wait_screen sel_song_screen)
(wait 1)
(expect {game get_song} gh1_spanishcastlemagic)
{foreach $s (gh1_spanishcastlemagic gh1_higherground gh1_nooneknows gh1_aceofspades) {campaign cheat_beat_song $s 100000}}
(press red)
(wait_screen sel_venue_screen 40)
(wait 1)
(expect {game get_venue} gh1_arena)
(press green)
(wait_screen sel_song_screen)
(wait 1)
(expect {game get_song} gh1_godzilla)
{foreach $s (gh1_godzilla gh1_texasflood gh1_frankenstein) {campaign cheat_beat_song $s 100000}}
; The last venue's line under its songs asks for the songs medium needs,
; "Beat 4/5 songs to win", where GH2's names Free Bird (content/encores.cpp).
{sel_song_panel refresh}
(wait 1)
(press down)
(press down)
(press down)
(press down)
(press down)
(press down)
(wait 1)
(shot last_venue)
{set $index 3}
#include common/career_song.dta
(expect {gamecfg get_song} gh1_cowboysfromhell)
(wait 3)
{player0 win 5}
(wait 12)
(press green)
(wait 6)
(shot won)
(press green)
(wait 6)
; Twenty-four of thirty passed on medium: half of each one's thirtieth.
(expect {campaigns progress gh1 0} 40)
(quit)

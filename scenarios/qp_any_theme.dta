; Quickplay is the same whatever the theme: under GH1's and the 80s' menus
; GH2's campaign stays active, its characters with every game's outfits,
; and the character and guitar screens are GH2's scenes. The main menu is
; the theme's. Grim's Slayin' is GH2's grim, not GH1's store copy of it.
#include common/first_boot.dta
(needs gh1 gh80s)
{quickplay song_defaults 0}
{campaign set_all_access 1}
{set $gh2_characters {size {find $syscfg characters}}}
{set $ghc_switch gh1}
{set $ghc_switch_next main_screen}
{ui goto_screen ghc_switch_screen}
(wait 3)
(wait_screen main_screen)
(expect {campaigns active} gh1)
(expect {campaigns live} gh2)
(expect {size {find $syscfg characters}} $gh2_characters)
(wait 2)
(shot gh1_main)
{gamecfg set mode quickplay}
{setlist select {campaigns active}}
(expect {if_else {find_exists $syscfg characters metal metalgh1} 1 0} 1)
(expect {campaign is_unlocked metalgh1} 1)
{ui goto_screen qp_selsong_screen}
(wait_screen qp_selsong_screen)
(wait 1)
(press green)
(wait_screen qp_diff_screen)
(wait 1)
(press green)
(wait_screen ghc_qp_character_screen)
(wait_until {char_single are_chars_loaded})
(wait 2)
(shot gh1_character)
{sel_character_panel set char_focus grim}
{sel_character_panel set char_outfit grim}
{sel_character_panel show_portraits}
{char_single show_char 0 grim}
(wait_until {char_single are_chars_loaded} 10)
(wait 2)
(shot gh1_menus_grim_slayin)
{ui goto_screen ghc_qp_guitar_screen}
(wait_screen ghc_qp_guitar_screen)
(wait 3)
(shot gh1_guitar)
{ui goto_screen main_screen}
(wait_screen main_screen)
(expect {campaigns active} gh1)
(expect {size {find $syscfg characters}} $gh2_characters)
; The 80s'.
{set $ghc_switch gh80s}
{set $ghc_switch_next main_screen}
{ui goto_screen ghc_switch_screen}
(wait 3)
(wait_screen main_screen)
(expect {campaigns active} gh80s)
(expect {campaigns live} gh2)
(wait 2)
(shot 80s_main)
{gamecfg set mode quickplay}
{ui goto_screen qp_selsong_screen}
(wait_screen qp_selsong_screen)
(wait 1)
(press green)
(wait_screen qp_diff_screen)
(wait 1)
(press green)
(wait_screen ghc_qp_character_screen)
(wait_until {char_single are_chars_loaded})
(wait 2)
(shot 80s_character)
{ui goto_screen ghc_qp_guitar_screen}
(wait_screen ghc_qp_guitar_screen)
(wait 3)
(shot 80s_guitar)
(quit)

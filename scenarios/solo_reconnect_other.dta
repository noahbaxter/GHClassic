; P1's gamepad gone mid-song: no other controller takes its seat, a fret or
; Start on it doing nothing. The keyboard stands in, playing the seat's pad
; mode: its Enter, as X, resumes the song GH2 still plays as a DualShock.
; The gamepad back is P1's again.
#include common/first_boot.dta
(device pad)
(device guitar)
(press down pad)
(expect {seat_has 0 pad} 1)
{game set_song shoutatthedevil}
{{game get_player_config 0} set_difficulty easy}
{{game get_player_config 0} set autoplay TRUE}
{game set_quickplay}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait 1)
(expect {game get_controller 0} joypad_guitar)
(unplug pad)
(wait_screen pause_controller_screen 10)
(press green guitar)
(wait 0.5)
(press start guitar)
(wait 0.5)
(expect {seat_has 0 guitar} 0)
(wait_screen pause_controller_screen 1)
(key Down)
(wait 0.5)
(expect {seat_has 0 keyboard} 1)
(key Return)
(wait_screen game_screen 10)
(wait 1)
(expect {game get_controller 0} joypad_guitar)
(device pad)
(wait 0.5)
(expect {seat_has 0 pad} 1)
(expect {{ui current_screen} name} game_screen)
(quit)

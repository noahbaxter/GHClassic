; A gamepad as P1 finds its way by its frets in every menu, as it plays a
; song: LT green picks, LB red backs out, RB yellow and A orange held as
; long as they are held. From a song's pause menu, in GH2's scenes and then
; GH1's, Settings' fourth row is Controllers, which leads back there.
(needs gh1)
#include common/first_boot.dta
(controller dualsense "054c:0ce6" pad)
(wait 1)
(hold dualsense dpdown)
(wait 0.3)
(hold dualsense)
(wait 0.5)
(expect {seat_has 0 dualsense} 1)
{ui goto_screen options_screen}
(wait_screen options_screen)
(wait 1)
(hold dualsense lefttrigger+)
(wait 0.3)
(hold dualsense)
(wait 0.5)
(expect $ghc_options_settings TRUE)
(hold dualsense leftshoulder)
(wait 0.3)
(hold dualsense)
(wait 0.5)
(expect $ghc_options_settings FALSE)
(hold dualsense rightshoulder a)
(wait 0.3)
(expect {pad_held yellow} 1)
(expect {pad_held orange} 1)
(expect {pad_held green} 0)
(hold dualsense)
(wait 0.3)

{quickplay in_song_ui gh2}
{gamecfg set mode quickplay}
{game set_song shoutatthedevil}
{{game get_player_config 0} set_difficulty easy}
{{game get_player_config 0} set autoplay TRUE}
{game set_quickplay}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait 2)
(expect {game get_controller 0} joypad_guitar)
(hold dualsense start)
(wait 0.3)
(hold dualsense)
(wait_screen pause_screen 10)
(wait 1)
(hold dualsense dpdown)
(wait 0.3)
(hold dualsense)
(wait 0.3)
(hold dualsense dpdown)
(wait 0.3)
(hold dualsense)
(wait 0.3)
(hold dualsense lefttrigger+)
(wait 0.3)
(hold dualsense)
(wait_screen pause_settings_screen 10)
(wait 1)
(shot gh2_pause_settings)
; Up from Audio round to Controllers, on up to Game and back down.
(hold dualsense dpup)
(wait 0.3)
(hold dualsense)
(wait 0.3)
(expect {pause_settings_panel focus_name} quit.btn)
(hold dualsense dpup)
(wait 0.3)
(hold dualsense)
(wait 0.3)
(expect {pause_settings_panel focus_name} audio_options.btn)
(hold dualsense dpdown)
(wait 0.3)
(hold dualsense)
(wait 0.3)
(expect {pause_settings_panel focus_name} quit.btn)
(hold dualsense lefttrigger+)
(wait 0.3)
(hold dualsense)
(wait_screen ghc_pause_controllers_screen 10)
(wait 1.5)
(shot gh2_pause_controllers)
(key Escape)
(wait_screen pause_settings_screen 10)
(wait 1)
(hold dualsense leftshoulder)
(wait 0.3)
(hold dualsense)
(wait_screen pause_screen 10)
(wait 1)
{meta_loading_nosave_goto main_screen}
(wait_screen main_screen 60)

{quickplay in_song_ui gh1}
{game set_song shoutatthedevil}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait 2)
(hold dualsense start)
(wait 0.3)
(hold dualsense)
(wait_screen pause_screen 10)
(wait 1)
{ui goto_screen pause_settings_screen}
(wait_screen pause_settings_screen 10)
(wait 1)
(shot gh1_pause_settings)
(hold dualsense dpup)
(wait 0.3)
(hold dualsense)
(wait 0.3)
(expect {pause_settings_panel focus_name} quit.btn)
(hold dualsense lefttrigger+)
(wait 0.3)
(hold dualsense)
(wait_screen ghc_pause_controllers_screen 10)
(wait 1.5)
(shot gh1_pause_controllers)
(key Escape)
(wait_screen pause_settings_screen 10)
(quit)

; Battle of the Bands with star power deployed, held at one moment in the
; retail game: tools/pcsx2.py run (docs/retail-compare.md).
(wait_until {! {ui in_transition}} 60)
(wait 3)
{main_panel set already_entered TRUE}
{ui goto_screen main_screen}
(wait_screen main_screen)
{gamecfg set mode quickplay}
{game set_song shoutatthedevil}
{{game get_player_config 0} set_difficulty expert}
{{game get_player_config 0} set autoplay TRUE}
{game set_quickplay}
{ui goto_screen loading_screen}
(wait_screen game_screen 120)
; The meter is emptied when the song starts, so it is filled after that.
(wait_until {> {taskmgr seconds} 1} 60)
{player0 fill_star_power}
(wait 0.5)
; Select deploys it on a pad.
(hold 1)
(wait_until {player0 in_star_mode} 5)
(hold 0)
(wait 2)
; The song stops wherever it has got to, and the clocks are put at one time.
{game set_paused TRUE}
(clock 100)
(freeze 101 2.5 3.9)
(wait_until {>= {taskmgr ui_seconds} 101})
(wait 0.2)
; With every clock standing: the shot and the lights, which then begin at
; the same time on both sides, and no more light changes from the song.
{world toggle_lighting_events}
{world set_lighting verse_okay.pst}
{world lighting_first_keyframe}
{world do_force_shot balcony_rt01}
(clock 101)
(freeze 102 2.5 3.9)
(wait_until {>= {taskmgr ui_seconds} 102})
(wait 0.2)
; Then the song's clocks jump on by the same amount, so whatever blends in
; from what was there before, which differs, has finished.
(clock 102)
(freeze 104 22.5 43.9)
(wait_until {>= {taskmgr ui_seconds} 104})
(wait 0.5)
(print {taskmgr seconds} {taskmgr beat} {taskmgr ui_seconds} {player0 in_star_mode})
(dump frame)
(shot frame)
; Its memory, for (transplant) in our build.
(ram frame)
(quit)

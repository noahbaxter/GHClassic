; GH1 on easy ends at fest's fourth song, not the arena's.
(needs gh1)
{set $pick gh1}
{set $d1 none}
{set $d2 none}
{set $d3 none}
{set $v1 down}
{set $finale_venue gh1_fest}
{set $b1 gh1_spanishcastlemagic}
{set $b2 gh1_higherground}
{set $b3 gh1_nooneknows}
{set $b4 gh1_nooneknows}
{set $idx 3}
{set $play gh1_aceofspades}
#include common/finale_direct.dta

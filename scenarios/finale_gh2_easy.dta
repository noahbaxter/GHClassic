; GH2 on easy has no encore: it ends at the arena's fourth song.
(needs gh2)
{set $pick gh2}
{set $d1 none}
{set $d2 none}
{set $d3 none}
{set $v1 down}
{set $finale_venue arena}
{set $b1 gh2_madhouse}
{set $b2 gh2_carrymehome}
{set $b3 gh2_laidtorest}
{set $b4 gh2_laidtorest}
{set $idx 3}
{set $play gh2_psychobilly}
#include common/finale_direct.dta

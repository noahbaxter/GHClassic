; The campaign picker: the amp poster, and a case for each game with a
; campaign, the picked one turning, the rest turned to show their spines.
#include common/first_boot.dta
{gamecfg set mode career}
{campaign set_profile_name "The Testers" 0}
{ui goto_screen chooseprof_screen}
(wait_screen chooseprof_screen)
(press green)
(wait_screen ghc_campaign_screen)
(wait 2)
(expect {size {ghc_campaign_panel get games}} 4)
(shot picker)
(wait 0.5)
(shot picker_turned)
(press down)
(wait 1)
(shot picker_next)
(expect {ghc_campaign_panel get picked} 2)
(press down)
(wait 1)
(shot picker_last)
(press down)
(wait 1)
(expect {ghc_campaign_panel get picked} 0)
(quit)

; The guitars and finishes the game disc holds and never offers
; (content/hidden_guitars.h), in GH2's career: sold at their prices, the
; controller asking for hard's tour or expert's, no new band's, and each in a song.
#include common/first_boot.dta
(expect {elem {find $syscfg store skin gh2_exp_peppermint price} 1} 450)
(expect {elem {find $syscfg store skin gh2_exp_lipstick price} 1} 550)
(expect {elem {find $syscfg store guitar gh2_guitar_red_octane price} 1} 6000)
(expect {elem {find $syscfg store guitar gh2_air_guitar price} 1} 1000)
; GH1's nine that the scenes still hold, two a body and the ES-335's one.
(expect {elem {find $syscfg store skin gh2_lp_ebony price} 1} 450)
(expect {elem {find $syscfg store skin gh2_lp_gold price} 1} 550)
(expect {elem {find $syscfg store skin gh2_fb_copper price} 1} 450)
(expect {elem {find $syscfg store skin gh2_fb_hippie price} 1} 550)
(expect {elem {find $syscfg store skin gh2_mod_black price} 1} 450)
(expect {elem {find $syscfg store skin gh2_mod_dragon price} 1} 550)
(expect {elem {find $syscfg store skin gh2_cor_white price} 1} 450)
(expect {elem {find $syscfg store skin gh2_cor_snake price} 1} 550)
(expect {elem {find $syscfg store skin gh2_es_ebony price} 1} 450)
(expect {elem {find $syscfg guitars gh2_corvus skins gh2_cor_snake mat} 1} guitar_corvus_snake.mat)
; GH2's controller is the red one alone (GH1's black is GH1's store's).
(expect {size {find $syscfg guitars gh2_guitar_red_octane skins}} 2)
(expect {elem {elem {find $syscfg guitars gh2_guitar_red_octane skins} 1} 0} gh2_guitar_red_octane_gh2)
(expect {elem {find $syscfg guitars gh2_guitar_red_octane type} 1} guitar)
(expect {elem {find $syscfg guitars gh2_guitar_red_octane require} 1} tour_passed)
(expect {localize gh2_guitar_red_octane} "Red Octane Guitar Hero Controller")
(expect {localize gh2_guitar_red_octane_gh2} "\qRed\q Octane Guitar Hero II Controller")
(expect {localize gh2_air_guitar} "Air Guitar")
; A finish GH1 shares is named as GH2 names one, GH1's disc there or not.
(expect {localize gh2_lp_gold} "Goldtop Standard")
(expect {localize gh2_cor_white_shop_desc} "A classic take on a guitar that is anything but ordinary.  The Gibson Corvus.")
{set $pick gh2}
#include common/career_start.dta
(expect {campaign is_unlocked gh2_exp_peppermint} 0)
(expect {campaign is_unlocked gh2_guitar_red_octane} 0)
(expect {campaign is_unlocked gh2_air_guitar} 0)

; The controller is not the store's until hard's tour or expert's is passed:
; here expert's alone, the same band's.
{ui goto_screen store_screen}
(wait_screen store_screen)
(wait 2)
(press green)
(wait 2)
(press up)
(press up)
(wait 2)
(shot store_before)
{ui goto_screen sel_difficulty_screen}
(wait_screen sel_difficulty_screen)
(wait 1)
(press down)
(press down)
(press green)
(wait_screen sel_character_new_screen)
(wait_until {char_single are_chars_loaded})
(wait 1)
(press green)
(wait_screen sel_guitar_new_screen)
(wait 3)
(press green)
(wait_until
   {&& {! {ui in_transition}}
      {|| {== {ui current_screen} tour_start_screen} {== {ui current_screen} career_screen}}} 40)
(wait 1)
{if {== {ui current_screen} tour_start_screen} {autosave_goto career_screen}}
(wait_screen career_screen 40)
(wait 1)
(expect {game get_difficulty 0} 3)
{foreach $s
   (gh2_shoutatthedevil gh2_mother gh2_surrender gh2_woman gh2_tonightimgonna
      gh2_strutter gh2_heartshapedbox gh2_messageinabottle gh2_youreallygotme gh2_carryonwayward
      gh2_monkeywrench gh2_thembones gh2_searchanddestroy gh2_tattooedloveboys gh2_warpigs
      gh2_cherrypie gh2_whowasinmyroom gh2_girlfriend gh2_cantyouhearme gh2_sweetchild
      gh2_killinginthenameof gh2_johnthefisherman gh2_freya gh2_badreputation gh2_lastchild
      gh2_crazyonyou gh2_trippinonahole gh2_rockthistown gh2_jessica gh2_stop
      gh2_madhouse gh2_carrymehome gh2_laidtorest gh2_psychobilly gh2_yyz
      gh2_beastandtheharlot gh2_institutionalized gh2_misirlou gh2_hangar18 gh2_freebird)
   {campaign cheat_beat_song $s 100000}}
{ui goto_screen store_screen}
(wait_screen store_screen)
(wait 2)
(press green)
(wait 2)
(press up)
(press up)
(wait 2)
(shot store_after)
; Every one to pick from, as the unlock-all cheat leaves them.
{set $cheat_enabled_unlock_all 1}
{campaign set_all_access 1}
{set $disable_save 1}
{ui goto_screen main_screen}
(wait_screen main_screen)

{set $ghc_character gh2_punk1}
{set $ghc_guitar gh2_explorer}
{set $ghc_finish gh2_exp_peppermint}
#include common/guitar_shot.dta
#include common/guitar_near.dta
(shot exp_peppermint)
{set $ghc_finish gh2_exp_lipstick}
#include common/guitar_shot.dta
#include common/guitar_near.dta
(shot exp_lipstick)
{set $ghc_guitar gh2_guitar_red_octane}
{set $ghc_finish gh2_guitar_red_octane_gh2}
#include common/guitar_shot.dta
#include common/guitar_near.dta
(shot guitar_red_octane_gh2)
{set $ghc_guitar gh2_air_guitar}
{set $ghc_finish gh2_air_guitar}
#include common/guitar_shot.dta
#include common/guitar_near.dta
(shot air_guitar)
(quit)

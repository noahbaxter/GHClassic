; The guitars and finishes the game disc holds and never offers
; (content/hidden_guitars.h), in GH2's career: sold at their prices, the
; controller asking for hard's tour or expert's, no new band's, and each in a song.
#include common/first_boot.dta
(expect {elem {find $syscfg store skin exp_peppermint price} 1} 450)
(expect {elem {find $syscfg store skin exp_lipstick price} 1} 550)
(expect {elem {find $syscfg store guitar guitar_red_octane price} 1} 6000)
(expect {elem {find $syscfg store guitar air_guitar price} 1} 1000)
; GH2's controller is the red one alone (GH1's black is GH1's store's).
(expect {size {find $syscfg guitars guitar_red_octane skins}} 2)
(expect {elem {elem {find $syscfg guitars guitar_red_octane skins} 1} 0} guitar_red_octane_gh2)
(expect {elem {find $syscfg guitars guitar_red_octane type} 1} guitar)
(expect {elem {find $syscfg guitars guitar_red_octane require} 1} tour_passed)
(expect {localize guitar_red_octane} "Guitar Hero guitar")
(expect {localize air_guitar} "Air Guitar")
{set $pick gh2}
#include common/career_start.dta
(expect {campaign is_unlocked exp_peppermint} 0)
(expect {campaign is_unlocked guitar_red_octane} 0)
(expect {campaign is_unlocked air_guitar} 0)

; The controller is not the store's until hard's tour or expert's is passed:
; here expert's alone, the same band's.
{ui goto_screen store_screen}
(wait_screen store_screen)
(wait 2)
(press green)
(wait 2)
(press up)
(press up)
(wait 2)
(shot store_before)
{ui goto_screen sel_difficulty_screen}
(wait_screen sel_difficulty_screen)
(wait 1)
(press down)
(press down)
(press green)
(wait_screen sel_character_new_screen)
(wait_until {char_single are_chars_loaded})
(wait 1)
(press green)
(wait_screen sel_guitar_new_screen)
(wait 3)
(press green)
(wait_until
   {&& {! {ui in_transition}}
      {|| {== {ui current_screen} tour_start_screen} {== {ui current_screen} career_screen}}} 40)
(wait 1)
{if {== {ui current_screen} tour_start_screen} {autosave_goto career_screen}}
(wait_screen career_screen 40)
(wait 1)
(expect {game get_difficulty 0} 3)
{foreach $s
   (shoutatthedevil mother surrender woman tonightimgonna
      strutter heartshapedbox messageinabottle youreallygotme carryonwayward
      monkeywrench thembones searchanddestroy tattooedloveboys warpigs
      cherrypie whowasinmyroom girlfriend cantyouhearme sweetchild
      killinginthenameof johnthefisherman freya badreputation lastchild
      crazyonyou trippinonahole rockthistown jessica stop
      madhouse carrymehome laidtorest psychobilly yyz
      beastandtheharlot institutionalized misirlou hangar18 freebird)
   {campaign cheat_beat_song $s 100000}}
{ui goto_screen store_screen}
(wait_screen store_screen)
(wait 2)
(press green)
(wait 2)
(press up)
(press up)
(wait 2)
(shot store_after)
; Every one to pick from, as the unlock-all cheat leaves them.
{set $cheat_enabled_unlock_all 1}
{campaign set_all_access 1}
{set $disable_save 1}
{ui goto_screen main_screen}
(wait_screen main_screen)

{set $ghc_character punk1}
{set $ghc_guitar explorer}
{set $ghc_finish exp_peppermint}
#include common/guitar_shot.dta
#include common/guitar_near.dta
(shot exp_peppermint)
{set $ghc_finish exp_lipstick}
#include common/guitar_shot.dta
#include common/guitar_near.dta
(shot exp_lipstick)
{set $ghc_guitar guitar_red_octane}
{set $ghc_finish guitar_red_octane_gh2}
#include common/guitar_shot.dta
#include common/guitar_near.dta
(shot guitar_red_octane_gh2)
{set $ghc_guitar air_guitar}
{set $ghc_finish air_guitar}
#include common/guitar_shot.dta
#include common/guitar_near.dta
(shot air_guitar)
(quit)

; Quickplay's pickers start on what was last picked, over the song's own
; casting, so green on each plays as before: the outfit, the guitar and
; finish, and the venue on its game's map.
#include common/first_boot.dta
(needs gh1)
{quickplay song_defaults 0}
{quickplay pick outfit glam1}
{quickplay pick guitar sg}
{quickplay pick skin sg_white}
{quickplay pick venue battle}
{quickplay pick venue_game gh1}
{gamecfg set mode quickplay}
{quickplay quickplay 1}
{ui goto_screen qp_selsong_screen}
(wait_screen qp_selsong_screen)
(wait 1)
(press green)
(wait_screen qp_diff_screen)
(wait 1)
(press green)
(wait_screen ghc_qp_character_screen)
(expect {game get_character_outfit} glam1)
(expect {game get_guitar} sg)
(expect {game get_venue} battle)
(wait_until {char_single are_chars_loaded})
{ui goto_screen ghc_qp_guitar_screen}
(wait_screen ghc_qp_guitar_screen)
(wait 2)
(expect {sel_guitar_panel get_selected_guitar 0} sg)
{ghc_qp_guitar_screen goto_career}
(wait_screen ghc_qp_venue_screen)
(wait 2)
(expect $ghc_qp_venues gh1)
(expect {game get_venue} battle)
(shot venue)
(press green)
(wait_screen game_screen 60)
(expect {quickplay pick venue_game} gh1)
(expect {quickplay pick outfit} glam1)
(quit)

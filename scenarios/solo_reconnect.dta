; P1's controller pulled out mid-song: GH2's own controller pause, which
; holds until the same controller is back, and then its X resumes, the pad
; playing as a DualShock (its orange, Cross or A).
#include common/first_boot.dta
(device pad)
(device guitar)
(press down pad)
(expect {seat_has 0 pad} 1)
{game set_song shoutatthedevil}
{{game get_player_config 0} set_difficulty easy}
{{game get_player_config 0} set autoplay TRUE}
{game set_quickplay}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait 1)
(unplug pad)
(wait_screen pause_controller_screen 10)
; Another controller's press takes nothing and resumes nothing.
(press green guitar)
(wait 1)
(expect {seat_has 0 guitar} 0)
(wait_screen pause_controller_screen 1)
(device pad)
(wait 0.5)
(expect {seat_has 0 pad} 1)
(press orange pad)
(wait_screen game_screen 10)
(quit)

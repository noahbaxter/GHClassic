; Practice from a career song's pause menu, its third row, as from
; quickplay's: the song's sections in practice's career mode, then its pause
; menu's Return, back to the career's setlist on that song.
#include common/first_boot.dta
{gamecfg set mode career}
{campaign set_profile_name "The Testers" 0}
; Picked on the career's setlist.
{ui goto_screen sel_song_screen}
(wait_screen sel_song_screen 30)
(wait 2)
(press up)
(press up)
(press up)
(press up)
(wait 0.5)
(expect {game get_song} shoutatthedevil)
{{game get_player_config 0} set_difficulty expert}
{{game get_player_config 0} set autoplay TRUE}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait 5)
; The setlist's row it was picked from, which the setlist is back on after.
{set $ghc_row {game get_song_index}}
(press start)
(wait_screen pause_screen 20)
(wait 1)
(expect {{pause_panel find ghc_practice.btn} showing} 1)
(press down)
(press down)
(expect {pause_panel focus_name} ghc_practice.btn)
(shot career_pause)
(press green)
(wait_screen practice_sel_section_screen 60)
(wait 2)
(expect {gamecfg get mode} practice)
(expect {practice_sel_section_screen get career_mode} 1)
{gamecfg set (practice_sections 0) 0}
{gamecfg set (practice_sections 1) 1}
{ui goto_screen practice_loading_screen}
(wait_screen practice_game_screen 60)
(wait 3)
(press start)
(wait_screen pract_pause_screen 20)
(wait 1)
(expect {pract_pause_panel focus_name} resume_career.btn)
(press down)
(press down)
(press down)
(press down)
(expect {pract_pause_panel focus_name} ghc_settings_career.btn)
(press down)
(expect {pract_pause_panel focus_name} quit_career.btn)
(shot career_practice_pause)
(press green)
(wait_screen sel_song_screen 60)
(wait 2)
(shot back_in_career)
(expect {gamecfg get mode} career)
(expect {game get_song_index} $ghc_row)
(expect {game get_song} shoutatthedevil)
(expect {practice_sel_section_screen get career_mode} 0)
(quit)

; GH1 on medium ends at the arena's fourth song.
(needs gh1)
{set $pick gh1}
{set $d1 down}
{set $d2 none}
{set $d3 none}
{set $v1 none}
{set $finale_venue arena}
{set $b1 gh1_godzilla}
{set $b2 gh1_texasflood}
{set $b3 gh1_frankenstein}
{set $b4 gh1_frankenstein}
{set $idx 3}
{set $play gh1_cowboysfromhell}
#include common/finale_direct.dta

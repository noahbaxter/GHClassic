; Quickplay's pickers with the 360 disc: blue on the guitarist's screen
; turns every guitarist between the 360's models and the PS2's, on the
; guitar's every guitar, and on GH2's venue map its venues, each named
; as what shows. The three are apart: the song plays a 360 guitarist with a
; PS2 guitar in the PS2's room.
(needs gh2x)
#include common/first_boot.dta
{quickplay song_defaults 0}
(expect {quickplay characters} hd)
(expect {quickplay guitars} hd)
(expect {quickplay venues} hd)
{gamecfg set mode quickplay}
{ui goto_screen qp_selsong_screen}
(wait_screen qp_selsong_screen)
(wait 1)
(press green)
(wait_screen qp_diff_screen)
(wait 1)
(press green)
(wait_screen ghc_qp_character_screen)
(wait_until {char_single are_chars_loaded})
(wait 2)
(expect {ghc_qp_character_has_hd} 1)
(shot character_hd)
(press blue)
(wait 0.5)
(expect {quickplay characters} sd)
(wait_until {char_single are_chars_loaded})
(wait 2)
(shot character_sd)
(press blue)
(wait 0.5)
(expect {quickplay characters} hd)
(wait_until {char_single are_chars_loaded})
(wait 2)
(shot character_hd_again)
{ui goto_screen ghc_qp_guitar_screen}
(wait_screen ghc_qp_guitar_screen)
(wait 3)
(expect {ghc_qp_guitar_has_hd} 1)
(shot guitar_hd)
(press blue)
(wait 3)
(expect {quickplay guitars} sd)
(shot guitar_sd)
{ghc_qp_guitar_screen goto_career}
(wait_screen ghc_qp_venue_screen)
(wait 2)
(expect $ghc_qp_venues gh2)
(expect {ghc_qp_venue_has_hd} 1)
(shot venue_hd)
(press blue)
(wait 1)
(expect {quickplay venues} sd)
(shot venue_sd)
{{game get_player_config 0} set autoplay TRUE}
(press green)
(wait_screen game_screen 60)
(expect {quickplay venues} sd)
(expect {campaigns venue_game} gh2)
(wait 20)
(shot song_hd_guitarist_sd_guitar_sd_venue)
(quit)

; The keyboard in a menu reads its menu keys and never its layout: Enter and
; Space pick, Esc backs out, the arrows move. Its green (1) is a fret, so it
; picks nothing there.
#include common/first_boot.dta
(key Down)
(expect {seat_has 0 keyboard} 1)
(expect {main_screen focus_name} main_options.btn)
(keys 1)
(wait 0.3)
(keys)
(wait 0.3)
(expect {{ui current_screen} name} main_screen)
(key Space)
(wait_screen options_screen 10)
(key Escape)
(wait_screen main_screen 10)
(expect {main_screen focus_name} main_options.btn)
(key Return)
(wait_screen options_screen 10)
(key Escape)
(wait_screen main_screen 10)
(quit)

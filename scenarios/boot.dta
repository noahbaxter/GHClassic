; Boots to the main menu, then quickplay's song list. The splash waits for
; Start, so the menu is gone to directly.
(wait_screen splash_screen)
{ui goto_screen main_screen}
(wait_screen main_screen)
(wait 2)
(shot main)
{gamecfg set mode quickplay}
{ui goto_screen qp_selsong_screen}
(wait_screen qp_selsong_screen)
(wait 2)
(shot songs)
(quit)

; Practice on two sections at 50%, autoplayed, round to their start again:
; the song clock at half speed against the wall, its audio stretched to
; match, and practice's own screens. The section screen loads the song's sections from
; its MIDI.
#include common/first_boot.dta
{gamecfg set mode practice}
{game set_song shoutatthedevil}
{gamecfg set_track 0 0}
{{game get_player_config 0} set_difficulty expert}
{{game get_player_config 0} set autoplay TRUE}
{ui goto_screen practice_sel_section_screen}
(wait_screen practice_sel_section_screen)
(wait 2)
{gamecfg set (practice_sections 0) 0}
{gamecfg set (practice_sections 1) 1}
{song_speed set 50}
{ui goto_screen practice_loading_screen}
(wait_screen practice_game_screen 60)
(expect {elem {find $syscfg songs shoutatthedevil song name} 1} ghc_speed/50/songs/shoutatthedevil/shoutatthedevil)
(wait 8)
{set $ghc_t0 {taskmgr ui_seconds}}
{set $ghc_s0 {taskmgr seconds}}
(record on practice_50)
(wait 20)
(record off)
(expect {'/' {'-' {taskmgr seconds} $ghc_s0} {'-' {taskmgr ui_seconds} $ghc_t0}} 0.5 0.03)
(shot playing)
; Its end goes round to its start again, every note hit the best.
(wait_until {> $ghc_practice_best 0} 240)
(expect $ghc_practice_best 100)
(wait 2)
(expect {{ui current_screen} name} practice_game_screen)
(expect {< {taskmgr seconds} 20} 1)
(shot again)
(quit)

; The Controllers screen: the device last pressed shows, lit as it plays,
; and nothing pressed there plays the menu under it.
#include common/first_boot.dta
(device guitar)
(device pad)
{ui goto_screen options_screen}
(wait_screen options_screen)
(wait 1)
(shot options_top)
; Options' Settings row shows Audio, Video, Controllers and Game Settings, and
; Controllers leads here, from the keyboard as from a guitar.
(expect {options_screen focus_name} op_audio.btn)
(record on options)
(key Return)
(wait 0.5)
(expect {{ui current_screen} name} options_screen)
(expect {{options_panel find op_data.btn} showing} 0)
(expect {{options_panel find controllers.btn} showing} 1)
(shot options_settings)
(key Down)
(key Down)
(expect {options_screen focus_name} controllers.btn)
(key Return)
(wait_screen ghc_controllers_screen)
(record off)
(wait 1)
(record on screen)
(shot open)
; Held frets glow and their rows light; strumming shows the hand.
(hold guitar green yellow down)
(wait 0.3)
(expect {ghc_controllers held green} 1 0.01)
(expect {{ui current_screen} name} ghc_controllers_screen)
(shot held)
; Tilt fills its meter past the mark.
(hold guitar tilt)
(wait 0.3)
(expect {ghc_controllers held tilt} 1 0.01)
(shot tilt)
(hold guitar)
; The pad pressed is the one shown.
(hold pad red)
(wait 0.3)
(hold pad)
(shot pad)
; The keyboard picks rows and devices, Left and Right through them.
(key Down)
(key Down)
(key Right)
(wait 0.3)
(expect {ghc_controllers focus} 2)
(expect {ghc_controllers text title} KEYBOARD)
(expect {ghc_controllers keyboard} 1)
(key Left)
(wait 0.3)
(expect {ghc_controllers text title} PAD)
(key Tab)
(wait 0.3)
(expect {ghc_controllers text title} KEYBOARD)
(shot keys)
; Enter waits for yellow's key, and the next key pressed is it, written to
; input.ini.
(key Return)
(wait 0.3)
(shot rebind)
; Its box fades in and out while it waits.
(wait 1.5)
(key Q)
(wait 0.3)
(expect {ghc_controllers text read 2} "Q")
(expect {ghc_controllers focus} 2)
(shot rebound)
; Delete unbinds it; Reset to Default puts the layout back.
(key Delete)
(wait 0.3)
(expect {ghc_controllers text read 2} "NOT SET")
(key Up)
(key Up)
(key Up)
(expect {ghc_controllers focus} 11)
(key Return)
(wait 0.3)
(expect {ghc_controllers text read 2} "3")
; The keyboard's whammy takes a key too.
(key Up)
(key Up)
(expect {ghc_controllers focus} 9)
(key Return)
(wait 0.3)
(key W)
(wait 0.3)
(expect {ghc_controllers text read 9} "W")
(key Delete)
(wait 0.3)
(expect {ghc_controllers text read 9} "NOT SET")
; Down held steps on through the rows, past the end round to the top.
{set $was {ghc_controllers focus}}
(key Down 1.5)
(expect {>= {mod {'+' {'-' {ghc_controllers focus} $was} 12} 12} 3} 1)
(wait 0.5)
(record off)
; Escape goes back to Options' settings rows, on Controllers, and the Escape
; that left is not a back there.
(key Escape)
(wait_screen options_screen)
(wait 1)
(expect {{ui current_screen} name} options_screen)
(expect {options_screen focus_name} controllers.btn)
(expect {{options_panel find controllers.btn} showing} 1)
(shot options_back)
; Another goes back to the first rows, on Settings, and one more to the main
; menu.
(key Escape)
(wait 0.5)
(expect {{ui current_screen} name} options_screen)
(expect {options_screen focus_name} op_audio.btn)
(expect {{options_panel find op_data.btn} showing} 1)
(expect {{options_panel find controllers.btn} showing} 0)
(key Escape)
(wait_screen main_screen)
(wait 1)
{ui goto_screen options_screen}
(wait_screen options_screen)
(wait 1)
(expect {{options_panel find op_data.btn} showing} 1)
(shot options_again)
; With no keyboard, red held three seconds is the way out.
{ui goto_screen ghc_controllers_screen}
(wait_screen ghc_controllers_screen)
(wait 1)
; Red in a chord is a chord being tried, never a way out.
(hold guitar green red)
(wait 3.5)
(expect {ghc_controllers leaving} 0 0.01)
(expect {{ui current_screen} name} ghc_controllers_screen)
(hold guitar red)
(wait 1.5)
(expect {> {ghc_controllers leaving} 0.1} 1)
(shot leaving)
(wait 0.5)
(expect {{ui current_screen} name} ghc_controllers_screen)
; Held until it leaves: its three seconds are the host's clock, which a
; recording's game time runs apart from.
(wait_screen options_screen)
(hold guitar)
(wait 1)
(expect {{ui current_screen} name} options_screen)
(quit)

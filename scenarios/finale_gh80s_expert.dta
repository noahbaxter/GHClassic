; The 80s on expert ends at its encore, Play With Me.
(needs gh80s)
{set $d1 down}
{set $d2 down}
{set $d3 down}
{set $pick gh80s}
{set $b1 gh80s_electriceye}
{set $b2 gh80s_policetruck}
{set $b3 gh80s_seventeen}
{set $b4 gh80s_seventeen}
{set $idx 3}
{set $offer gh80s_caughtinamosh}
{set $final gh80s_playwithme}
#include common/finale_encore.dta

; A career's final song as an encore, on the difficulty $d1 $d2 $d3 name
; (career_start_diff.dta): the last venue's songs $b1 to $b4 passed by the
; game's cheat, the song at $idx, $offer, not the final one, won for the
; offer of the encore, $final. Its confirms are said yes to, the song lost
; once with nobody playing and played again from the lose screen, and its win
; is the career's ending.
#include first_boot.dta
#include career_start_diff.dta
{campaign set_all_access 1}
(press green)
(wait_screen sel_venue_screen 40)
(wait 1)
(press green)
(wait_screen sel_song_screen)
(wait 1)
{campaign cheat_beat_song $b1 100000}
{campaign cheat_beat_song $b2 100000}
{campaign cheat_beat_song $b3 100000}
{campaign cheat_beat_song $b4 100000}
{set $index $idx}
#include career_song.dta
(expect {gamecfg get_song} $offer)
(wait 3)
(expect {campaign final_song} 0)
{player0 win 5}
(wait_screen endgame_encore_screen 400)
(wait 4)
(shot offer)
(press green)
(wait 3)
(shot confirm)
(press green)
(wait 3)
{{game get_player_config 0} set autoplay FALSE}
(press green)
(wait 3)
(press green)
(wait_screen game_screen 60)
(expect {gamecfg get_song} $final)
(wait 3)
(expect {campaign final_song} 1)
(wait_screen lose_screen 240)
(wait 2)
(shot lost)
(press green)
(wait_screen game_screen 60)
(wait 3)
(expect {gamecfg get_song} $final)
(expect {campaign final_song} 1)
{player0 win 5}
(wait 12)
(shot ending)
(wait 40)
(shot after_ending)
(quit)

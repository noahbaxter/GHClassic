; Hack $hack's career from the band list to its first song's highway, by
; the buttons a player presses, on easy: its own difficulty, character,
; guitar, sponsor, career, venue and song screens, and a Deluxe build's
; outfit and part pickers where it has them. Shots of each.
{gamecfg set mode career}
{campaign set_profile_name "The Testers" 0}
{ui goto_screen chooseprof_screen}
(wait_screen chooseprof_screen)
(press green)
(wait_screen ghc_campaign_screen)
(wait 1)
; Into its career as the picker's green goes: which button shows a hack is
; to be settled.
{set $ghc_switch $hack}
{set $ghc_switch_next sel_difficulty_screen}
{set $ghc_switch_as career}
{ui goto_screen ghc_switch_screen}
(wait_screen sel_difficulty_screen 40)
(expect {campaigns active} $hack)
(wait 1)
(shot difficulty)
(press green)
(wait_screen sel_character_new_screen)
(wait_until {char_single are_chars_loaded})
(wait 2)
(shot character)
(press green)
(wait 1)
; A guitarist with more than one outfit open goes to Deluxe's outfit picker
; first, whose green does this (career.dta's SEL_CHARACTER_SELECT_HANDLER).
{if {sel_character_panel get skin_select}
   {do
      {game set_character {sel_character_panel get char_outfit}}
      {ui goto_screen sel_guitar_new_screen}
   }
}
(wait_screen sel_guitar_new_screen)
(wait 3)
(shot guitar)
(press green)
(wait_screen tour_start_screen)
(wait 2)
(shot sponsor)
(press green)
(wait_screen career_screen 40)
(wait 1)
(shot career)
(press green)
(wait_screen sel_venue_screen 40)
(wait 1)
(shot venue)
(press green)
(wait_screen sel_song_screen)
(wait 2)
(shot songs)
(press green)
(wait 3)
(shot part)
; A Deluxe build's part picker, whose green on guitar does this
; (career.dta's career_selpart_panel). Another hack goes straight in.
{if {== {ui current_screen} career_selpart_screen}
   {do
      {gamecfg set_track 0 0}
      {ui goto_screen loading_screen}
   }
}
(wait_screen game_screen 60)
(wait 8)
(shot song)
; Deluxe raises the highway after its song card and count-in.
(wait 20)
(shot highway)

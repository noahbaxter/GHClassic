; To the 80s through the screen the switch happens on (campaigns.dta), its
; screens, then back to GH2 and its own.
{set $ghc_switch gh80s}
{set $ghc_switch_next main_screen}
{ui goto_screen ghc_switch_screen}
(wait_screen main_screen)
(expect {campaigns active} gh80s)
(wait 1)
(shot a_main_80s)
{gamecfg set mode career}
{campaign set_profile_slot 0}
{ui goto_screen career_screen}
(wait_screen career_screen)
(wait 1)
(shot b_career_80s)
{ui goto_screen sel_venue_screen}
(wait_screen sel_venue_screen)
(wait 1)
(shot c_venue_80s)
{ui goto_screen sel_song_screen}
(wait_screen sel_song_screen)
(wait 1)
(shot d_songs_80s)
{ui goto_screen store_screen}
(wait_screen store_screen)
(wait 2)
(shot e_store_80s)
{ui goto_screen sel_character_edit_screen}
(wait_screen sel_character_edit_screen)
(wait_until {char_single are_chars_loaded})
(wait 2)
(shot f_character_80s)
{set $ghc_switch gh2}
{set $ghc_switch_next main_screen}
{ui goto_screen ghc_switch_screen}
(wait_screen main_screen)
(expect {campaigns active} gh2)
(wait 1)
(shot g_main_gh2)
{gamecfg set mode career}
{campaign set_profile_slot 0}
{ui goto_screen career_screen}
(wait_screen career_screen)
(wait 1)
(shot h_career_gh2)
{ui goto_screen sel_venue_screen}
(wait_screen sel_venue_screen)
(wait 1)
(shot i_venue_gh2)
{ui goto_screen sel_song_screen}
(wait_screen sel_song_screen)
(wait 1)
(shot j_songs_gh2)
{ui goto_screen store_screen}
(wait_screen store_screen)
(wait 2)
(shot k_store_gh2)
{ui goto_screen sel_character_edit_screen}
(wait_screen sel_character_edit_screen)
(wait_until {char_single are_chars_loaded})
(wait 2)
(shot l_character_gh2)
{ui goto_screen main_screen}
(wait_screen main_screen)

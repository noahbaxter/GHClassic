; Face-off's streaks: a drawer under each player's meter and popups of
; their own. Player 1 on easy and player 2 on expert, so the two differ.
#include common/first_boot.dta
(device p1)
(device p2)
(press start p1)
{ui goto_screen multi_screen}
(wait_screen multi_screen)
(press start p2)
(wait 0.5)
{gamecfg set mode multi_fo}
{game set_num_players 2}
{game set_song shoutatthedevil}
{{game get_player_config 0} set_difficulty easy}
{{game get_player_config 1} set_difficulty expert}
{{game get_player_config 0} set autoplay TRUE}
{{game get_player_config 1} set autoplay TRUE}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait_until {!= $streak_counter_display1 0} 30)
(expect {!= $streak_counter_display2 0} 1)
; Player 2's out alone, each count its own, none the band's.
(wait_until {>= {player1 current_streak} 60} 120)
(expect {< {player0 current_streak} 50} 1)
(expect {== $note_streak_1 {player1 current_streak}} 1)
(expect {== $note_streak_0 {player0 current_streak}} 1)
(expect $note_streak_band 0)
(wait 0.5)
(shot p2_out)
(wait_until {>= {player0 current_streak} 55} 120)
(wait 0.5)
(shot both_out)
(quit)

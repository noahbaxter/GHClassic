; A career started and left by the keyboard alone, every screen on the way:
; a new band named with the arrows and finished with Tab, then the campaign,
; difficulty, character, guitar, career, venue and song screens by Enter, each
; backed out of by Esc to the one before.
#include common/first_boot.dta
(key Down)
(expect {seat_has 0 keyboard} 1)
{gamecfg set mode career}
{ui goto_screen chooseprof_screen}
(wait_screen chooseprof_screen)
(wait 1.5)
(key Return)
(wait_screen nameprof_screen 10)
(wait 1.5)
(shot name_band)
(key Down)
(wait 0.3)
(key Return)
(wait 0.3)
(key Down)
(wait 0.3)
(key Return)
(wait 0.3)
(shot name_typed)
(expect {{ui current_screen} name} nameprof_screen)
(key Tab)
(wait_screen ghc_campaign_screen 10)
(wait 1.5)
(shot campaign)
(key Return)
(wait_screen sel_difficulty_screen 10)
(wait 1.5)
(shot difficulty)
(key Escape)
(wait_screen ghc_campaign_screen 10)
(key Return)
(wait_screen sel_difficulty_screen 10)
(wait 1)
(key Down)
(key Return)
(wait_screen sel_character_new_screen 10)
(wait_until {char_single are_chars_loaded})
(wait 1.5)
(shot character)
(key Return)
(wait_screen sel_guitar_new_screen 10)
(wait 3)
(shot guitar)
(key Escape)
(wait_screen sel_character_new_screen 10)
(wait 2)
(key Return)
(wait_screen sel_guitar_new_screen 10)
(wait 3)
(key Return)
(wait_until
   {&& {! {ui in_transition}}
      {|| {== {ui current_screen} tour_start_screen} {== {ui current_screen} career_screen}}} 40)
(wait 1)
{if {== {ui current_screen} tour_start_screen} {autosave_goto career_screen}}
(wait_screen career_screen 40)
(wait 1.5)
(shot career)
(key Return)
(wait_screen sel_venue_screen 40)
(wait 1.5)
(shot venue)
(key Return)
(wait_screen sel_song_screen 20)
(wait 1.5)
(shot songs)
(key Escape)
(wait_until {!= {{ui current_screen} name} sel_song_screen} 10)
(quit)

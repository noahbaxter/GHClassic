; Career with the 80s mounted: a band, then the campaigns, each with how far
; that band is through it; picking the 80s lands on its difficulty screen
; for that band, as the 80s.
(needs gh80s)
#include common/first_boot.dta
(expect {campaigns count} 2)
{gamecfg set mode career}
{campaign set_profile_name "The Testers" 0}
{campaign set_profile_slot 0}
{ui goto_screen chooseprof_screen}
(wait_screen chooseprof_screen)
(wait 1)
(shot bands)
{ui goto_screen ghc_campaign_screen}
(wait_screen ghc_campaign_screen)
(wait 2)
(shot campaigns)
(expect {size {ghc_campaign_panel get games}} 2)
(expect {elem {ghc_campaign_panel get games} {ghc_campaign_panel get picked}} gh2)
(expect {campaigns progress gh80s 0} 0)
{set $ghc_switch gh80s}
{set $ghc_switch_next sel_difficulty_screen}
{ui goto_screen ghc_switch_screen}
(wait_screen sel_difficulty_screen)
(wait 2)
(shot difficulty_80s)
(expect {campaigns active} gh80s)
(expect {campaign profile_slot} 0)
(expect {campaign profile_name 0} "The Testers")
{ui goto_screen ghc_campaign_screen}
(wait_screen ghc_campaign_screen)
(wait 2)
(shot campaigns_80s)
(expect {elem {ghc_campaign_panel get games} {ghc_campaign_panel get picked}} gh80s)
(quit)

; Yellow held on the main menu lists the games whose menus it can turn
; into, GH1's then GH2's then the 80s'. Let go where it opened, nothing
; changes; stepped down and let go, the menu is that game's. Holds with any
; set of discs (ghc.py scenarios --discs).
#include common/first_boot.dta
(wait 1)
(shot gh2)
; Yellow and the strum are libpad's 0x1000 and 0x40.
(hold 4096)
(wait 1)
(expect {ghc_pick_panel get open} {> {size {ghc_themes}} 1})
(shot open)
(hold 0)
(wait 2)
(expect {ghc_pick_panel get open} 0)
(expect {campaigns active} gh2)
{set $at 0}
{foreach_int $i 0 {size {ghc_themes}} {if {== {elem {ghc_themes} $i} gh2} {set $at $i}}}
{set $want {elem {ghc_themes} {mod {'+' $at 1} {size {ghc_themes}}}}}
(hold 4096)
(wait 1)
(hold 4160)
(wait 0.3)
(hold 4096)
(wait 1)
(shot stepped)
(expect {campaigns active} gh2)
(hold 0)
(wait 4)
(wait_screen main_screen)
(expect {campaigns active} $want)
(wait 2)
(shot picked)
(quit)

; GH1 on hard ends at the arena's fifth song.
(needs gh1)
{set $pick gh1}
{set $d1 down}
{set $d2 down}
{set $d3 none}
{set $v1 none}
{set $finale_venue gh1_arena}
{set $b1 gh1_godzilla}
{set $b2 gh1_texasflood}
{set $b3 gh1_frankenstein}
{set $b4 gh1_cowboysfromhell}
{set $idx 4}
{set $play gh1_barkatthemoon}
#include common/finale_direct.dta

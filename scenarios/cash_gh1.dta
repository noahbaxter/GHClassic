; GH1's cash, scaled to its store a quarter a difficulty (content/payouts.h):
; a song pays each difficulty's row at or under the one played, once each, so
; one five-starred on Medium pays Easy's and Medium's, again on Hard pays
; Hard's alone, and the fifth on Hard passes the venue for all three rows'.
; The amounts are read from the tables, which follow the store.
(needs gh1)
#include common/first_boot.dta
{set $pick gh1}
#include common/career_start.dta
(expect {game get_difficulty_sym 0} medium)
(expect {campaign cash} 0)
{set $stars {find $syscfg campaign cash star_awards}}
{set $status {find $syscfg campaign cash status_awards}}
{set $e4 {+ {elem {elem $stars 1} 1} {elem {elem $stars 1} 2}}}
{set $e5 {+ $e4 {elem {elem $stars 1} 3}}}
{set $m4 {+ {elem {elem $stars 2} 1} {elem {elem $stars 2} 2}}}
{set $m5 {+ $m4 {elem {elem $stars 2} 3}}}
{set $h4 {+ {elem {elem $stars 3} 1} {elem {elem $stars 3} 2}}}
{set $h5 {+ $h4 {elem {elem $stars 3} 3}}}
; A new song's pay on Hard, by its stars, and a venue's.
{set $new4 {+ $e4 {+ $m4 $h4}}}
{set $new5 {+ $e5 {+ $m5 $h5}}}
{set $venue_pay {+ {elem {elem $status 1} 1} {+ {elem {elem $status 2} 1} {elem {elem $status 3} 1}}}}
(expect {> $e5 0} 1)
(expect {> $m5 0} 1)
(expect {> {elem {elem $stars 4} 3} 0} 1)
(press green)
(wait_screen sel_venue_screen 40)
(wait 1)
(press green)
(wait_screen sel_song_screen)
(wait 2)
{set $index 0}
#include common/career_song.dta
(wait 5)
{player0 win 5}
#include common/career_song_done.dta
{set $cash {+ $e5 $m5}}
(expect {campaign cash} $cash)
{ui goto_screen main_screen}
(wait_screen main_screen 40)
#include common/reenter_career.dta
(wait 1)
(press down)
(press green)
(wait_screen sel_character_new_screen)
(wait_until {char_single are_chars_loaded})
(wait 1)
(press green)
(wait_screen sel_guitar_new_screen)
(wait 3)
(press green)
(wait_screen career_screen 40)
(wait 1)
(expect {game get_difficulty_sym 0} hard)
(expect {campaign cash} $cash)
(press green)
(wait_screen sel_venue_screen 40)
(wait 1)
(press green)
(wait_screen sel_song_screen)
(wait 2)
{set $index 0}
#include common/career_song.dta
(wait 5)
{player0 win 5}
#include common/career_song_done.dta
{set $cash {+ $cash $h5}}
(expect {campaign cash} $cash)
{set $index 1}
#include common/career_song.dta
(wait 5)
{player0 win 5}
#include common/career_song_done.dta
{set $cash {+ $cash $new5}}
(expect {campaign cash} $cash)
{set $index 2}
#include common/career_song.dta
(wait 5)
{player0 win 4}
#include common/career_song_done.dta
{set $cash {+ $cash $new4}}
(expect {campaign cash} $cash)
{set $index 3}
#include common/career_song.dta
(wait 5)
{player0 win 5}
#include common/career_song_done.dta
{set $cash {+ $cash $new5}}
(expect {campaign cash} $cash)
{set $index 4}
#include common/career_song.dta
(wait 5)
{player0 win 5}
(wait_screen endgame_screen 400)
(wait 2)
{set $cash {+ $cash {+ $new5 $venue_pay}}}
(expect {campaign cash} $cash)
(quit)

; P1's guitar gone mid-song: the keyboard steps in for it, its first press
; doing nothing else, and plays the song on in the seat's guitar mode; its
; Enter there no green. The guitar back is P1's again.
#include common/first_boot.dta
(device guitar)
(press down guitar)
(expect {seat_has 0 guitar} 1)
{game set_song shoutatthedevil}
{{game get_player_config 0} set_difficulty easy}
{{game get_player_config 0} set autoplay TRUE}
{game set_quickplay}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait 1)
(expect {game get_controller 0} guitar)
(unplug guitar)
(wait_screen pause_controller_screen 10)
(key Down)
(wait 1)
(expect {seat_has 0 keyboard} 1)
(expect {{ui current_screen} name} pause_controller_screen)
; Enter on Resume resumes, held into the song no Start; Esc pauses and
; resumes it.
(key 1 0.5)
(wait_screen game_screen 10)
(wait 1)
(expect {{ui current_screen} name} game_screen)
(wait 1)
(key Return)
(wait_screen pause_screen 10)
(key Return)
(wait_screen game_screen 10)
(device guitar)
(wait 0.5)
(expect {seat_has 0 guitar} 1)
(quit)

; A whole quickplay song on expert, played by autoplay, to the results.
; Song time ({taskmgr seconds}), which follows the audio, moves 30 s in each
; 30 s of game time, and an autoplayed song ends on the same score every
; run.
(wait_screen main_screen)
{gamecfg set mode quickplay}
{game set_song shoutatthedevil}
{{game get_player_config 0} set_difficulty expert}
{{game get_player_config 0} set autoplay TRUE}
{game set_quickplay}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait 10)
{set $t {taskmgr seconds}}
(wait 30)
(expect {- {taskmgr seconds} $t} 30 0.1)
(shot t40)
{set $t {taskmgr seconds}}
(wait 30)
(expect {- {taskmgr seconds} $t} 30 0.1)
(shot t70)
{set $t {taskmgr seconds}}
(wait 30)
(expect {- {taskmgr seconds} $t} 30 0.1)
(wait_screen endgame_screen 300)
(wait 3)
(expect {player0 score} 158678)
(expect {player0 longest_streak} 518)
(shot end)
(quit)

; A custom song practiced from practice's own list (quickplay's, every
; setlist): only its charted difficulties offered, then straight into the
; whole song at practice's last speed, 90%, stretched to it and played to
; its end on autoplay.
(songs songs)
#include common/first_boot.dta
{latency set audio 110}
{gamecfg set mode practice}
{{game get_player_config 0} set_difficulty easy}
{setlist select custom}
{set $ghc_practice_pct 90}
{ui goto_screen practice_selsong_screen}
(wait_screen practice_selsong_screen)
(wait 3)
(shot song_list)
; A custom song skips the part screen: Select's menu picks its part.
(press green)
(wait_screen practice_diff_screen)
(wait 1)
{{game get_player_config 0} set autoplay TRUE}
; Easy and Expert only, as charted.
(shot difficulties)
(press down)
(press green)
(expect {game get_difficulty_sym 0} expert)
(wait_screen practice_game_screen 60)
; Its chart's own sections, named.
(expect {custom section 0} "Intro")
(expect {song_speed} 90)
; Its one song.opus has no stem of its own: played whole, no clicks.
(expect $ghc_practice_solo 0)
(print {elem {find $syscfg songs {game get_song} song name} 1})
(wait 2)
{set $ghc_t0 {taskmgr ui_seconds}}
{set $ghc_s0 {taskmgr seconds}}
(wait 6)
(expect {'/' {'-' {taskmgr seconds} $ghc_s0} {'-' {taskmgr ui_seconds} $ghc_t0}} 0.9 0.03)
(shot playing)
; Solo Stems is off on its page, unchecked though set, and does nothing.
(press start)
(wait_screen pract_pause_screen 10)
{ui goto_screen ghc_practice_options_screen}
(wait_screen ghc_practice_options_screen 10)
(wait 0.5)
(expect {practice_option solo_stems} 1)
(expect {== {{ghc_practice_options_panel find widescreen.btn} get_state} kDisabled} 1)
(expect {{ghc_practice_options_panel find widescreen.chk} get_check} 0)
(shot no_stems)
{ghc_practice_options_panel set_focus widescreen.btn}
(press green)
(wait 0.2)
(expect {practice_option solo_stems} 1)
(expect $ghc_practice_reload FALSE)
(press start)
(wait_screen practice_game_screen 10)
(wait_until {> $ghc_practice_best 0} 120)
(expect $ghc_practice_best 100)
; Autoplay misses nothing and strums nothing stray: the crown.
(expect $ghc_practice_fc 1)
(wait 0.2)
(expect {{practice_panel find ghc_crown.mesh} showing} 1)
; Hit Percent's crown while this run is still one, from its first hit: none
; just gone round, before any.
(expect {player0 gems_hit} 0)
(expect {{practice_panel find ghc_crown_live.mesh} showing} 0)
(wait_until {> {player0 gems_hit} 0} 20)
(wait 0.2)
(expect {{practice_panel find ghc_crown_live.mesh} showing} 1)
; A best is at its speed: another starts it over.
{song_speed live 95}
(wait 0.2)
(expect $ghc_practice_best 0)
(expect {{practice_panel find ghc_crown.mesh} showing} 0)
; Its Intro from the song's very start, gone round with audio 110 ms behind
; video: it plays (latency.cpp's shift waits for the stream to).
(expect {latency get audio} 110)
{ghc_practice_again}
(wait_screen practice_game_screen 10)
(wait 1)
{set $ghc_s0 {taskmgr seconds}}
(wait 3)
(expect {> {'-' {taskmgr seconds} $ghc_s0} 2} 1)
(quit)

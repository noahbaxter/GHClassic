; Every vertical menu goes round both ways from the keyboard: each Down and
; Up moves the focus, and a lap of as many as it has rows comes back to the
; row it began on. A hidden row left pointing at a shown one stops Up there
; (game_settings.dta).
#include common/first_boot.dta
(device guitar)
(press down guitar)
; The main menu.
{ui goto_screen main_screen}
(wait_screen main_screen)
(wait 1)
{set $start {{ui current_screen} focus_name}}
{set $was {{ui current_screen} focus_name}}
(key Down)
(expect {!= {{ui current_screen} focus_name} $was} 1)
{set $was {{ui current_screen} focus_name}}
(key Down)
(expect {!= {{ui current_screen} focus_name} $was} 1)
{set $was {{ui current_screen} focus_name}}
(key Down)
(expect {!= {{ui current_screen} focus_name} $was} 1)
{set $was {{ui current_screen} focus_name}}
(key Down)
(expect {!= {{ui current_screen} focus_name} $was} 1)
{set $was {{ui current_screen} focus_name}}
(key Down)
(expect {!= {{ui current_screen} focus_name} $was} 1)
{set $was {{ui current_screen} focus_name}}
(key Down)
(expect {!= {{ui current_screen} focus_name} $was} 1)
(expect {== {{ui current_screen} focus_name} $start} 1)
{set $start {{ui current_screen} focus_name}}
{set $was {{ui current_screen} focus_name}}
(key Up)
(expect {!= {{ui current_screen} focus_name} $was} 1)
{set $was {{ui current_screen} focus_name}}
(key Up)
(expect {!= {{ui current_screen} focus_name} $was} 1)
{set $was {{ui current_screen} focus_name}}
(key Up)
(expect {!= {{ui current_screen} focus_name} $was} 1)
{set $was {{ui current_screen} focus_name}}
(key Up)
(expect {!= {{ui current_screen} focus_name} $was} 1)
{set $was {{ui current_screen} focus_name}}
(key Up)
(expect {!= {{ui current_screen} focus_name} $was} 1)
{set $was {{ui current_screen} focus_name}}
(key Up)
(expect {!= {{ui current_screen} focus_name} $was} 1)
(expect {== {{ui current_screen} focus_name} $start} 1)

; Signing in and dropping out (save/profiles.h, ui/dta/profiles.dta). Nobody
; is signed in as the game starts: the main menu's corner has P1 free, and
; P1's Start there picks a profile, as the splash's does. Any seat drops out
; from its Start menu, P1 too: with P2 signed in P2 moves up and stays; the
; last one out goes back to the splash, nobody signed in.
#include common/first_boot.dta
(device guitar)
(device guitar2)
(wait 1)
(expect {ghc_profile holder 0} "")
(expect {ghc_profile holder 1} "")
(expect {ghc_profile current 0} -1)
; P1's Start on the main menu, not signed in, picks a profile: Alpha.
(press start guitar)
(wait_screen ghc_profile_screen 10)
(wait 1)
(expect {seat_has 0 guitar} 1)
(press down guitar)
(wait 0.3)
(press green guitar)
(wait_screen ghc_nameprofile_screen 10)
{{nameprof_panel find profile.ten} set_text "Alpha"}
(press start guitar)
(wait_screen main_screen 10)
(wait 1)
(expect {ghc_profile badge 0} "P1  Alpha")
; P2 joins by Start and makes Beta.
(press start guitar2)
(wait_screen ghc_profile_screen 10)
(wait 1)
(press down guitar2)
(wait 0.3)
(press green guitar2)
(wait_screen ghc_nameprofile_screen 10)
{{nameprof_panel find profile.ten} set_text "Beta"}
(press start guitar2)
(wait_screen main_screen 10)
(wait 1)
(expect {ghc_profile badge 1} "P2  Beta")

; P1 drops out, DROP OUT usable: P2 moves up to P1 and stays signed in, on
; the main menu.
(record on two_players_p1_drops)
(wait 1)
(press start guitar)
(wait 0.6)
(expect {ghc_profile_panel get seat} 0)
(expect {ghc_profile_panel usable 4} 1)
(press down guitar)
(wait 0.3)
(press down guitar)
(wait 0.3)
(press down guitar)
(wait 0.3)
(press down guitar)
(wait 0.3)
(expect {ghc_profile_panel get pick} 4)
(press green guitar)
(wait 1.5)
(record off)
(expect {{ui current_screen} name} main_screen)
(expect {seat_has 0 guitar2} 1)
(expect {ghc_profile badge 0} "P1  Beta")
(expect {ghc_profile holder 1} "")

; Beta, now alone, drops out too: back to the splash, nobody signed in.
(record on last_drops_to_splash)
(wait 1)
(press start guitar2)
(wait 0.6)
(expect {ghc_profile_panel get seat} 0)
(expect {ghc_profile_panel usable 4} 1)
(press down guitar2)
(wait 0.3)
(press down guitar2)
(wait 0.3)
(press down guitar2)
(wait 0.3)
(press down guitar2)
(wait 0.3)
(press green guitar2)
(wait_screen splash_screen 10)
(wait 2)
(record off)
(expect {ghc_profile holder 0} "")
(expect {ghc_profile holder 1} "")
; Start signs in again, the list's rows with no seat's emblem.
(press start guitar)
(wait_screen ghc_profile_screen 10)
(wait 1)
(expect {ghc_profile seat_of 0} -1)
(expect {ghc_profile seat_of 1} -1)
(quit)

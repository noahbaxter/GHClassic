; Who plays (save/profiles.h, ui/dta/profiles.dta). The splash's Start, only
; Start, picks P1's profile on GH2's band list made one of profiles, opening
; on the top row, never GUEST, a seat's row showing its emblem, NEW PROFILE
; naming one on its band naming screen. Fast boot stops on the splash. On
; the main menu Start puts up P1's menu on GH2's popup poster: CHANGE
; PROFILE back to the list, DROP OUT greyed alone. Joining Multiplayer's
; screen picks P2's on the list, only P2's
; controller working it, and P2's DROP OUT frees the seat. The main menu's
; corner and Multiplayer's rows show who holds each seat, and a quickplay
; high score goes in under the profile's name, continuing flushing it. On
; the list yellow renames a profile and blue deletes one no seat plays as; on
; the band list a band.
#include common/first_boot.dta
(device guitar)
(device guitar2)
{ui goto_screen splash_screen}
(wait_screen splash_screen)
(wait 1)
; Only Start leaves it.
(press green guitar)
(wait 1)
(expect {{ui current_screen} name} splash_screen)
; Red on the list goes back to the splash, P1 free again.
(press start guitar)
(wait_screen ghc_profile_screen 10)
(wait 1)
(press red guitar)
(wait_screen splash_screen 10)
(wait 1)
(expect {seat_has 0 guitar} 0)
(press start guitar)
(wait_screen ghc_profile_screen 10)
(wait 1)
(expect {seat_has 0 guitar} 1)
(expect {ghc_profile current 0} -1)
; On the top row, not GUEST.
(expect {chooseprof_panel get button_idx} 0)
(shot list_empty)
; A new profile, named, is P1's, in the first row whichever NEW PROFILE
; row it was picked from.
(press down guitar)
(wait 0.3)
(expect {chooseprof_panel get button_idx} 1)
(press green guitar)
(wait_screen ghc_nameprofile_screen 10)
(wait 1)
(shot name)
{{nameprof_panel find profile.ten} set_text "Alpha"}
(press start guitar)
(wait_screen main_screen 10)
(wait 1)
(expect {ghc_profile named 0} 1)
(expect {ghc_profile name 0} Alpha)
(expect {ghc_profile badge 0} "P1  Alpha")
(shot corner)

; Start puts up P1's menu on the poster, CHANGE PROFILE picked and DROP OUT
; greyed alone; CHANGE PROFILE goes to the list, on Alpha's row.
(press start guitar)
(wait 0.5)
(expect {ghc_profile_panel get seat} 0)
(expect {ghc_profile_panel get poster} 1)
(expect {ghc_profile_panel get pick} 0)
(expect {{ghc_profile_panel find ghc_row1.lbl} showing} 1)
(expect {ghc_profile_panel usable 1} 0)
(shot menu)
(press green guitar)
(wait_screen ghc_profile_screen 10)
(wait 1)
(expect {chooseprof_panel get button_idx} 0)
; A second, Beta, then back to Alpha.
(press down guitar)
(wait 0.3)
(press green guitar)
(wait_screen ghc_nameprofile_screen 10)
{{nameprof_panel find profile.ten} set_text "Beta"}
(press start guitar)
(wait_screen main_screen 10)
(wait 0.5)
(expect {ghc_profile name 0} Beta)
(expect {ghc_profile named 1} 1)
(press start guitar)
(wait 0.5)
(press green guitar)
(wait_screen ghc_profile_screen 10)
(wait 1)
(expect {chooseprof_panel get button_idx} 0)
(press down guitar)
(wait 0.3)
(shot list)
(expect {chooseprof_panel get button_idx} 1)
; Beta is P1's, so blue does not delete it, but yellow renames it: Alpha's
; name, any case, is taken; Gamma is not.
(press blue guitar)
(wait 0.5)
(expect {{ui current_screen} name} ghc_profile_screen)
(press yellow guitar)
(wait_screen ghc_nameprofile_screen 10)
(wait 1)
(expect {{nameprof_panel find profile.ten} get_text} Beta)
{{nameprof_panel find profile.ten} set_text "alpha"}
(press start guitar)
(wait 0.5)
(expect {{ui current_screen} name} ghc_profile_error_screen)
(shot name_taken)
(press green guitar)
(wait 0.5)
(expect {{ui current_screen} name} ghc_nameprofile_screen)
{{nameprof_panel find profile.ten} set_text "Gamma"}
(press start guitar)
(wait_screen ghc_profile_screen 10)
(wait 1)
(expect {ghc_profile name_of 1} Gamma)
(expect {ghc_profile name 0} Gamma)
(shot list_renamed)
; Alpha's, back on the top row, then blue deletes Gamma, no first: no
; keeps it, yes deletes it. The title stays the profiles' as the list goes.
(expect {chooseprof_panel get button_idx} 0)
(record on leaving)
(press green guitar)
(wait_screen main_screen 10)
(wait 0.3)
(record off)
(wait 0.5)
(press start guitar)
(wait 0.5)
(press green guitar)
(wait_screen ghc_profile_screen 10)
(wait 1)
(expect {chooseprof_panel get button_idx} 0)
(press down guitar)
(wait 0.3)
(press blue guitar)
(wait_screen ghc_delete_screen 10)
(wait 1)
(shot delete)
; GH2's own dialog, none of the poster's rows.
(expect {{dialog find dialog.view} showing} 1)
(expect {{dialog find dl_button1.btn} showing} 1)
(expect
   {if_else {{ghc_profile_panel loaded_dir} exists ghc_row0.lbl} {{ghc_profile_panel find ghc_row0.lbl} showing} 0}
   0)
(press green guitar)
(wait_screen ghc_profile_screen 10)
(wait 1)
(expect {ghc_profile named 1} 1)
(press down guitar)
(wait 0.3)
(press blue guitar)
(wait_screen ghc_delete_screen 10)
(wait 1)
(press up guitar)
(wait 0.3)
(press green guitar)
(wait_screen ghc_profile_screen 10)
(wait 1)
(expect {ghc_profile named 1} 0)
(expect {ghc_profile current 0} 0)
; Beta again, for P2, in the row Gamma left.
(press down guitar)
(wait 0.3)
(press green guitar)
(wait_screen ghc_nameprofile_screen 10)
(expect {{nameprof_panel find profile.ten} get_text} "")
{{nameprof_panel find profile.ten} set_text "Beta"}
(press start guitar)
(wait_screen main_screen 10)
(wait 0.5)
(expect {ghc_profile name_of 1} Beta)
(press start guitar)
(wait 0.5)
(press green guitar)
(wait_screen ghc_profile_screen 10)
(wait 1)
(expect {chooseprof_panel get button_idx} 0)
(press green guitar)
(wait_screen main_screen 10)
(wait 0.5)
(expect {ghc_profile name 0} Alpha)

; Joining Multiplayer's screen picks P2's profile on the list; P1's
; controller does nothing to it. P2 picks Beta.
{ui goto_screen multi_screen}
(wait_screen multi_screen)
(press start guitar2)
(wait_screen ghc_profile_screen 10)
(expect {seat_has 1 guitar2} 1)
(wait 1)
; A guest opens on the top row too, Alpha's, P1's emblem on it.
(expect {chooseprof_panel get button_idx} 0)
(expect {{chooseprof_panel find ghc_mark0.mesh} showing} 1)
(expect {{chooseprof_panel find ghc_mark1.mesh} showing} 0)
(shot list_p2)
(press green guitar)
(wait 0.3)
(expect {{ui current_screen} name} ghc_profile_screen)
(press down guitar2)
(wait 0.3)
(expect {chooseprof_panel get button_idx} 1)
(press green guitar2)
(wait_screen multi_screen 10)
(wait 0.5)
(expect {ghc_profile name 1} Beta)
(expect {ghc_players row 0} "P1  Alpha")
(expect {ghc_players row 1} "P2  Beta")
(shot multiplayer)
; P2 drops out from the poster: the seat is free.
(press start guitar2)
(wait 0.5)
(expect {ghc_profile_panel get seat} 1)
(expect {ghc_profile_panel usable 1} 1)
(shot menu_p2)
(press down guitar2)
(wait 0.3)
(expect {ghc_profile_panel get pick} 1)
(press green guitar2)
(wait 0.5)
(expect {seat_has 1 guitar2} 0)
(expect {ghc_players row 1} "P2  press START to join")

; P1's quickplay song is kept as Alpha's, and its high score goes in under
; Alpha with none typed: the last seconds of a disc song, enough to beat
; the table's last score.
{ui goto_screen main_screen}
(wait_screen main_screen)
{game set_num_players 1}
{game set_song shoutatthedevil}
{{game get_player_config 0} set_difficulty expert}
{{game get_player_config 0} set autoplay TRUE}
{game set_quickplay}
{ui goto_screen loading_screen}
(wait_screen game_screen 120)
(wait_until {> {taskmgr seconds} 1} 60)
{beatmatch jump 150000}
{game set_paused TRUE}
(wait 0.5)
{game set_paused FALSE}
(wait_screen endgame_screen 120)
(wait 1)
(expect {== {best score shoutatthedevil expert} {player0 score}} 1)
(press green guitar)
(wait_screen highscore_screen 30)
(wait 1)
(shot highscore)
(expect {highscore_panel get auto_add} 1)
(expect {highscore_panel get placed} 1)
(expect {highscore_panel get flushed} 0)
{highscores get_highscore 2 $name $score}
(expect $name Alpha)
; Continuing flushes it, then on.
(press green guitar)
(wait 0.3)
(expect {highscore_panel get flushed} 1)
(expect {{ui current_screen} name} highscore_screen)
(wait_screen complete_screen 30)

; The splash's Start always picks on the list, on the profile the
; controller last played as.
{ui goto_screen splash_screen}
(wait_screen splash_screen)
(wait 1)
(press start guitar)
(wait_screen ghc_profile_screen 10)
(expect {chooseprof_panel get button_idx} 0)
(press green guitar)
(wait_screen main_screen 10)
(expect {ghc_profile name 0} Alpha)

; The band list renames and deletes a band as Options' Manage Band did.
{campaign set_profile_name "The Testers" 0}
{ui goto_screen chooseprof_screen}
(wait_screen chooseprof_screen)
(wait 1)
(press yellow guitar)
(wait_screen nameprof_screen 10)
(wait 1)
(expect {{nameprof_panel find profile.ten} get_text} "The Testers")
{{nameprof_panel find profile.ten} set_text "The Rest"}
(press start guitar)
(wait_screen chooseprof_screen 20)
(wait 1)
(expect {campaign profile_name 0} "The Rest")
(press blue guitar)
(wait_screen ghc_delete_screen 10)
(wait 1)
(shot delete_band)
(expect {{dialog find dialog.view} showing} 1)
(expect {{dialog find dl_button1.btn} showing} 1)
(expect
   {if_else {{ghc_profile_panel loaded_dir} exists ghc_row0.lbl} {{ghc_profile_panel find ghc_row0.lbl} showing} 0}
   0)
(press up guitar)
(wait 0.3)
(press green guitar)
(wait_screen chooseprof_screen 20)
(wait 1)
(expect {campaign is_empty_profile 0} 1)

; A boot with a save that has a band: fast boot's intro goes on to the
; splash and waits there for Start, not past it.
{campaign set_profile_name "The Rest" 0}
{ui goto_screen cut_scene_screen}
(wait_screen splash_screen 10)
(wait 2)
(expect {{ui current_screen} name} splash_screen)
(quit)

; A list to pick from while yellow is held: it opens in the middle of the
; screen, the strum steps through it, and letting go picks. It is the help
; bar's own text (helpbar.milo, loaded here a second time) on a round-ended
; box (box.dta) as wide as its text and as tall as its rows, with a lighter
; one behind the row picked.
;
; A screen with this among its panels sends its presses here first
; ({ghc_pick_button}), opens it on yellow ({ghc_pick_panel open_with}), and
; is told the pick, where it is not the one the list opened on:
; (ghc_picked ($option)).
;
; Opened with open_sticky it is a menu instead: it stays open when yellow
; is let go, green tells the screen the row picked, (ghc_chose ($option)),
; and select or red shuts it. Its rows' text is the screen's
; (ghc_option_text ($option)), a setlist's name otherwise.
{if {! {exists ghc_pick_panel}} {new GHPanel ghc_pick_panel}}
{retype ghc_pick_panel
   (
      ; From the ARK root: a path resolves against the file its array came
      ; from, and this one comes from no file.
      (file ui/helpbar.milo)
      (rows (pt0.txt pt1.txt pt2.txt pt3.txt))
      ; The list's box and the picked row's fill (box.dta), each with its
      ; colour, how much it hides, and where it draws among the scene's.
      (boxes ((pick_bg 0 0 0 0.875 0) (pick_fill 1 1 1 0.25 1)))
      ; How wide the box's round ends are, outside its text's room.
      (end 8)
      (options ())
      (picked 0)
      (first 0)
      (open FALSE)
      (sticky FALSE)
      ; A row's height, its text's size against the help bar's, and the
      ; room either side of the widest (x right, z up, the screen's middle
      ; 0). The width is the open list's.
      (height 40)
      (size 1.8)
      (margin 18)
      (width 0)
      (enter
         {$this build}
         {$this shut}
      )
      ; The rows, each the help bar's text copied, and the boxes; the help
      ; bar's own stays out of sight.
      (build
         {if {! {exists pt0.txt}}
            {foreach $o
               (
                  help_bar_strum.mesh help_bar_starting.mesh help_bar_strumbar.mesh help_bar.mesh help_bar.txt
                  help_box_left.mesh help_box_mid.mesh help_box_right.mesh
               )
               {{$this find $o} set_showing FALSE}
            }
            {foreach $row [rows]
               {new Text $row}
               {{$this find $row} copy help_bar.txt 0}
               {{$this find $row} set_local_scale [size] [size] [size]}
               {{$this find $row} set draw_order 2}
               {helpbar.view insert (objects 0) {$this find $row}}
            }
            ; Drawn with the help bar's own: the box, then the fill, then
            ; the text.
            {foreach $box [boxes]
               {ghc_box_make $this {elem $box 0} {help_box_mid.mesh get trans_parent} {elem $box 5}}
               {ghc_box_color $this {elem $box 0} {elem $box 1} {elem $box 2} {elem $box 3} {elem $box 4}}
               {foreach $part ("_left.mesh" "_mid.mesh" "_right.mesh")
                  {helpbar.view insert (objects 0) {$this find {sprint {elem $box 0} $part}}}
               }
            }
            {helpbar.view sort_draws}
            {{$this loaded_dir} sync_objects}
         }
      )
      ; That box, the list's width between ends $p_end wide and $p_tall
      ; tall, its middle at height $p_z.
      (stretch
         ($p_box $p_z $p_tall $p_end)
         {ghc_box_put $this $p_box
            {'-' {/ [width] -2.0} $p_end}
            0
            $p_z
            {'+' [width] {'*' 2 $p_end}}
            $p_tall
            $p_end
            $p_end
         }
         {ghc_box_show $this $p_box TRUE}
      )
      ; That row's height on screen, the list's middle at 0.
      (row_z ($i) {'*' [height] {'-' {/ {'-' {size [options]} 1} 2.0} $i}})
      ; Open on those options, the list's top first, with that one picked.
      (open_with
         ($options $current)
         {set [options] $options}
         {set [picked] 0}
         {set [width] 0}
         {foreach_int $i 0 {size $options}
            {do
               ($text {$this text {elem $options $i}})
               ($wide {'*' [size] {help_bar.txt get_string_width $text}})
               {{$this find {elem [rows] $i}} set_text $text}
               {if {> $wide [width]} {set [width] $wide}}
               {if {== {elem $options $i} $current} {set [picked] $i}}
            }
         }
         {set [first] [picked]}
         {foreach_int $i 0 {size [rows]}
            {do
               ($row {$this find {elem [rows] $i}})
               {$row set_showing {< $i {size $options}}}
               {if {< $i {size $options}}
                  {$row set_local_pos {/ [width] -2.0} 0 {$this row_z $i}}
               }
            }
         }
         {set [width] {'+' [width] {'*' 2 [margin]}}}
         {$this stretch pick_bg 0 {'+' {'*' [height] {size $options}} 12} [end]}
         {set [open] TRUE}
         {$this paint}
      )
      (text
         ($option)
         {if_else [sticky]
            {{ui current_screen} ghc_option_text $option}
            {localize {sprint "setlist_" $option}}
         }
      )
      (open_sticky
         ($options $current)
         {set [sticky] TRUE}
         {$this open_with $options $current}
      )
      ; Its rows' text again, the same row picked.
      (relabel {$this open_with [options] {elem [options] [picked]}})
      ; The fill has no round ends to draw.
      (paint
         {$this stretch pick_fill {$this row_z [picked]} [height] 0}
         {pick_fill_left.mesh set_showing FALSE}
         {pick_fill_right.mesh set_showing FALSE}
      )
      ; Up or down the list, round its ends.
      (step
         ($by)
         {set [picked] {mod {'+' {'+' [picked] $by} {size [options]}} {size [options]}}}
         {synth play_sequence button_focus}
         {$this paint}
      )
      (shut
         {foreach $o [rows] {{$this find $o} set_showing FALSE}}
         {foreach $box [boxes] {ghc_box_show $this {elem $box 0} FALSE}}
         {set [open] FALSE}
         {set [sticky] FALSE}
      )
      ; Yellow let go: the pick, to the screen.
      (poll
         {if {&& [open] {! [sticky]} {! {pad_held yellow}}}
            {$this shut}
            {if {!= [picked] [first]}
               {{ui current_screen} ghc_picked {elem [options] [picked]}}
            }
         }
      )
   )
}
; A screen's press while the list may be open: with it open the strum steps
; it and nothing else gets the press.
{func ghc_pick_button ($button)
   {if_else {ghc_pick_panel get open}
      {do
         {if {== $button kPad_DUp} {ghc_pick_panel step -1}}
         {if {== $button kPad_DDown} {ghc_pick_panel step 1}}
         {if {ghc_pick_panel get sticky}
            {cond
               ({== $button kPad_X}
                  {{ui current_screen} ghc_chose
                     {elem {ghc_pick_panel get options} {ghc_pick_panel get picked}}}
               )
               ({|| {== $button kPad_Select} {== $button kPad_Tri}}
                  {synth play_sequence button_back.cue}
                  {ghc_pick_panel shut}
               )
            }
         }
         TRUE
      }
      FALSE
   }
}

; The main menu, as the game's own (main.dta) with a Quit button under
; Options. main.milo has five buttons; the sixth is Options cloned on entry
; (copy brings its style and resource), scaled down into the gap below it,
; and linked below it (strum up follows the link backwards). The buttons
; draw through their parent group, so it joins that; sync_objects adds it to
; the panel's focus list.
;
; The lick the splash and the menu each play runs up to 6 s and nothing of
; the game's stops it: without a disc load after the menu it plays over the
; next screen. Its ten sounds get a fader of their own before either plays,
; which leaving the menu fades out (dB, ms).
{set $lick_fade {new Fader lick.fade}}
{func lick_attach
   {$lick_fade set_val 0}
   {foreach_int $i 0 10 {{synth find {sprint "meta_lick" $i}} add_fader $lick_fade}}
}
{retype main_panel
   (
      ; From the ARK root: a path resolves against the file its array came
      ; from, and this one comes from no file.
      (file ui/main.milo)
      (focus main_quickspin.btn)
      (msg_last_frame 0)
      (already_entered FALSE)
      (memcard_flow_entered FALSE)
      (retain_last_focus FALSE)
      ; Quit's size, and where from Options (x right, z up): small, in the
      ; black gap at the poster's foot. Shrunk less in height, which keeps
      ; the bitmap font nearer full size and so sharper.
      (quit_width 0.44)
      (quit_height 0.72)
      (quit_dx 47)
      (quit_dz -14)
      ; The build's version ($ghc_version, menus.cpp): a copy of the help
      ; bar's text, drawn with the menu but placed from the help bar's group,
      ; which gives it the help bar's size and faces it to the menu's light
      ; (placed from the poster it comes out dim and narrow). Its right end
      ; at the top right corner, above the poster's tape.
      (version_x 290)
      (version_z 245)
      (enter
         {$this add_quit}
         {$this add_version}
         {set $main_entered TRUE}
         {$this reset_player_settings}
         {if {! [already_entered]}
            {lick_attach}
            {synth play_sequence meta_lick}
            {if {&& {== {game get_controller 0} guitar} {== {campaign tutorials_done} 0}}
               {$this set_focus main_tutorial.btn}
            }
            {$this set already_entered TRUE}
         }
         {game set_tutorial_running FALSE}
         {main_msg.view set_showing FALSE}
         {set [msg_last_frame] 0}
      )
      (exit {$lick_fade fade kDbSilence 1500})
      (add_quit
         {if {! {exists quit.btn}}
            {do
               ($ox 0) ($oy 0) ($oz 0)
               ($group {main_options.btn get trans_parent})
               {new {main_options.btn class_name} quit.btn}
               {quit.btn copy main_options.btn 0}
               {main_options.btn get_local_pos $ox $oy $oz}
               ; The button's own scale belongs to its button.tnm (BandButton
               ; Update 0x28ccd8), so a group under it carries the size.
               {new Group quit.grp}
               {quit.grp set trans_parent $group}
               {quit.grp set_local_pos {'+' $ox [quit_dx]} $oy {'+' $oz [quit_dz]}}
               {quit.grp set_local_scale [quit_width] 1 [quit_height]}
               {quit.btn set trans_parent quit.grp}
               {quit.btn set_local_pos 0 0 0}
               {quit.btn set text_token pause_quit} ; "QUIT", the pause menu's
               {main_options.btn set nav_down quit.btn}
               ; Last, so it draws over the poster as the others do.
               {$group insert (objects {$group size objects}) quit.btn}
               {{$this loaded_dir} sync_objects}
            }
         }
      )
      (add_version
         {if {! {exists version.txt}}
            {do
               ($group {main_options.btn get trans_parent})
               ($help {{helpbar loaded_dir} find help_bar.txt})
               {new Text version.txt}
               {version.txt copy $help 0}
               {version.txt set trans_parent {$help get trans_parent}}
               {version.txt set_local_pos [version_x] 0 [version_z]}
               {version.txt set_align 20} ; kTopRight
               {version.txt set_wrap_width 10000} ; one line, however long
               {version.txt set_text $ghc_version}
               {$group insert (objects {$group size objects}) version.txt}
               {{$this loaded_dir} sync_objects}
            }
         }
      )
      (SELECT_START_MSG
         {switch $component
            (main_career.btn
               {gamecfg set mode career}
               {if_else {> {campaign num_profiles} 0}
                  {ui goto_screen chooseprof_screen}
                  {do
                     {nameprof_screen set back_screen main_screen}
                     {nameprof_screen set is_editing FALSE}
                     {nameprof_screen set profile_slot 0}
                     {nameprof_screen set next_screen
                        {if_else {ghc_campaigns} ghc_campaign_screen sel_difficulty_screen}}
                     {ui goto_screen nameprof_screen}
                  }
               }
            )
            (main_quickspin.btn
               {gamecfg set mode quickplay}
               {ui goto_screen qp_selsong_screen}
            )
            (main_multiplayer.btn {ui goto_screen multi_screen})
            (main_tutorial.btn {ui goto_screen training_screen})
            (main_options.btn {ui goto_screen options_screen})
            ; As the win screen leaves (endgame.dta): fade to black over a
            ; second; then a moment on black. The music fades on its own
            ; (MetaMusic::Stop ramps it down over a second), not through the
            ; fade's fade_synth, which would take the select sound with it.
            ; The help bar draws over the fade, so it goes.
            (quit.btn
               {helpbar set_display ()}
               {fade_panel start_fade 1 (color 0 0 0) (fade_synth FALSE) (fade_out TRUE)}
               {meta_music stop}
               {script_task (units kTaskUISeconds) (delay 1.2) (script {quit_app})}
            )
         }
      )
      (poll
         {if_else {game is_missing_multi_controller}
            {$this disable main_multiplayer.btn}
            {$this enable main_multiplayer.btn}
         }
         {main_msg.view set_showing
            {< {taskmgr ui_seconds} {$this get msg_last_frame}}
         }
      )
      (reset_player_settings
         {{game get_player_config 0} set_difficulty kDifficultyMedium}
         {game set_venue small2}
         {game set_song_index 0}
         {game set_character punk1 TRUE}
         {game set_guitar_index 0}
         {do
            ($player2_config {game get_player_config 1})
            {$player2_config set_character {campaigns second_character} TRUE}
            {$player2_config set_guitar_index 0}
            {$player2_config set_difficulty kDifficultyMedium}
         }
      )
      (display_cheat_msg
         ($cheat $enable)
         {mm_msg.lbl set_localized_text
            {sprintf
               {localize
                  {if_else $enable
                     cheat_enabled_fmt
                     cheat_disabled_fmt
                  }
               }
               {localize $cheat}
            }
         }
         {$this set msg_last_frame {'+' {taskmgr ui_seconds} 5}}
      )
   )
}
; The games whose menus these can turn into: those with a campaign
; ({campaigns}, content/campaigns.h). The 360's songs have no menus of
; their own, so its campaign is not one of these.
{func ghc_themes
   {do
      ($themes)
      {set $themes ()}
      {resize $themes 0}
      {foreach $game (gh1 gh2 gh80s)
         {if {campaigns has $game} {push_back $themes $game}}
      }
      $themes
   }
}
; The main screen, as the game's own but for fade_panel, which Quit fades
; through, and for yellow: held, it lists those games (picker.dta), and the
; one picked becomes the campaign and so the menus and music, back on this
; screen.
{retype main_screen
   (
      (panels meta main_panel helpbar ghc_pick_panel fade_panel)
      (focus main_panel)
      (access_all {main_panel reset_player_settings})
      ; The help bar puts up a screen's (helpbar ...) after its enter, so
      ; this one has none and sets its own.
      (enter
         {$this turn_off_ambient}
         {do
            ($array)
            {set $array ()}
            {resize $array 0}
            {push_back $array (fret1 help_continue)}
            {if {> {size {ghc_themes}} 1} {push_back $array (fret3 ghc_theme)}}
            {push_back $array (strum help_updown)}
            {helpbar set_display $array}
         }
      )
      (BUTTON_DOWN_MSG
         {cond
            ({ghc_pick_button $button} TRUE)
            ({&& {== $button kPad_Circle} {> {size {ghc_themes}} 1} {! {ui in_transition}}}
               {ghc_pick_panel open_with {ghc_themes} {campaigns active}}
               TRUE
            )
            (TRUE kDataUnhandled)
         }
      )
      (ghc_picked
         ($game)
         {synth play_sequence button_select}
         {set $ghc_switch $game}
         {set $ghc_switch_next main_screen}
         {ui goto_screen ghc_switch_screen}
      )
   )
}
; The splash, as the game's own (splash.dta) but for lick_attach.
{retype splash_panel
   (
      (file ui/splash.milo)
      (player_num 0)
      (finish_load {splash.view set_frame 0} {splash_legal.view set_showing TRUE})
      (enter
         {splash.view animate (period 3.333) (range 0 100)}
         {set $enter_time {taskmgr ui_seconds}}
         {game_screen set attract_mode FALSE}
         {set $entering_attract_mode FALSE}
         {set $disable_attract_mode FALSE}
         {lick_attach}
         {synth play_sequence meta_lick}
      )
      (poll
         {if {&& {! $entering_attract_mode} {! {ui in_transition}}}
            {do
               ($now {'-' {taskmgr ui_seconds} $enter_time})
               {if {> $now 60}
                  {if {! $disable_attract_mode} {$this enter_attract_mode}}
               }
            }
         }
      )
      (enter_attract_mode
         {gamecfg set mode attract}
         {set $entering_attract_mode TRUE}
         {game set_song {campaign pick_attract_song}}
         {{game get_player_config 0} set_difficulty kDifficultyExpert}
         {game set_quickplay}
         {game_screen set attract_mode TRUE}
         {ui goto_screen loading_screen}
      )
      (BUTTON_DOWN_MSG
         {if {meta is_any_button $button $player_num}
            {synth play_sequence button_select}
            {ui goto_screen main_screen}
         }
      )
   )
}

; Game Settings: a screen of the port's own under Options and in the pause
; menu, beside Audio and Video, holding the note speed ({note_speed ...},
; note_speed.cpp).
;
; The hyperspeed cheat goes: note speed replaces it. It is the fourth of
; gh2.dta's long_cheats, after the array's name. Once: this is run again
; where the screens take another game's scripts, and the cheats stay.
{if {! $ghc_hyper_speed_gone}
   {set $ghc_hyper_speed_gone TRUE}
   {remove_elem {find $syscfg long_cheats} {elem {find $syscfg long_cheats} 4}}
}

; The highway's length ({highway_length}, note_speed.cpp) is where a gem
; first shows, the track's horizon_y (track_graphics.dta): its camera sees
; that far, and its pools of gems and tails hold as many more as it is
; longer. The board is made longer as each track is built.
{func ghc_highway
   {do
      ($n {highway_length})
      ($track {find $syscfg track_graphics})
      {set_elem {find $track horizon_y} 1 $n}
      {set_elem {find $track cam far_plane} 1 {if_else {> $n 110} {'+' $n 90} 200}}
      {set_elem {find $track init_gems} 1 {int {/ {'*' 25 {max $n 110}} 110}}}
      {set_elem {find $track init_tails} 1 {int {/ {'*' 16 {max $n 110}} 110}}}
   }
}
{ghc_highway}

; Audio Settings in GH1's scenes (gh1/menus.dta), out of a song and in one:
; GH1's sliders link to nothing, its own script moved between them, so they
; are linked down and round. Its rows for playing left handed go, each
; leading to itself: up is to whatever leads down to the focus, the first
; the scene lists, and one left leading to the top row stops up there.
{func ghc_gh1_audio_rows ($panel)
   {do
      ($dir {$panel loaded_dir})
      {ghc_audio_miss_row $panel}
      {{$dir find gs_band.sld} set nav_down {$dir find gs_guitar.sld}}
      {{$dir find gs_guitar.sld} set nav_down {$dir find gs_sfx.sld}}
      {{$dir find gs_sfx.sld} set nav_down {$dir find gs_stereo.btn}}
      {{$dir find gs_stereo.btn} set nav_down {$dir find miss.btn}}
      {{$dir find miss.btn} set nav_down {$dir find gs_band.sld}}
      {foreach $o (gs_left_p1.btn gs_left_p2.btn)
         {if {$dir exists $o}
            {{$dir find $o} set_showing FALSE}
            {$panel disable {$dir find $o}}
            {{$dir find $o} set nav_down {$dir find $o}}
         }
      }
   }
}

; Audio Settings' MISS MUTE row under STEREO: a miss or a sustain let go early
; cuts the played part ({miss_mute}, sustain_release.cpp). Its button and box
; are STEREO's again, made once a scene load. STEREO stands a slider's gap
; under the last slider, in a parent of its own; the five rows close to three
; quarters of that gap, the first where it was, so MISS MUTE stands where
; STEREO did. GH1's scenes make it from their own enter (ghc_gh1_audio_rows),
; and toggle it from their own select (gh1/menus.dta).
{func ghc_audio_miss_row ($panel)
   {if {! {$panel find miss.btn FALSE}}
      {do
         ($x 0) ($y 0) ($z 0) ($top 0) ($gap 0) ($step 0)
         {{$panel find gs_band.sld} get_local_pos $x $y $top}
         {{$panel find gs_guitar.sld} get_local_pos $x $y $z}
         {set $gap {'-' $z $top}}
         {set $step {'*' 0.75 $gap}}
         {{$panel find gs_guitar.sld} set_local_pos $x $y {'+' $top $step}}
         {{$panel find gs_sfx.sld} get_local_pos $x $y $z}
         {{$panel find gs_sfx.sld} set_local_pos $x $y {'+' $top {'*' 2 $step}}}
         {foreach $row ((miss.btn gs_stereo.btn) (miss.chk stereo.chk))
            {do
               ($from {$panel find {elem $row 1}})
               ($parent {$from get trans_parent})
               {new {$from class_name} {elem $row 0}}
               {{$panel find {elem $row 0}} copy $from 0}
               {{$panel find {elem $row 0}} set trans_parent $parent}
               ; GH1's scene draws its row by its Group's list.
               {if {&& $parent {== {$parent class_name} Group}}
                  {$parent insert (objects {$parent size objects}) {$panel find {elem $row 0}}}
               }
               {$from get_local_pos $x $y $z}
               {{$panel find {elem $row 0}} set_local_pos $x $y {'+' {'+' $z {'*' 3 {'-' $step $gap}}} $step}}
               {$from set_local_pos $x $y {'+' $z {'*' 3 {'-' $step $gap}}}}
            }
         }
         {{$panel find miss.btn} set text_token {symbol "MISS MUTE"}}
         {{$panel find gs_stereo.btn} set nav_down {$panel find miss.btn}}
         {{$panel find miss.btn} set nav_down {$panel find gs_band.sld}}
         {{$panel loaded_dir} sync_objects}
      }
   }
   {{$panel find miss.chk} set_check {miss_mute}}
}
; GH1's after its own select and help bar: the box toggled when it is the
; row picked ($a_picked), and the help bar's for a box while it is lit.
{func ghc_gh1_audio_miss ($a_panel $a_picked)
   {if {&& {$a_panel find miss.btn FALSE} {== $a_picked {$a_panel find miss.btn}}}
      {{$a_panel find miss.chk} toggle}
      {miss_mute {{$a_panel find miss.chk} get_check}}
   }
   {if {&& {! {$a_panel slider_selected}} {== {$a_panel focus_name} miss.btn}}
      {helpbar set_display ((fret1 help_onoff) (fret2 help_back) (strum help_updown))}
   }
}
; The game's own (options.dta's AUDIO_SETTINGS_PANEL_HANDLERS), restated
; where they change.
#define AUDIO_MISS_ROW (
   (enter
      {gs_band.sld set_current {options get band_volume_idx}}
      {gs_guitar.sld set_current {options get guitar_volume_idx}}
      {gs_sfx.sld set_current {options get fx_volume_idx}}
      {stereo.chk set_check {options get_stereo}}
      {ghc_audio_miss_row $this}
   )
   (update_help_display
      {if_else {$this slider_selected}
         {helpbar set_display ((fret1 help_confirm) (fret2 help_cancel) (strum help_adjvol))}
         {if_else {|| {== [focus_component] "gs_stereo.btn"} {== [focus_component] "miss.btn"}}
            {helpbar set_display ((fret1 help_onoff) (fret2 help_back) (strum help_updown))}
            {helpbar set_display ((fret1 help_select) (fret2 help_back) (strum help_updown))}
         }
      }
   )
   (SELECT_START_MSG
      {switch $component
         (gs_band.sld {$this set orig_vol {gs_band.sld current}})
         (gs_guitar.sld {$this set orig_vol {gs_guitar.sld current}})
         (gs_sfx.sld {$this set orig_vol {gs_sfx.sld current}})
         (gs_stereo.btn {stereo.chk toggle} {options set_stereo {stereo.chk get_check}})
         (miss.btn {miss.chk toggle} {miss_mute {miss.chk get_check}})
         kDataUnhandled
      }
      {$this update_help_display}
   )
)
{amend audio_settings_panel AUDIO_MISS_ROW}
{amend pause_audio_settings_panel AUDIO_MISS_ROW}

; The options menu, as the game's own (options.dta) with its Audio and Video
; rows folded into one Settings row, as the pause menu has: Settings, Manage
; Band, Data Settings, Bonus Videos, Credits. Settings shows the same poster
; with the rows Audio, Video, Controllers (controllers.dta) and Game Settings,
; and red goes back to the first rows. $ghc_options_settings is which shows,
; so each of those screens, going back to options_screen, comes back to it.
;
; options.milo has six rows, each button in a group of its own that fans it
; about the poster's corner. Each row's place is kept as a group where its
; button stands, and the rows shown are put in the places from the top; the
; last, Credits', is left empty. Game Settings and Controllers are Video
; Settings cloned on entry. GH1's scene (gh1/screens.cpp) has Game Settings
; already and its seven rows evenly down the poster, so its places are its
; first five.
{retype options_panel
   (
      ; From the ARK root: a path resolves against the file its array came
      ; from, and this one comes from no file.
      (file ui/options.milo)
      (focus op_audio.btn)
      (enter {$this add_rows} {$this show_rows})
      (add_rows
         {if {! {exists ghc_op_place1.grp}}
            {do
               ($x 0) ($y 0) ($z 0) ($place 0)
               ($draw {video_settings.btn get trans_parent})
               ($from
                  {if_else {exists game_settings.btn}
                     (op_audio.btn video_settings.btn game_settings.btn op_data.btn memory_card.btn)
                     (op_audio.btn video_settings.btn op_data.btn memory_card.btn op_bonus.btn)
                  }
               )
               {foreach $btn $from
                  {set $place {'+' $place 1}}
                  {do
                     ($grp {symbol {sprint "ghc_op_place" $place ".grp"}})
                     {new Group $grp}
                     {$grp set trans_parent {$btn get trans_parent}}
                     {$btn get_local_pos $x $y $z}
                     {$grp set_local_pos $x $y $z}
                  }
               }
               {foreach $btn (game_settings.btn controllers.btn)
                  {if {! {exists $btn}}
                     {new {video_settings.btn class_name} $btn}
                     {$btn copy video_settings.btn 0}
                     {$draw insert (objects {$draw size objects}) $btn}
                  }
               }
               ; A token with no string reads as itself.
               {game_settings.btn set text_token "Game Settings"}
               {controllers.btn set text_token "Controllers"}
               {{$this loaded_dir} sync_objects}
            }
         }
      )
      (show_rows
         {do
            ($rows
               {if_else $ghc_options_settings
                  (op_audio.btn video_settings.btn controllers.btn game_settings.btn)
                  (op_audio.btn op_data.btn memory_card.btn op_bonus.btn op_credit.btn)
               }
            )
            ($place 0)
            ($last {elem $rows {'-' {size $rows} 1}})
            ; The row focused, coming back to the menu, keeps its focus. Up
            ; goes to the row whose nav_down is this one, so a hidden row's
            ; points at itself: the stock scene's and the other set's would
            ; be found first and lead nowhere.
            {foreach $btn (video_settings.btn controllers.btn game_settings.btn op_data.btn memory_card.btn
                  op_bonus.btn op_credit.btn)
               {if {! {find_elem $rows $btn}}
                  {$btn set_showing FALSE}
                  {$btn set_state kDisabled}
                  {$btn set nav_down $btn}
               }
            }
            {foreach $btn $rows
               {set $place {'+' $place 1}}
               {$btn set trans_parent {$this find {sprint "ghc_op_place" $place ".grp"}}}
               {$btn set_local_pos 0 0 0}
               {$btn set_showing TRUE}
               {if {== {$btn get_state} kDisabled} {$btn set_state kNormal}}
               {$last set nav_down $btn}
               {set $last $btn}
            }
            {op_audio.btn set text_token {if_else $ghc_options_settings op_game_settings "Settings"}}
         }
      )
      (poll {if $disable_save {op_data.btn set_state kDisabled} {memory_card.btn set_state kDisabled}})
      (SELECT_START_MSG
         {switch $component
            (op_audio.btn
               {if_else $ghc_options_settings
                  {ui goto_screen audio_settings_screen}
                  {do {set $ghc_options_settings TRUE} {$this show_rows}}
               }
            )
            (video_settings.btn {ui goto_screen video_settings_screen})
            (game_settings.btn {ui goto_screen game_settings_screen})
            (controllers.btn {ui goto_screen ghc_controllers_screen})
            (op_data.btn {ui goto_screen options_chooseprof_screen})
            (memory_card.btn {ui goto_screen mem_card_screen})
            (op_bonus.btn {ui goto_screen bonus_material_screen})
            (op_credit.btn {ui goto_screen credits_screen})
         }
         kDataUnhandled
      )
   )
}
{retype options_screen
   (
      (panels meta options_panel helpbar)
      (focus options_panel)
      (helpbar (default ((fret1 help_continue) (fret2 help_back) (strum help_updown))))
      ; Settings opens its rows on the same screen, so it is taken here,
      ; before its button's pressed pop starts: the screen changing would
      ; hide that, and here it would play on over the new rows.
      (BUTTON_DOWN_MSG
         {cond
            ({&& $ghc_options_settings {== $button kPad_Tri}}
               {synth play_sequence button_back.cue}
               {set $ghc_options_settings FALSE}
               {options_panel show_rows}
               {options_panel set_focus {options_panel find op_audio.btn}}
               TRUE
            )
            ({&& {! $ghc_options_settings} {== $button kPad_X} {== {options_panel focus_name} op_audio.btn}}
               {synth play_sequence button_select}
               {set $ghc_options_settings TRUE}
               {options_panel show_rows}
               TRUE
            )
            (TRUE kDataUnhandled)
         }
      )
   )
}

; The pause menu, as the game's own (pause.dta) with one Settings row where
; it has one for audio and one for video, and Video Settings' row as Photo
; (photo_mode.dta): Resume, Restart, Practice in quickplay, Settings, Photo,
; Quit.
; Settings leads to a menu of its own, the same scene again with its rows
; named Audio, Video, Game and Controllers (controllers.dta), and each
; settings screen leads back to that (the screens take the selects and the
; buttons, so each is retyped).
;
; That menu has the scene's five rows as four: Video Settings' put away,
; Quit in its place, and every row half a row lower to keep them centred.
; Each time the scene loads; one of four rows (GH1's) is left as it is.
#define PAUSE_FOUR_ROWS (
   (four_rows
      {if {&& {exists video_options.btn} {video_options.btn showing}}
         {do
            ($x 0) ($y 0) ($z 0) ($above 0) ($row 0)
            {audio_options.btn get_local_pos $x $y $above}
            {video_options.btn get_local_pos $x $y $row}
            {quit.btn get_local_pos $x $y $z}
            {quit.btn set_local_pos $x $y $row}
            {set $row {'-' $row $above}}
            {video_options.btn set_showing FALSE}
            {video_options.btn set_state kDisabled}
            {audio_options.btn set nav_down quit.btn}
            {foreach $btn (resume.btn restart.btn audio_options.btn quit.btn)
               {$btn get_local_pos $x $y $z}
               {$btn set_local_pos $x $y {'+' $z {'/' $row 2.0}}}
            }
         }
      }
   )
)
{retype pause_panel
   (
      (file ui/pause.milo)
      (focus resume.btn)
      (reset_focus TRUE)
      (enter
         {$this lay_rows}
         ; A token with no string reads as itself.
         {audio_options.btn set text_token "SETTINGS"}
         {video_options.btn set text_token "PHOTO"}
         {ghc_practice.btn set text_token "PRACTICE"}
      )
      ; In quickplay and career, Practice under Restart, Restart cloned: the song again
      ; in practice (ghc_practice_song). GH1's scene has four rows, and Video
      ; Settings' put away: that one as Quit's again. A frame has little room
      ; past its own rows, so more rows start higher and stand closer: [up]
      ; rows above Resume and [gap] rows apart, by the scene and the rows
      ; shown, and the title [raise] rows higher. Each time the scene loads.
      (rows_at ((gh2_5 0 1 0) (gh2_6 0.5 1 0) (gh1_5 0.2 0.9 0) (gh1_6 1.45 0.95 2.2)))
      (lay_rows
         {if {! {exists ghc_practice.btn}}
            {do
               ($gh1 {! {video_options.btn showing}})
               ($rows
                  {if_else {|| {== {gamecfg get mode} quickplay} {== {gamecfg get mode} career}}
                     (resume.btn restart.btn ghc_practice.btn audio_options.btn video_options.btn quit.btn)
                     (resume.btn restart.btn audio_options.btn video_options.btn quit.btn)
                  }
               )
               ($at {find [rows_at] {symbol {sprint {if_else $gh1 gh1 gh2} "_" {size $rows}}}})
               ($x 0) ($y 0) ($z 0) ($row 0) ($i 0)
               {new {restart.btn class_name} ghc_practice.btn}
               {ghc_practice.btn copy restart.btn 0}
               {ghc_practice.btn set trans_parent {restart.btn get trans_parent}}
               ; The rows draw through their parent, over the frame.
               {{restart.btn get trans_parent} insert (objects {{restart.btn get trans_parent} size objects}) ghc_practice.btn}
               {ghc_practice.btn set_showing {== {size $rows} 6}}
               {ghc_practice.btn set_state {if_else {== {size $rows} 6} kNormal kDisabled}}
               {if $gh1
                  {video_options.btn copy quit.btn 0}
                  {video_options.btn set trans_parent {quit.btn get trans_parent}}
                  {video_options.btn set_showing TRUE}
                  {video_options.btn set_state kNormal}
               }
               {resume.btn get_local_pos $x $y $z}
               {restart.btn get_local_pos $x $y $row}
               {set $row {'-' $row $z}}
               {do
                  ($tx 0) ($ty 0) ($tz 0)
                  {pause_title.lbl get_local_pos $tx $ty $tz}
                  {pause_title.lbl set_local_pos $tx $ty {'-' $tz {'*' {elem $at 3} $row}}}
               }
               {foreach $btn $rows
                  {$btn set_local_pos $x $y
                     {'+' {'-' $z {'*' {elem $at 1} $row}} {'*' {'*' {elem $at 2} $row} $i}}
                  }
                  {if {> $i 0} {{elem $rows {'-' $i 1}} set nav_down $btn}}
                  {set $i {'+' $i 1}}
               }
               {{$this loaded_dir} sync_objects}
            }
         }
      )
   )
}
{retype pause_screen
   (
      (panels GAME_PANELS pause_panel)
      (focus pause_panel)
      (clear_vram TRUE)
      (in_game TRUE)
      PAUSE_SCREEN_HANDLERS
      (SELECT_START_MSG
         {switch $component
            (resume.btn {$this resume})
            (restart.btn {$this restart})
            (ghc_practice.btn {ghc_practice_song})
            (audio_options.btn {ui goto_screen pause_settings_screen})
            (video_options.btn {ui goto_screen photo_screen})
            (quit.btn
               {if {== career {gamecfg get mode}} {gamecfg set continue_screen sel_song_screen}}
               {meta_loading_goto {gamecfg get continue_screen}}
            )
         }
      )
      (BUTTON_DOWN_MSG {if {== $button kPad_Start} {$this resume}} kDataUnhandled)
   )
}

; A quickplay or career song in practice, from its pause menu, as GH2 goes
; there from a failed career song (lose.dta's goto_practice_mode): the whole
; song at once, its sections picked in its pause menu. Practice's Return then
; goes back to that song, until the main menu.
{set $ghc_practice_from FALSE}
{set $ghc_practice_row -1} ; a career song's setlist row, for Return to come back on
{func ghc_practice_song
   {set $ghc_practice_from {gamecfg get mode}}
   {set $ghc_practice_row {if_else {== $ghc_practice_from career} {game get_song_index} -1}}
   {gamecfg set mode practice}
   {gamecfg set_track 0 0}
   {practice_sel_section_screen set career_mode {== $ghc_practice_from career}}
   {set $ghc_qp_speed {song_speed}}
   ; At the speed it was playing, within practice's.
   {song_speed set {max 25 {min 200 {song_speed}}}}
   {ghc_practice_whole}
   {meta_loading_goto practice_loading_screen}
}
; Practice's Return, back to the song list it began from, on the song: the
; career's or quickplay's (at its own speed), else practice's.
{func ghc_practice_exit
   {cond
      ({practice_sel_section_screen get career_mode}
         {career_screen resume_from_practice}
         {song_speed set 100}
         {meta_loading_goto sel_song_screen}
      )
      ({== $ghc_practice_from quickplay}
         {gamecfg set mode quickplay}
         {song_speed set $ghc_qp_speed}
         {meta_loading_nosave_goto qp_selsong_screen}
      )
      (TRUE {meta_loading_nosave_goto practice_selsong_screen})
   }
}
; Practice loads the whole song, (practice_sections) -1 -1, its sections
; picked as it plays: GH2 cuts the chart to the sections picked as it loads
; (SongDB::Load's SongParser bounds), so only a song loaded whole can go to
; any section in place (ghc_practice_jump). A reload keeps the sections it
; was on, put back as practice begins again.
{set $ghc_practice_kept -2} ; a reload's first section, -2 for none
{set $ghc_practice_kept_to -1}
{func ghc_practice_whole
   {gamecfg set (practice_sections 0) -1}
   {gamecfg set (practice_sections 1) -1}
}
{amend practice_diff_screen
   (SELECT_START_MSG {ghc_practice_whole} {ui goto_screen practice_loading_screen} kDataUnhandled)
}
; A failed career song's Practice as its pause menu's.
{amend lose_panel (goto_practice_mode {ghc_practice_song})}
; Practice plays the part alone where it has channels of its own (not a
; custom song with no stem for it, custom/audio.h), with its drum clicks
; at any speed: GH2's TRIGGERS, a custom song's from its drums. With
; {practice_option solo_stems} off, the whole song.
{set $ghc_practice_solo FALSE}
{func ghc_practice_solo
   {set $ghc_practice_solo {if_else {practice_option solo_stems} {ghc_practice_stems solo} FALSE}}
}
; TRUE if the part has a stem of its own: soloable asks, solo mutes the
; rest. A custom song's played part is its block's guitar track whatever
; it is.
{func ghc_practice_stems ($op)
   {if_else {|| {! {custom ours {game get_song}}} {custom stem {game get_song}}}
      {song_speed $op {find $syscfg songs {game get_song} {gamecfg full_speed_block}}
         {|| {custom ours {game get_song}} {== {gamecfg get_track_type 0} kTrackGuitar}}}
      FALSE
   }
}
{amend practice_panel
   ; As the game's own (practice.dta), but its drum clicks, metronome and
   ; note click are its song's, played by the mix to the sample
   ; (content/practice_sounds.h), not by a MIDI parser's sink.
   (enter
      {events_parser add_sink $this section}
      {game add_sink $this intro_skip}
      {practice_clicks start {game get_song}}
      {mtv_overlay_panel show_overlay FALSE}
      ; Nothing left over from a practice left another way: a setting's
      ; reload (taken by this load) or a section's end.
      {set $ghc_practice_reload FALSE}
      {set $ghc_practice_end FALSE}
      ; A reload's sections back, before the game panel starts at them.
      {if {!= $ghc_practice_kept -2}
         {gamecfg set (practice_sections 0) $ghc_practice_kept}
         {gamecfg set (practice_sections 1) $ghc_practice_kept_to}
         {set $ghc_practice_kept -2}
      }
      ; The section's name in the screen's middle, not right of it beside
      ; where the caption was, and the song's name above it, in its face.
      {do
         ($x 0) ($y 0) ($z 0)
         {section.lbl get_local_pos $x $y $z}
         ; From where the scene has it, kept once: this runs each load.
         {if {== [section_z] ''} {set [section_z] $z}}
         {set $z {'-' [section_z] [section_down]}}
         {section.lbl set_local_pos 0 $y $z}
         {if {! {{$this loaded_dir} exists ghc_song.lbl}}
            {new BandLabel ghc_song.lbl}
            {ghc_song.lbl copy section.lbl 0}
            {ghc_song.lbl set trans_parent {section.lbl get trans_parent}}
            {ghc_song.lbl set_local_rot 0 0 0}
            {ghc_song.lbl set_local_scale [song_size] 1 [song_size]}
            {ghc_song.lbl set fit_text 0}
            {ghc_song.lbl set wrap_width 4000}
            {ghc_song.lbl set_showing TRUE}
         }
         {ghc_song.lbl set_local_pos 0 $y {'+' $z [song_dz]}}
         {ghc_song.lbl set_localized_text {game get_song_text}}
      }
   )
   (song_size 0.95)   ; the song's name against the section's
   (song_dz 36)       ; how far above the section's it stands
   (section_down 14)  ; the section's below where the scene has it, for the song's room
   (section_z '')     ; where the scene has it
   ; The music this many dB down while the metronome or note click is on,
   ; so they are heard over it.
   (duck_db -6)
   (duck
      {music_fader set_val
         {if_else {|| {practice_option metronome} {practice_option note_click}} [duck_db] 0}}
   )
   (exit
      {events_parser remove_sink $this}
      {game remove_sink $this}
      {practice_clicks stop}
      {music_fader set_val 0}
   )
   ; As the game's own (practice.dta), but no song caption (its panel shows
   ; as it loads; the game's own hid it 3 s in): the section's name has the
   ; top to itself.
   (intro_skip
      {mtv_overlay_panel show_overlay FALSE}
      {set [ignore_section] {section_provider section_after_last}}
   )
   (update
      {practice_clicks drums $ghc_practice_solo}
      {if {! [keep_section_text]} {section.lbl set_text ''}}
      {set [keep_section_text] FALSE}
   )
}
; Practice as the game's own (practice.dta), and Select, star power's
; button, restarts the section with nothing loaded again: the game panel
; left and entered on a screen of the same panels (GamePanel::Enter starts
; at the section, a bar ahead), which goes straight back.
{if {! {exists ghc_practice_again_screen}} {new GHScreen ghc_practice_again_screen}}
{retype ghc_practice_again_screen
   (
      (panels practice_panel game hud track_panel mtv_overlay_panel)
      (allow_back FALSE)
      (animate_transition FALSE)
      (in_game TRUE)
      (enter {ui goto_screen practice_game_screen})
   )
}
{amend practice_game_screen
   (BUTTON_DOWN_MSG
      {if {! {game get game_over}}
         {cond
            ({== $button kPad_Start} {game set_paused TRUE} {ui goto_screen pract_pause_screen})
            ({&& {== $button kPad_Select} {! {ui in_transition}}} {ghc_practice_again})
         }
      }
   )
}
{func ghc_practice_again
   {synth stop_all_sfx}
   {game exit}
   {ui goto_screen ghc_practice_again_screen}
}
; The section's end goes round again, as Select's restart, not to the
; game's end screen (game.dta's practice_end); its hits made the best. Gone
; round from the practice panel's poll: the game left from its own task
; frees that task as it runs.
{set $ghc_practice_end FALSE}
{amend game
   (practice_end
      {set $ghc_practice_best {max $ghc_practice_best {ghc_practice_hit_pct}}}
      ; A full combo as every song keeps one (save/results.cpp): no miss,
      ; and every hit one streak, which a stray strum would have ended.
      {if {&& {> {player0 gems_hit} 0} {== {player0 gems_passed} 0} {== {player0 longest_streak} {player0 gems_hit}}}
         {set $ghc_practice_fc TRUE}
      }
      {set $ghc_practice_end TRUE}
   )
}
; Practice's stats, top right over the song, as Clone Hero's: the speed,
; the best of the section's ends since it was picked, and its hits so far.
{set $ghc_practice_best 0}
{set $ghc_practice_fc FALSE} ; a full combo among those ends
{set $ghc_practice_best_for ''}
{func ghc_practice_hit_pct
   {do
      ($all {'+' {player0 gems_hit} {player0 gems_passed}})
      {if_else {> $all 0} {int {'*' 100 {/ {player0 gems_hit} $all}}} 0}
   }
}
{amend practice_panel
   (stats_x 150)   ; the rows' left edge
   (stats_z 150)   ; their top
   (stats_wide 160)
   (stats_mid 90)  ; where the names end and the numbers begin
   (stats_row 18)
   (stats_size 0.5)
   (stats_crown_x 144) ; the crown's left edge, past Best Hit's number
   (stats_shown '')
   (poll
      ; Not under the pause menu, which this panel is also on: a section
      ; ended as it opened goes round once it resumes. (Not by the game's
      ; paused: its practice end pauses it.)
      {if {&& $ghc_practice_end {! {ui in_transition}} {!= {{ui current_screen} name} pract_pause_screen}}
         {set $ghc_practice_end FALSE}
         {ghc_practice_again}
      }
      ; The last section's end, the game's own coming only at the song's
      ; (ghc_practice_whole).
      {do
         ($last {gamecfg get (practice_sections 1)})
         ($from 0) ($to 0)
         {if {&& {!= $last -1} {! $ghc_practice_end}}
            {gamecfg get_section_bounds $last $from $to}
            {if {>= {'*' 1000 {taskmgr seconds}} $to} {game practice_end}}
         }
      }
      {$this duck}
      ; The keyboard's arrows, a step of the speed each as it plays.
      {do
         ($steps {practice_steps})
         {if {&& {!= $steps 0} {! {game get game_over}}} {ghc_practice_speed_by $steps live}}
      }
      {if {! {{$this loaded_dir} exists ghc_stats.grp}} {$this make_stats}}
      {do
         ; Best of the section at this speed: a new speed starts it over.
         ($for {sprint {game get_song} " " {gamecfg get (practice_sections 0)} " " {gamecfg get (practice_sections 1)} " " {song_speed playing}})
         ($hit {player0 gems_hit})
         ($all {'+' $hit {player0 gems_passed}})
         {if {!= $for $ghc_practice_best_for}
            {set $ghc_practice_best_for $for}
            {set $ghc_practice_best 0}
            {set $ghc_practice_fc FALSE}
         }
         {if {!= {sprint {song_speed} " " {song_speed playing} " " $ghc_practice_best " " $ghc_practice_fc " " $hit " " $all} [stats_shown]}
            {set [stats_shown] {sprint {song_speed} " " {song_speed playing} " " $ghc_practice_best " " $ghc_practice_fc " " $hit " " $all}}
            {ghc_stats_speed_value.lbl set_localized_text {sprint {song_speed} "%"}}
            ; The song's name, its speed after it (content/song_speed.cpp).
            {ghc_song.lbl set_localized_text {game get_song_text}}
            {ghc_stats_best_value.lbl set_localized_text {sprint $ghc_practice_best "%"}}
            {ghc_stats_percent_value.lbl set_localized_text {sprint {ghc_practice_hit_pct} "%"}}
            {ghc_stats_notes_value.lbl set_localized_text {sprint $hit "/" $all}}
            ; The full combo crown: no miss and no stray strum.
            {ghc_crown.mesh set_showing $ghc_practice_fc}
         }
      }
   )
   ; The rows on a group at their top left, each row's name ending at
   ; [stats_mid] and its number after, on a dark box: the section name's
   ; label in a plain font. The scene draws what its own list holds, so the
   ; box and crown go on it, before the labels.
   (make_stats
      {do
         ($names ("STATS" "Speed" "Best Hit" "Hit Percent" "Hit Notes"))
         ($i 0)
         ($dir {$this loaded_dir})
         ; New labels, so the poll fills them whatever it showed last.
         {set [stats_shown] ''}
         {new Group ghc_stats.grp}
         {ghc_stats.grp set_local_pos [stats_x] 0 [stats_z]}
         ; Drawn by order, after the room's walls.
         {ghc_box_make $this ghc_stats ghc_stats.grp 10}
         {ghc_box_color $this ghc_stats 0 0 0 0.8}
         {ghc_box_put $this ghc_stats -24 0 {'*' -2.5 [stats_row]} {'+' [stats_wide] 40} {'*' 5.4 [stats_row]} 8 8}
         {ghc_box_show $this ghc_stats TRUE}
         ; The song lists' crown (ui/song_crown.cpp) by Best Hit, after its
         ; number.
         {new Tex ghc_crown.tex}
         {ghc_crown.tex set_bitmap "ui/image/ghc_crown.png"}
         {new Mat ghc_crown.mat}
         {ghc_crown.mat copy ghc_stats_end.mat 1}
         {ghc_crown.mat set color {pack_color 1 1 1}}
         {ghc_crown.mat set alpha 1}
         {ghc_crown.mat set diffuse_tex ghc_crown.tex}
         {new {{helpbar find help_box_right.mesh} class_name} ghc_crown.mesh}
         {ghc_crown.mesh copy {helpbar find help_box_right.mesh} 1}
         {ghc_crown.mesh set_mat ghc_crown.mat}
         {ghc_crown.mesh set trans_parent ghc_stats.grp}
         {ghc_crown.mesh set_local_rot 0 0 0}
         {ghc_crown.mesh set_local_pos [stats_crown_x] 0 {'*' -2.5 [stats_row]}}
         {ghc_crown.mesh set_local_scale {/ [stats_row] 12.0} 1 {/ [stats_row] 12.0}}
         {ghc_crown.mesh set draw_order 11}
         {ghc_crown.mesh set_showing FALSE}
         {foreach $m (ghc_stats_mid.mesh ghc_stats_left.mesh ghc_stats_right.mesh ghc_crown.mesh)
            {$dir insert (draws {$dir size (draws)}) {$this find $m}}
         }
         {foreach $row (title speed best percent notes)
            {do
               ($z {'*' {'-' -0.5 $i} [stats_row]})
               ($name {$this stats_label {sprint "ghc_stats_" $row ".lbl"}})
               {if_else {== $i 0}
                  {do
                     {$name set alignment 34}
                     {$name set_local_pos {/ [stats_wide] 2} 0 $z}
                  }
                  {do
                     {$name set alignment 36}
                     {$name set_local_pos [stats_mid] 0 $z}
                     {{$this stats_label {sprint "ghc_stats_" $row "_value.lbl"}} set_local_pos {'+' [stats_mid] 4} 0 $z}
                  }
               }
               {$name set_localized_text {elem $names $i}}
               {set $i {'+' $i 1}}
            }
         }
         {{$this loaded_dir} sync_objects}
      }
   )
   (stats_label ($name)
      {do
         ($l {new BandLabel {symbol $name}})
         {$l copy section.lbl 0}
         {$l set_type helveticablack}
         {$l set trans_parent ghc_stats.grp}
         {$l set_local_rot 0 0 0}
         {$l set_local_scale [stats_size] 1 [stats_size]}
         {$l set fit_text 0}
         {$l set wrap_width 4000}
         {$l set alignment 33}
         {$l set draw_order 20}
         {$l set_showing TRUE}
         $l
      }
   )
}
; Practice's speed, a row of its pause menu where Change Speed was, 25% to
; 200% (content/song_speed.h's practice audio), kept for the next practice
; ($ghc_practice_pct, quickplay.dta). Its name lights as any row's; green
; takes it up, its number lit too, as the audio settings' sliders; strum
; steps it 5%, green keeps it and red puts it back. GH2's speed screen
; before the song goes straight on to its loading.
{set $ghc_speed_before FALSE} ; the speed it was taken up at, FALSE when not
{func ghc_practice_speed_label ($panel) {$panel speed_row}}
{func ghc_practice_speed_edit ($panel $on)
   {set $ghc_speed_before {if_else $on {song_speed} FALSE}}
   {$panel speed_row}
}
; $by 5% steps faster, $op set ({song_speed}'s) or, as it plays, live.
{func ghc_practice_speed_by ($by $op)
   {song_speed $op {max 25 {min 200 {'+' {song_speed} {'*' 5 $by}}}}}
   {set $ghc_practice_pct {song_speed}}
   {synth play_sequence button_toggle}
}
; Green on the row: taken up, else kept.
{func ghc_practice_speed_select ($panel)
   {ghc_practice_speed_edit $panel {! $ghc_speed_before}}
}
; A button while it is taken up: TRUE if it was the row's.
{func ghc_practice_speed_button ($panel $button)
   {cond
      ({! $ghc_speed_before} FALSE)
      ({|| {== $button kPad_DUp} {== $button kPad_DDown}}
         {ghc_practice_speed_by {if_else {== $button kPad_DUp} 1 -1} set}
         {ghc_practice_speed_label $panel}
         TRUE
      )
      ({== $button kPad_Tri}
         {song_speed set $ghc_speed_before}
         {set $ghc_practice_pct {song_speed}}
         {synth play_sequence button_back.cue}
         {ghc_practice_speed_edit $panel FALSE}
         TRUE
      )
      ; Green is the row's select, Start keeps it and goes on; the rest do
      ; nothing.
      ({== $button kPad_X} FALSE)
      ({== $button kPad_Start} {ghc_practice_speed_edit $panel FALSE} FALSE)
      (TRUE TRUE)
   }
}
{retype practice_sel_speed_screen
   (
      (panels meta helpbar)
      (enter {ui goto_screen practice_loading_screen})
   )
}
; Practice resumed takes up where it was paused at the speed picked, as the
; arrows change it as it plays (content/song_speed.h).
{func ghc_practice_resume ($screen)
   {if_else $ghc_practice_reload
      ; Its audio made again from its section's start: the part alone or
      ; not (ghc_practice_options_screen).
      {do
         {set $ghc_practice_reload FALSE}
         {set $ghc_practice_kept {gamecfg get (practice_sections 0)}}
         {set $ghc_practice_kept_to {gamecfg get (practice_sections 1)}}
         {ghc_practice_whole}
         {meta_loading_nosave_goto practice_loading_screen}
      }
      {do
         {song_speed live {song_speed}}
         {$screen resume}
      }
   }
}
; From the pause menu, as Select in the song: the section again, nothing
; loaded, unless a setting wants its audio made again.
{func ghc_practice_restart
   {if_else $ghc_practice_reload
      {ghc_practice_resume pract_pause_screen}
      {do
         {set $game_unpause_on_enter TRUE}
         {ghc_practice_again}
      }
   }
}
; Those sections played from Change Section, as the pause menu's Restart:
; the song is loaded whole (ghc_practice_whole).
{func ghc_practice_jump ($from $to)
   {gamecfg set (practice_sections 0) $from}
   {gamecfg set (practice_sections 1) $to}
   {ghc_practice_restart}
}
; Practice's pause menu, as the game's own (pause.dta) but for New Song,
; which is Settings (ghc_practice_settings_screen), and Exit, which is
; Return. A career's has no New Song: its Settings is Change Section's,
; cloned. Each time the scene loads.
{retype pract_pause_panel
   (
      (file ui/pract_pause.milo)
      (enter
         {do
            ($career {practice_sel_section_screen get career_mode})
            {tut_pause_career_buttons.view set_showing $career}
            {tut_pause_buttons.view set_showing {! $career}}
            {$this set_focus
               {if_else [from_sections]
                  {if_else $career section_career.btn section.btn}
                  {if_else $career resume_career.btn resume.btn}}}
            {set [from_sections] FALSE}
         }
         {$this six_rows}
         ; A token with no string reads as itself.
         {newsong.btn set text_token "SETTINGS"}
         {ghc_settings_career.btn set text_token "SETTINGS"}
         {quit.btn set text_token "RETURN"}
         {quit_career.btn set text_token "RETURN"}
         {ghc_practice_speed_label $this}
      )
      (exit {if $ghc_speed_before {ghc_practice_speed_edit $this FALSE}})
      (from_sections FALSE) ; back from Change Section, on its row
      ; The speed row: its name the button's, moved left of the row's
      ; middle, and its number a label right of it, the two centred
      ; together; the number lit only while it is taken up. Made each time
      ; the scene loads. SPEED is 89 wide in the scene's face, a number
      ; about 70.
      (speed_name_dx -43)
      (speed_number_dx 20)
      (speed_row
         {do
            ($dir {$this loaded_dir})
            ($career {practice_sel_section_screen get career_mode})
            ($btn {$this find {if_else $career change_speed_career.btn change_speed.btn}})
            ($x 0) ($y 0) ($z 0)
            {if {! {$dir exists ghc_speed_num.lbl}}
               {foreach $name (change_speed.btn change_speed_career.btn)
                  {if {$dir exists $name}
                     {do
                        ($b {$this find $name})
                        {$b get_local_pos $x $y $z}
                        {$b set_local_pos {'+' $x [speed_name_dx]} $y $z}
                        ; A token with no string reads as itself.
                        {$b set text_token "SPEED"}
                     }
                  }
               }
               {new BandLabel ghc_speed_num.lbl}
               {ghc_speed_num.lbl copy {practice_panel find section.lbl} 0}
               {ghc_speed_num.lbl set_local_rot 0 0 0}
               {ghc_speed_num.lbl set_local_scale 1 1 1}
               {ghc_speed_num.lbl set wrap_width 4000}
            }
            {ghc_speed_num.lbl set_type {$btn get_type}}
            {foreach $prop (text_size kerning deltaZ deltaRot)
               {ghc_speed_num.lbl set $prop {$btn get $prop}}
            }
            {ghc_speed_num.lbl set fit_text 0}
            {ghc_speed_num.lbl set alignment 33}
            ; The rows draw through their parent, over the frame.
            {if {!= {ghc_speed_num.lbl get trans_parent} {$btn get trans_parent}}
               {ghc_speed_num.lbl set trans_parent {$btn get trans_parent}}
               {{$btn get trans_parent} insert (objects {{$btn get trans_parent} size objects}) ghc_speed_num.lbl}
            }
            {$btn get_local_pos $x $y $z}
            {ghc_speed_num.lbl set_local_pos {'+' $x {'-' [speed_number_dx] [speed_name_dx]}} $y $z}
            {ghc_speed_num.lbl set draw_order {$btn get draw_order}}
            {ghc_speed_num.lbl set_showing TRUE}
            ; A label given a colour goes back to its token's text.
            {ghc_speed_num.lbl set color {$dir get {if_else $ghc_speed_before focus_color normal_color}}}
            {ghc_speed_num.lbl set_localized {sprint {song_speed} "%"}}
         }
      )
      ; The career's six rows where the others are.
      (six_rows
         {if {! {{$this loaded_dir} exists ghc_settings_career.btn}}
            {do
               ($rows (resume_career.btn restart_career.btn change_speed_career.btn section_career.btn
                  ghc_settings_career.btn quit_career.btn))
               ($group {section_career.btn get trans_parent})
               ($x 0) ($y 0) ($top 0) ($bottom 0) ($i 0)
               {new {section_career.btn class_name} ghc_settings_career.btn}
               {ghc_settings_career.btn copy section_career.btn 0}
               {ghc_settings_career.btn set trans_parent $group}
               ; The rows draw through their parent, over the frame.
               {$group insert (objects {$group size objects}) ghc_settings_career.btn}
               {resume.btn get_local_pos $x $y $top}
               {quit.btn get_local_pos $x $y $bottom}
               {foreach $btn $rows
                  {$btn set_local_pos $x $y {'+' $top {'*' {'-' $bottom $top} {'/' $i 5}}}}
                  {if {> $i 0} {{elem $rows {'-' $i 1}} set nav_down $btn}}
                  {set $i {'+' $i 1}}
               }
               {{$this loaded_dir} sync_objects}
            }
         }
      )
   )
}
{retype pract_pause_screen
   (
      (panels PRACTICE_PANELS pract_pause_panel)
      (focus pract_pause_panel)
      (clear_vram TRUE)
      (in_game TRUE)
      PAUSE_SCREEN_HANDLERS
      (BUTTON_DOWN_MSG
         {cond
            ({ghc_practice_speed_button pract_pause_panel $button} TRUE)
            ({== $button kPad_Start} {ghc_practice_resume $this} TRUE)
            (TRUE kDataUnhandled)
         }
      )
      (SELECT_START_MSG
         {switch $component
            ((resume.btn resume_career.btn) {ghc_practice_resume $this})
            ((restart.btn restart_career.btn) {ghc_practice_restart})
            ((section.btn section_career.btn) {ui goto_screen ghc_practice_section_screen})
            ((change_speed.btn change_speed_career.btn) {ghc_practice_speed_select pract_pause_panel})
            ((newsong.btn ghc_settings_career.btn) {ui goto_screen ghc_practice_settings_screen})
            ((quit.btn quit_career.btn) {ghc_practice_exit})
         }
      )
   )
}
; Change Section: GH2's section poster (practice.dta's, before the song)
; over practice's panels, the song held paused under it. Green on the
; whole song plays it, green on a section marks where it starts and green
; on one after plays them, all at once (ghc_practice_jump); red takes the
; mark off, then goes back to the pause menu.
{if {! {exists ghc_practice_section_screen}} {new GHScreen ghc_practice_section_screen}}
{retype ghc_practice_section_screen
   (
      (panels PRACTICE_PANELS practice_sel_section_panel helpbar)
      (focus practice_sel_section_panel)
      (in_game TRUE)
      PAUSE_SCREEN_HANDLERS
      (helpbar (default ((fret1 help_continue) (fret2 help_back) (strum help_updown))))
      (BUTTON_DOWN_MSG {if_else {== $button kPad_Start} {do {ghc_practice_resume $this} TRUE} kDataUnhandled})
   )
}
{retype practice_sel_section_panel
   (
      (file ui/practice_sel_section.milo)
      (focus sel_section.lst)
      (section 0) ; 1 once its start is marked
      (start 0)
      (enter
         ; The poster alone, the song behind it, not its brick wall.
         {speed_wall.mesh set_showing FALSE}
         {sel_section.lst set_provider section_provider}
         {$this unmark}
      )
      (unmark
         {set [section] 0}
         {section_provider set_start_section -1}
         {title.lbl set_text select_start_section}
      )
      (SELECT_START_MSG
         {do
            ($idx {- {sel_section.lst selected_pos} 1})
            {cond
               ({&& {! [section]} {== $idx -1}} {ghc_practice_jump -1 -1} kDataUnhandled)
               ({! [section]}
                  {set [start] $idx}
                  {set [section] 1}
                  {section_provider set_start_section $idx}
                  {title.lbl set_text select_end_section}
                  kDataUnhandled
               )
               ({< $idx [start]} {handle (ui BAD_SELECT_START_MSG)})
               (TRUE {ghc_practice_jump [start] $idx} kDataUnhandled)
            }
         }
      )
      (BUTTON_DOWN_MSG
         {if_else {&& {== $button kPad_Tri} {! {ui in_transition}}}
            {do
               {synth play_sequence button_back.cue}
               {if_else [section]
                  {$this unmark}
                  {do {pract_pause_panel set from_sections TRUE} {ui goto_screen pract_pause_screen}}
               }
               TRUE
            }
            kDataUnhandled
         }
      )
   )
}
; Practice's own settings, the fifth row of its pause menu's Settings: the
; metronome, the note click, and the part alone on its own stem or the
; whole song ({practice_option}, content/practice_sounds.h). Each a row and
; box of GH2's video settings' scene, its lefty and widescreen rows', in
; their order, its progressive scan row put away. The part alone takes the
; song up again from the section's start as it resumes. Whether a slowed
; song keeps its pitch is settings.ini's maintain_pitch, an audio setting.
{if {! {exists ghc_practice_options_screen}}
   {new GHPanel ghc_practice_options_panel}
   {new GHScreen ghc_practice_options_screen}
}
{set $ghc_practice_reload FALSE}
{retype ghc_practice_options_panel
   (
      (file ui/pause_video_settings.milo)
      (focus gs_left_p1.btn)
      (reset_focus TRUE)
      (rows
         (
            (gs_left_p1.btn lefty1.chk metronome "METRONOME")
            (gs_left_p2.btn lefty2.chk note_click "NOTE CLICK")
            (widescreen.btn widescreen.chk solo_stems "SOLO STEMS")
         )
      )
      (enter
         {foreach $off (calibrate_lag.btn p_scan.btn p_scan.chk)
            {{$this find $off} set_showing FALSE}
         }
         {foreach $off (calibrate_lag.btn p_scan.btn)
            {{$this find $off} set_state kDisabled}
            {{$this find $off} set nav_down {$this find $off}}
         }
         {gs_title.lbl set_localized "PRACTICE"}
         {do
            ($i 0)
            {foreach $row [rows]
               ; A token with no string reads as itself.
               {{$this find {elem $row 0}} set text_token {elem $row 3}}
               {{$this find {elem $row 0}} set nav_down
                  {$this find {elem {elem [rows] {mod {'+' $i 1} {size [rows]}}} 0}}}
               {set $i {'+' $i 1}}
            }
         }
         ; The part alone only where it has a stem of its own: else its
         ; row is off, its box in the scene's colour for that, unchecked,
         ; and passed by. Up finds the row whose down leads here, so its
         ; own leads to itself.
         {set [stems] {ghc_practice_stems soloable}}
         {if_else [stems]
            {do
               {if {== {widescreen.btn get_state} kDisabled} {widescreen.btn set_state kNormal}}
               {slider_scales on widescreen.chk}
            }
            {do
               {widescreen.btn set_state kDisabled}
               {slider_scales off widescreen.chk {{$this loaded_dir} get disabled_color}}
               {gs_left_p2.btn set nav_down gs_left_p1.btn}
               {widescreen.btn set nav_down widescreen.btn}
            }
         }
         {$this sync}
      )
      (stems TRUE)
      (sync
         {foreach $row [rows]
            {{$this find {elem $row 1}} set_check
               {if_else {&& {== {elem $row 2} solo_stems} {! [stems]}} FALSE {practice_option {elem $row 2}}}}
         }
      )
      (SELECT_START_MSG
         {switch $component
            (gs_left_p1.btn {$this toggle metronome})
            (gs_left_p2.btn {$this toggle note_click})
            (widescreen.btn {if [stems] {$this toggle solo_stems}})
         }
      )
      (toggle ($option)
         {practice_option $option {! {practice_option $option}}}
         {if {== $option solo_stems} {set $ghc_practice_reload TRUE}}
         {synth play_sequence button_toggle}
         {$this sync}
      )
   )
}
{retype ghc_practice_options_screen
   (
      (panels PRACTICE_PANELS ghc_practice_options_panel helpbar)
      (focus ghc_practice_options_panel)
      (in_game TRUE)
      PAUSE_SCREEN_HANDLERS
      (helpbar (default ((fret1 help_onoff) (fret2 help_back) (strum help_updown))))
      (BUTTON_DOWN_MSG
         {cond
            ({== $button kPad_Start} {ghc_practice_resume $this} TRUE)
            ({== $button kPad_Tri}
               {synth play_sequence button_back.cue}
               {ui goto_screen ghc_practice_settings_screen}
               TRUE
            )
            (TRUE kDataUnhandled)
         }
      )
   )
}
{if {! {exists pause_settings_screen}}
   {new GHPanel pause_settings_panel}
   {new GHScreen pause_settings_screen}
}
{retype pause_settings_panel
   (
      (file ui/pause.milo)
      (focus resume.btn)
      (reset_focus TRUE)
      ; In practice a fifth row, the scene's own, is Practice's page
      ; (ghc_practice_options_screen).
      (enter
         {if_else {== {gamecfg get mode} practice}
            {do
               {if {! {video_options.btn showing}} {$this gh1_five_rows}}
               {video_options.btn set text_token "PRACTICE"}
            }
            {$this four_rows}
         }
         ; Up goes to the row whose down leads here: Video Settings' put
         ; away points at itself, or up from Controllers would find it.
         {if {&& {exists video_options.btn} {! {video_options.btn showing}}}
            {video_options.btn set nav_down video_options.btn}
         }
         {pause_title.lbl set_localized "SETTINGS"}
         {resume.btn set text_token "AUDIO"}
         {restart.btn set text_token "VIDEO"}
         {audio_options.btn set text_token "GAME"}
         {quit.btn set text_token "CONTROLLERS"}
         ; Not drawn in to QUIT's width: its own, as the other rows.
         {quit.btn set fit_text 0}
      )
      PAUSE_FOUR_ROWS
      ; GH1's scene has four rows, its fifth put away: in practice that one
      ; back as Quit's twin, for Practice's page, the five laid as the pause
      ; menu lays GH1's five (pause_panel's rows_at, gh1_5).
      (gh1_five_rows
         {do
            ($rows (resume.btn restart.btn audio_options.btn video_options.btn quit.btn))
            ($x 0) ($y 0) ($z 0) ($row 0) ($i 0)
            {video_options.btn copy quit.btn 0}
            {video_options.btn set trans_parent {quit.btn get trans_parent}}
            {video_options.btn set_showing TRUE}
            {video_options.btn set_state kNormal}
            {resume.btn get_local_pos $x $y $z}
            {restart.btn get_local_pos $x $y $row}
            {set $row {'-' $row $z}}
            {foreach $btn $rows
               {$btn set_local_pos $x $y {'+' {'-' $z {'*' 0.2 $row}} {'*' {'*' 0.9 $row} $i}}}
               {if {> $i 0} {{elem $rows {'-' $i 1}} set nav_down $btn}}
               {set $i {'+' $i 1}}
            }
         }
      )
   )
}
; A song's settings screens from its pause menu, and in practice their twins:
; the same, over practice's panels (PRACTICE_PANELS, no venue) rather than a
; song's. Each goes to the others through this, which gives the twin in
; practice.
{set $ghc_practice_twins
   (
      (pause_screen pract_pause_screen)
      (pause_settings_screen ghc_practice_settings_screen)
      (pause_audio_settings_screen ghc_practice_audio_screen)
      (pause_video_settings_screen ghc_practice_video_screen)
      (pause_game_settings_screen ghc_practice_game_screen)
      (ghc_pause_controllers_screen ghc_practice_controllers_screen)
      (pause_lag_screen ghc_practice_lag_screen)
   )
}
{func ghc_pause_screen ($screen)
   {if_else {== {gamecfg get mode} practice} {elem {find $ghc_practice_twins $screen} 1} $screen}
}
{foreach $twin $ghc_practice_twins
   {if {! {exists {elem $twin 1}}} {new GHScreen {elem $twin 1}}}
}
; Start resumes the song, practice's as its pause menu does.
{func ghc_pause_resume ($screen)
   {if_else {== {gamecfg get mode} practice} {ghc_practice_resume $screen} {$screen resume}}
}
#define PAUSE_SETTINGS_SCREEN (
   (focus pause_settings_panel)
   (in_game TRUE)
   PAUSE_SCREEN_HANDLERS
   (helpbar (default ((fret1 help_select) (fret2 help_back) (strum help_updown))))
   (SELECT_START_MSG
      {switch $component
         (resume.btn {ui goto_screen {ghc_pause_screen pause_audio_settings_screen}})
         (restart.btn {ui goto_screen {ghc_pause_screen pause_video_settings_screen}})
         (audio_options.btn {ui goto_screen {ghc_pause_screen pause_game_settings_screen}})
         (video_options.btn {ui goto_screen ghc_practice_options_screen})
         (quit.btn {ui goto_screen {ghc_pause_screen ghc_pause_controllers_screen}})
      }
   )
   (BUTTON_DOWN_MSG
      {if {== $button kPad_Start} {ghc_pause_resume $this}}
      {if {== $button kPad_Tri}
         {synth play_sequence button_back.cue}
         {ui goto_screen {ghc_pause_screen pause_screen}}
      }
      kDataUnhandled
   )
)
{retype pause_settings_screen ((panels GAME_PANELS pause_settings_panel helpbar) PAUSE_SETTINGS_SCREEN)}
{retype ghc_practice_settings_screen ((panels PRACTICE_PANELS pause_settings_panel helpbar) PAUSE_SETTINGS_SCREEN)}
; The game's own two settings screens there (options.dta), each leading back
; to that menu where it led to the pause menu.
#define PAUSE_AUDIO_SCREEN (
   (focus pause_audio_settings_panel)
   (in_game TRUE)
   (allow_back FALSE)
   (animate_transition FALSE)
   ; Under Settings each is named for what it holds.
   (enter {{pause_audio_settings_panel find gs_title.lbl} set_localized "AUDIO"})
   (BUTTON_DOWN_MSG
      {if {&& {! {pause_audio_settings_panel slider_selected}} {== $button kPad_Tri}}
         {$this set_volumes}
         {synth play_sequence button_back.cue}
         {ui goto_screen {ghc_pause_screen pause_settings_screen}}
      }
      kDataUnhandled
   )
)
{retype pause_audio_settings_screen ((panels GAME_PANELS pause_audio_settings_panel helpbar) PAUSE_AUDIO_SCREEN)}
{retype ghc_practice_audio_screen ((panels PRACTICE_PANELS pause_audio_settings_panel helpbar) PAUSE_AUDIO_SCREEN)}
#define PAUSE_VIDEO_SCREEN (
   (focus pause_video_settings_panel)
   (in_game TRUE)
   (allow_back FALSE)
   (animate_transition FALSE)
   (BUTTON_DOWN_MSG
      {if {&& {== $button kPad_Tri} {== {pause_video_settings_panel get picking} none}}
         {synth play_sequence button_back.cue}
         {ui goto_screen {ghc_pause_screen pause_settings_screen}}
      }
      kDataUnhandled
   )
)
{retype pause_video_settings_screen ((panels GAME_PANELS pause_video_settings_panel helpbar) PAUSE_VIDEO_SCREEN)}
{retype ghc_practice_video_screen
   (
      (panels PRACTICE_PANELS pause_video_settings_panel helpbar)
      PAUSE_VIDEO_SCREEN
   )
}
{retype video_settings_screen
   (
      (panels meta video_settings_panel helpbar)
      (focus video_settings_panel)
      (allow_back FALSE)
      ; Red on a picked row is the row's (VIDEO_ROW_HANDLERS).
      (BUTTON_DOWN_MSG
         {if {&& {== $button kPad_Tri} {== {video_settings_panel get picking} none}}
            {$this backwards_anim}
            {synth play_sequence button_back.cue}
            {autosave_goto options_screen}
         }
         kDataUnhandled
      )
   )
}

; Video Settings keeps its widescreen row, in its top row's place. Playing
; left handed and the lag screen are Game Settings' now, and progressive scan
; is gone: it changes nothing a window shows. Under it are the port's own
; rows ({video ...}, settings/video_options.cpp), each the widescreen row's
; button and box again a row further down.
#define VIDEO_ROW_HANDLERS (
   (focus widescreen.btn)
   ; The pause menu loads the scene again each time, and a row made here is
   ; not yet there to take the focus it was left with.
   (reset_focus TRUE)
   (at "widescreen.btn")
   ; A row's button, its box or none, its setting, and its value's text or
   ; none: a row has a box or a value. The longest first, where the poster's
   ; art leaves most room.
   (rows
      (
         (vs_vfont.btn vs_vfont.chk vector_fonts none)
         (vs_light.btn none lighting vs_light.val)
         (vs_detail.btn none high_detail vs_detail.val)
         (vs_msaa.btn none msaa vs_msaa.val)
         (vs_scale.btn none render_scale vs_scale.val)
         (vs_taa.btn vs_taa.chk temporal_aa none)
         (vs_perf.btn none perf_overlay vs_perf.val)
      )
   )
   ; From one row to the next, as the scene's own first two stand, and how
   ; much of that seven rows keep.
   (gap 0)
   (tight 0.86)
   (drawn_in 0.47)
   ; The values stand in a column this many rows' distance right of the
   ; names.
   (column 3.5)
   ; A scene whose rows were centred (GH1's in a song) has its box this much
   ; further along, measured from a text's middle.
   (centred FALSE)
   (centred_box_dx -60)
   (lay_out
      {if {! {exists vs_msaa.btn}}
         {do
            ($x 0) ($y 0) ($z 0) ($cx 0) ($cy 0) ($cz 0) ($i 1) ($col 0) ($bx 0) ($half 0)
            {widescreen.btn get_local_pos $x $y $z}
            {widescreen.chk get_local_pos $cx $cy $cz}
            ; The names start about where the scene's box did, clear of the
            ; poster's art, and the boxes stand in the values' column, each
            ; by its left edge: a box is placed by its middle, about this far
            ; from its edge.
            {set $half {'*' 0.65 {'-' $x $cx}}}
            {set $x {'+' $cx {'*' 0.25 $half}}}
            {widescreen.btn set_local_pos $x $y $z}
            ; To the names' side of the box, by the rows' own measure.
            {set $col {'*' [column] {if_else {< [gap] 0} {'-' 0 [gap]} [gap]}}}
            {set $col {'+' $x {if_else {< $half 0} {'-' 0 $col} $col}}}
            {set $bx {'+' {'+' $col $half} {if_else [centred] [centred_box_dx] 0}}}
            {widescreen.chk set_local_pos $bx $cy $cz}
            {foreach $row [rows]
               {new {widescreen.btn class_name} {elem $row 0}}
               {{$this find {elem $row 0}} copy widescreen.btn 0}
               {{$this find {elem $row 0}} set trans_parent {widescreen.btn get trans_parent}}
               {{$this find {elem $row 0}} set_local_pos $x $y {'+' $z {'*' $i {'*' [tight] [gap]}}}}
               ; The widescreen row's text is drawn in to its width; a short
               ; name would stand larger, so each is that much smaller
               ; whatever its length.
               {{$this find {elem $row 0}} set fit_text 0}
               {{$this find {elem $row 0}} set text_size {'*' [drawn_in] {widescreen.btn get text_size}}}
               {{$this find {elem $row 0}} set_showing TRUE}
               {{$this find {elem $row 0}} set_state kNormal}
               {{$this find {elem $row 0}} set draw_order 1}
               {if {!= {elem $row 1} none}
                  {new {widescreen.chk class_name} {elem $row 1}}
                  {{$this find {elem $row 1}} copy widescreen.chk 0}
                  {{$this find {elem $row 1}} set trans_parent {widescreen.chk get trans_parent}}
                  {{$this find {elem $row 1}} set_local_pos $bx $cy {'+' $cz {'*' $i {'*' [tight] [gap]}}}}
                  {{$this find {elem $row 1}} set_showing TRUE}
                  {{$this find {elem $row 1}} set draw_order 1}
               }
               ; The value is the button again, with no way to it.
               {if {!= {elem $row 3} none}
                  {new {widescreen.btn class_name} {elem $row 3}}
                  {{$this find {elem $row 3}} copy {$this find {elem $row 0}} 0}
                  {{$this find {elem $row 3}} set trans_parent {widescreen.btn get trans_parent}}
                  {{$this find {elem $row 3}} set_local_pos $col $y {'+' $z {'*' $i {'*' [tight] [gap]}}}}
                  {{$this find {elem $row 3}} set_showing TRUE}
                  {{$this find {elem $row 3}} set draw_order 1}
                  ; Up goes to what leads down to the focus: its row's own
                  ; link, copied, would lead there from here.
                  {{$this find {elem $row 3}} set nav_down {$this find {elem $row 3}}}
               }
               {set $i {'+' $i 1}}
            }
            ; And the widescreen row's own, its name now shorter than its width.
            {widescreen.btn set text_size {'*' [drawn_in] {widescreen.btn get text_size}}}
            {widescreen.btn set fit_text 0}
            {widescreen.btn set nav_down vs_vfont.btn}
            {vs_vfont.btn set nav_down vs_light.btn}
            {vs_light.btn set nav_down vs_detail.btn}
            {vs_detail.btn set nav_down vs_msaa.btn}
            {vs_msaa.btn set nav_down vs_scale.btn}
            {vs_scale.btn set nav_down vs_taa.btn}
            {vs_taa.btn set nav_down vs_perf.btn}
            {vs_perf.btn set nav_down widescreen.btn}
            {{$this loaded_dir} sync_objects}
         }
      }
   )
   ; Each row as its setting is, and the help bar for the one lit. A token
   ; with no string reads as itself.
   (sync_rows
      {widescreen.chk set_check {options get_widescreen}}
      {widescreen.btn set text_token {symbol "WIDESCREEN"}}
      ; Not before lay_out has made them: the focus is given first.
      {foreach $row {if_else {exists vs_msaa.btn} [rows] ()}
         {if {!= {elem $row 1} none}
            {{$this find {elem $row 1}} set_check {video {elem $row 2}}}
         }
         {{$this find {elem $row 0}} set text_token
            {symbol
               {switch {elem $row 2}
                  (msaa "MSAA")
                  (render_scale "SCALE")
                  (temporal_aa "TAA")
                  (vector_fonts "HD FONTS")
                  (perf_overlay "PERF")
                  (high_detail "LOD")
                  (lighting "LIGHTING")
               }
            }
         }
         ; Marked and lit while it is picked, and not while its row is only
         ; the one the strum is on.
         {if {!= {elem $row 3} none}
            {{$this find {elem $row 3}} set text_token
               {symbol
                  {sprintf {if_else {== [picking] {elem $row 2}} "< %s >" "%s"}
                     {switch {elem $row 2}
                        (msaa {if_else {== {video msaa} 1} "OFF" {sprintf "%dX" {video msaa}}})
                        (render_scale {sprintf "%d%%" {video render_scale}})
                        (perf_overlay {elem ("OFF" "FPS" "GRAPH" "FULL") {video perf_overlay}})
                        (high_detail {if_else {video high_detail} "FORCE HIGH" "AUTO"})
                        (lighting {if_else {video lighting} "NEXT GEN" "LAST GEN"})
                     }
                  }
               }
            }
            {{$this find {elem $row 3}} set_state
               {if_else {== [picking] {elem $row 2}} kFocused kNormal}}
         }
      }
      {helpbar set_display
         {cond
            ({!= [picking] none} ((fret1 help_confirm) (fret2 help_cancel) (strum help_updown)))
            ({$this lists [at]} ((fret1 help_select) (fret2 help_back) (strum help_updown)))
            (TRUE ((fret1 help_onoff) (fret2 help_back) (strum help_updown)))
         }
      }
   )
   ; A row with a list of values for a box: green picks it, the strum goes
   ; through its values, each kept as it shows, and green keeps the one it is
   ; left on where red puts back what it was picked at.
   (picking none)
   (picked_at 0)
   (lists ($button)
      {|| {== $button "vs_msaa.btn"} {== $button "vs_scale.btn"} {== $button "vs_detail.btn"}
         {== $button "vs_light.btn"} {== $button "vs_perf.btn"}}
   )
   (FOCUS_MSG
      {set [at] {$new_focus name}}
      {$this sync_rows}
   )
   (enter
      ; The top row's gap to the row under it, which neither leaves: shown
      ; or not, as GH1's frame in a song has them, from GH2's scene.
      {if {{$this loaded_dir} exists gs_left_p2.btn}
         {do
            ($x 0) ($y 0) ($top 0) ($under 0)
            {gs_left_p1.btn get_local_pos $x $y $top}
            {gs_left_p2.btn get_local_pos $x $y $under}
            {set [gap] {'-' $under $top}}
         }
      }
      ; Into the top row's place, the box by as much: again on each entry
      ; changes nothing. GH1's frame in a song has the row from GH2's scene,
      ; and its own rows' text is centred, where these are drawn from the
      ; left as a column.
      {if {== {widescreen.btn get alignment} 34}
         {set [centred] TRUE}
         {widescreen.btn set alignment 33}
      }
      {if {{$this loaded_dir} exists gs_left_p1.btn}
         {do
            ($x 0) ($y 0) ($z 0) ($top 0) ($from 0)
            {gs_left_p1.btn get_local_pos $x $y $top}
            {widescreen.btn get_local_pos $x $y $from}
            {widescreen.btn set_local_pos $x $y $top}
            {widescreen.chk get_local_pos $x $y $z}
            {widescreen.chk set_local_pos $x $y {'+' $z {'-' $top $from}}}
         }
      }
      ; Each leads to itself: up is to whatever leads down to the focus, the
      ; first the scene lists, so one left leading to the top row stops up
      ; from there.
      {foreach $o (gs_left_p1.btn gs_left_p2.btn p_scan.btn calibrate_lag.btn)
         {{$this find $o} set_showing FALSE}
         {{$this find $o} set_state kDisabled}
         {{$this find $o} set nav_down {$this find $o}}
      }
      {foreach $o (lefty1.chk lefty2.chk p_scan.chk)
         {{$this find $o} set_showing FALSE}
      }
      ; GH1's frame is its audio settings', whose own rows go.
      {foreach $o (gs_band.sld gs_guitar.sld gs_sfx.sld gs_stereo.btn stereo.chk)
         {if {exists $o}
            {{$this find $o} set_showing FALSE}
            {{$this find $o} set_state kDisabled}
            {{$this find $o} set nav_down {$this find $o}}
         }
      }
      {if {== {$this name} pause_video_settings_panel} {gs_title.lbl set_localized "VIDEO"}}
      {$this lay_out}
      {set [at] "widescreen.btn"}
      {set [picking] none}
      {$this sync_rows}
   )
   (SELECT_START_MSG
      {switch $component
         (widescreen.btn {widescreen.chk toggle} {options set_widescreen {widescreen.chk get_check}})
         (vs_msaa.btn {$this pick msaa})
         (vs_scale.btn {$this pick render_scale})
         (vs_taa.btn {video temporal_aa next})
         (vs_vfont.btn {video vector_fonts next})
         (vs_perf.btn {$this pick perf_overlay})
         (vs_detail.btn {$this pick high_detail})
         (vs_light.btn {$this pick lighting})
      }
      {$this sync_rows}
      kDataUnhandled
   )
   (pick ($key)
      {if_else {== [picking] none}
         {do
            {set [picking] $key}
            {set [picked_at] {video $key}}
         }
         {set [picking] none}
      }
   )
   ; While a row is picked the strum is its values' and red is its way out:
   ; neither is the menu's.
   (BUTTON_DOWN_MSG
      {if_else {== [picking] none}
         kDataUnhandled
         {cond
            ({== $button kPad_DDown}
               {video [picking] next}
               {synth play_sequence button_toggle}
               {$this sync_rows}
            )
            ({== $button kPad_DUp}
               {video [picking] prev}
               {synth play_sequence button_toggle}
               {$this sync_rows}
            )
            ({== $button kPad_Tri}
               {synth play_sequence button_back.cue}
               {video [picking] set [picked_at]}
               {set [picking] none}
               {$this sync_rows}
            )
            (TRUE kDataUnhandled)
         }
      }
   )
)
{retype video_settings_panel ((file ui/video_settings.milo) VIDEO_ROW_HANDLERS)}
{retype pause_video_settings_panel ((file ui/pause_video_settings.milo) VIDEO_ROW_HANDLERS)}

; The screen is Audio Settings' scene (game_settings.milo, and the pause
; menu's pause_audio_settings.milo) under another name, its rows put to
; other use. Its first two sliders are the note speeds, easy and medium's
; and hard and expert's, a step for each of {note_speed}'s stops, their
; scales drawn without the volume's 0 and 11 ({slider_scales plain}); its
; third slider and the stereo
; row are put away.
;
; Past each track's end, where the volume's 11 stood, is the number: a label,
; which takes a font and a colour of its own where a button takes its
; scene's, and it takes the colour its track is drawn in, whatever the scene
; and the state ({slider_scales colour}).
;
; A change is kept as it is made; red on a picked slider puts back what it
; was picked at, and yellow puts the focused one back to retail's.
#define GAME_SETTINGS_HANDLERS (
   (focus gs_band.sld)
   (reset_focus TRUE)
   (picked_at 0)
   (at "gs_band.sld")
   ; The rows under the sliders: a row's button, how many rows down it is,
   ; its text, and its label.
   (rows
      (
         (gm_lefty.btn 3 "LEFTY FLIP" gm_lefty.lbl)
         (gm_p1.btn 3 "P1" gm_p1.lbl)
         (gm_p2.btn 3 "P2" gm_p2.lbl)
         (gm_lag.btn 4 "CALIBRATE LAG" gm_lag.lbl)
         (gm_engine.btn 5 "ENGINE GH2" gm_engine.lbl)
         (gm_unlock.btn 6 "UNLOCK ALL OFF" gm_unlock.lbl)
      )
   )
   ; What a row does when it is lit. A button's text swells and its letters
   ; shake, as every menu row of the game's does: P1, P2 and CALIBRATE LAG.
   ; A slider's name only changes colour: E/M SPEED, H/X SPEED, NOTE SPEED,
   ; HWY LENGTH, and the volumes on Audio Settings. A row named here is
   ; drawn by its label, which holds still as a slider's name does; take a
   ; name out, or put one of [rows] in, to change which it is.
   (steady (gm_lefty.btn))
   ; The rows as lay_out leaves them: the first's height, the gap to the
   ; next, and how high their parent stands.
   (row_top 0)
   (row_gap 0)
   (view_z 0)
   ; A slider being tuned in a song: whether one is, where the rows' parent
   ; stood, and how far right of that it is put.
   (tuning 0)
   (tune_x 0)
   (tune_dx 250)
   ; The black behind it, a round-ended box (box.dta): from the slider,
   ; right and up, and its size, in the box's middle's own, 16 by 40.
   (tune_bg (-152 -5 22.2 1.4))
   ; How wide a round end is: as wide as the box is tall.
   (tune_bg_end 56)
   ; How much of the venue it hides: 1 is all of it.
   (tune_bg_alpha 0.85)
   (finish_load
      {gs_band.sld set_num_steps {note_speed stops}}
      {gs_guitar.sld set_num_steps {note_speed stops}}
      {gs_sfx.sld set_num_steps 31}
   )
   (enter
      ; In a song it is under Settings, and named for what it holds.
      {gs_title.lbl set_localized {if_else {== {$this name} pause_game_settings_panel} "GAME" "GAME SETTINGS"}}
      {stereo.chk set_showing FALSE}
      ; The stereo row is put away, and the two more GH1's scene has for
      ; playing left handed. Each leads to itself: up is to whatever leads
      ; down to the focus, the first the scene lists, and from a row that
      ; is off to what leads to that, so one left leading to the top row
      ; stops up from there short of the bottom.
      {foreach $o (gs_stereo.btn gs_left_p1.btn gs_left_p2.btn)
         {if {exists $o}
            {{$this find $o} set_showing FALSE}
            {{$this find $o} set_state kDisabled}
            {{$this find $o} set nav_down {$this find $o}}
         }
      }
      {$this lay_out}
      ; Back from the lag screen in a song, which puts these away
      ; (options.dta's pause_lag_screen).
      {if {== {$this name} pause_game_settings_panel}
         {hud set_showing TRUE}
         {track_panel set_showing TRUE}
         {world_panel set_showing TRUE}
      }
      {gm_p1.chk set_check {options get_lefty 0}}
      {gm_p2.chk set_check {options get_lefty 1}}
      {gm_p2.btn set_state {if_else {$this two_players} kNormal kDisabled}}
      ; A box has no look for being off: in the colour the scene has for it.
      {if_else {$this two_players}
         {slider_scales on gm_p2.chk}
         {slider_scales off gm_p2.chk {{$this loaded_dir} get disabled_color}}
      }
      ; Down the rows and round: GH1's scene links none of its own.
      {gs_band.sld set nav_down gs_guitar.sld}
      {gs_guitar.sld set nav_down gs_sfx.sld}
      {gs_sfx.sld set nav_down gm_p1.btn}
      {if_else {$this two_players}
         {gm_p1.btn set nav_down gm_p2.btn}
         {gm_p1.btn set nav_down gm_lag.btn}
      }
      ; P2 off leads to itself, so up from the lag row finds P1.
      {gm_p2.btn set nav_down {if_else {$this two_players} gm_lag.btn gm_p2.btn}}
      ; Unlock all is out of a song, where the lists it opens are: in one it
      ; is put away (sync_rows) and leads to itself.
      {do
         ($last {if_else {$this in_song} gs_band.sld gm_unlock.btn})
         {gm_unlock.btn set_state {if_else {$this in_song} kDisabled kNormal}}
         {gm_unlock.btn set nav_down {if_else {$this in_song} gm_unlock.btn gs_band.sld}}
         ; The note engine's row is off in a career, whose engine is picked
         ; with it, and with no other to pick (GH1's needs its disc), and
         ; leads to itself, so down from the lag row is past it.
         {if_else {|| {note_engine locked} {< {note_engine choices} 2}}
            {do
               {gm_engine.btn set_state kDisabled}
               {gm_engine.btn set nav_down gm_engine.btn}
               {gm_lag.btn set nav_down $last}
            }
            {do
               {gm_engine.btn set_state kNormal}
               {gm_lag.btn set nav_down gm_engine.btn}
               {gm_engine.btn set nav_down $last}
            }
         }
      }
      {foreach $row
         (
            (gs_band.sld gs_easy.lbl "E/M SPEED" gs_easy.grp)
            (gs_guitar.sld gs_hard.lbl "H/X SPEED" gs_hard.grp)
            (gs_sfx.sld gs_length.lbl "HWY LENGTH" gs_length.grp)
         )
         {do
            ($slider {elem $row 0})
            ($x 0) ($y 0) ($z 0) ($bx 0) ($by 0) ($bz 0) ($first 0) ($second 0)
            {slider_scales plain $slider}
            ; A slider's label is a token; one with no string reads as itself.
            {$slider set text_token {symbol {elem $row 2}}}
            ; Once for each time the scene loads.
            {if {! {exists {elem $row 1}}}
               {do
                  {gs_band.sld get_local_pos $x $y $first}
                  {gs_guitar.sld get_local_pos $x $y $second}
                  {$slider get_local_pos $x $y $z}
                  {gs_stereo.btn get_local_pos $bx $by $bz}
                  ; The number rides on its slider, so it is where the track
                  ; ends in any scene, at the stereo row's depth.
                  {new BandLabel {elem $row 1}}
                  {{elem $row 1} copy gs_title.lbl 0}
                  {{elem $row 1} set_type impactor}
                  ; In a group that sizes it: the scale's own digits were
                  ; drawn small, tall and thin.
                  {new Group {elem $row 3}}
                  {{elem $row 3} set trans_parent $slider}
                  {{elem $row 3} set_local_scale [value_squish] 1 [value_shrink]}
                  {{elem $row 1} set trans_parent {elem $row 3}}
                  {{elem $row 1} set_local_pos 0 0 0}
                  ; Not the title's own turn and size, which differ by scene.
                  {{elem $row 1} set_local_rot 0 0 0}
                  {{elem $row 1} set_local_scale 1 1 1}
                  {{elem $row 3} set_local_pos [value_dx] {'-' $by $y} [value_dz]}
                  {{elem $row 1} set fit_text 0}
                  {{elem $row 1} set text_size [value_size]}
                  {{elem $row 1} set alignment 65} ; left, the title's height
                  ; Each digit a little off its line, as the letters of
                  ; the game's buttons are (the options rows by 1 and 2).
                  {{elem $row 1} set deltaZ [value_dip]}
                  {{elem $row 1} set deltaRot [value_tilt]}
                  ; No group lists the number, so the scene's dir draws it,
                  ; in the order of its draws: after the rest, which are at
                  ; 0 and in no order among themselves.
                  {{$this find {elem $row 1}} set draw_order 1}
                  ; Along, to make room for a label longer than the volumes'
                  ; and the number: by GH1's scene's own where it is that
                  ; one, which has those rows.
                  {$slider set_local_pos {'+' $x {if_else {exists gs_left_p1.btn} [shift_gh1] [shift]}} $y $z}
                  {{$this loaded_dir} sync_objects}
               }
            }
         }
      }
      {gs_band.sld set_current {note_speed stop easy}}
      {gs_guitar.sld set_current {note_speed stop hard}}
      {gs_sfx.sld set_current {$this length_stop}}
      {set [at] "gs_band.sld"}
      ; With one speed to set, the other's row goes: the one left is named
      ; for what it is and stands in the second row, and every row a row
      ; higher, so it is the first.
      {do
         ($one {$this one_speed})
         ($x 0) ($y 0) ($z 0)
         ($view {gs_band.sld get trans_parent})
         {set [tuning] 0}
         ; First, as the focus leaving a row puts it back on.
         {if {== $one hard}
            {$this set_focus gs_guitar.sld}
            {set [at] "gs_guitar.sld"}
         }
         {foreach $row ((gs_band.sld gs_easy.lbl easy) (gs_guitar.sld gs_hard.lbl hard))
            {do
               ($off {&& {!= $one none} {!= $one {elem $row 2}}})
               ; Back on only from off: the row the focus is on is left lit.
               {if {!= $off {! {{elem $row 0} showing}}}
                  {{elem $row 0} set_state {if_else $off kDisabled kNormal}}
               }
               {{elem $row 0} set_showing {! $off}}
               {{elem $row 1} set_showing {! $off}}
               {if {== $one {elem $row 2}} {{elem $row 0} set text_token {symbol "NOTE SPEED"}}}
               {{elem $row 0} get_local_pos $x $y $z}
               {{elem $row 0} set_local_pos $x $y
                  {if_else {|| {!= $one none} {== {elem $row 2} hard}} {'+' [row_top] [row_gap]} [row_top]}
               }
            }
         }
         {$view get_local_pos $x $y $z}
         {$view set_local_pos $x $y
            {if_else {== $one none} [view_z] {'-' [view_z] {'*' {elem {$this look block} 0} [row_gap]}}}
         }
      }
      {$this sync_look}
   )
   ; The rows under the sliders, once for each time the scene loads: left
   ; handed play, a box for each player on one row, and the lag screen's.
   ; Each is the stereo row's button or box again, under the sliders' own
   ; parent, so it stands by them the same in any scene: a row is the
   ; sliders' own gap, by [pitch]. The parent takes [block], the size of all
   ; of it.
   (lay_out
      {if {! {exists gm_lag.btn}}
         {do
            ($x 0) ($y 0) ($z 0) ($sx 0) ($top 0) ($gap 0) ($i 0)
            ($view {gs_band.sld get trans_parent})
            {gs_band.sld get_local_pos $sx $y $top}
            {gs_guitar.sld get_local_pos $x $y $z}
            {set $gap {'*' [pitch] {'-' $z $top}}}
            {gs_guitar.sld set_local_pos $x $y {'+' $top $gap}}
            ; The third under the two, where some scenes have it to one side.
            {gs_sfx.sld set_local_pos $sx $y {'+' $top {'*' 2 $gap}}}
            ; A button: its row, where its text starts from the sliders, its
            ; text. The last two are centred on that.
            {foreach $row [rows]
               {do
                  ($b {elem $row 0})
                  ($l {elem $row 3})
                  {new {gs_stereo.btn class_name} $b}
                  {{$this find $b} copy gs_stereo.btn 0}
                  {{$this find $b} set trans_parent $view}
                  ; A token with no string reads as itself.
                  {{$this find $b} set text_token {symbol {elem $row 2}}}
                  ; Its own size, or where the look gives it a width, drawn
                  ; in to that: GH1's faces are wide, and its own rows are
                  ; drawn in so.
                  {if_else {> {elem {$this look fit} $i} 0}
                     {do
                        {{$this find $b} set fit_text 1}
                        {{$this find $b} set width {elem {$this look fit} $i}}
                     }
                     {{$this find $b} set fit_text 0}
                  }
                  {{$this find $b} set alignment {if_else {>= $i 3} 34 33}}
                  {{$this find $b} set text_size {if_else {>= $i 3} {$this look lag_size} {$this look lefty_size}}}
                  {{$this find $b} set_local_pos {'+' $sx {elem {$this look text_x} $i}} $y
                     {'+' {'+' $top {'*' {elem $row 1} $gap}} {$this look text_dz}}}
                  {{$this find $b} set_showing TRUE}
                  {{$this find $b} set_state kNormal}
                  {{$this find $b} set draw_order 1}
                  ; And a label of the same text in the same place and
                  ; face, which is what shows of a row in [steady]
                  ; (sync_rows).
                  {new BandLabel $l}
                  {{$this find $l} copy gs_title.lbl 0}
                  {{$this find $l} set_type {{$this find $b} get_type}}
                  {{$this find $l} set trans_parent $view}
                  {{$this find $l} set_local_rot 0 0 0}
                  {{$this find $l} set_local_scale 1 1 1}
                  {foreach $prop (fit_text width alignment text_size kerning deltaZ deltaRot)
                     {{$this find $l} set $prop {{$this find $b} get $prop}}
                  }
                  {{$this find $b} get_local_pos $x $y $z}
                  {{$this find $l} set_local_pos $x $y $z}
                  {{$this find $l} set draw_order 1}
                  {set $i {'+' $i 1}}
               }
            }
            {set $i 0}
            {foreach $box (gm_p1.chk gm_p2.chk)
               {new {stereo.chk class_name} $box}
               {{$this find $box} copy stereo.chk 0}
               {{$this find $box} set trans_parent $view}
               {{$this find $box} set_local_pos {'+' $sx {elem {$this look box_x} $i}} $y
                  {'+' {'+' $top {'*' 3 $gap}} {$this look box_dz}}}
               {{$this find $box} set_showing TRUE}
               {{$this find $box} set draw_order 1}
               {set $i {'+' $i 1}}
            }
            ; The row's name is no stop: it leads to itself, and nothing to it.
            {gm_lefty.btn set nav_down gm_lefty.btn}
            {$view get_local_pos $x $y $z}
            {$view set_local_pos {'+' $x {elem {$this look block} 1}} $y {'+' $z {elem {$this look block} 2}}}
            {$view set_local_scale {elem {$this look block} 0} 1 {elem {$this look block} 0}}
            {set [row_top] $top}
            {set [row_gap] $gap}
            {set [view_z] {'+' $z {elem {$this look block} 2}}}
            {{$this loaded_dir} sync_objects}
         }
      }
   )
   ; Each number in the colour its track was last drawn in, whatever the
   ; scene and the state: a frame behind it.
   (poll {$this sync_numbers} {$this sync_tune})
   ; Each number as its slider is, and the help bar. A label given a colour
   ; goes back to its token's text, so the text is set after: as the label
   ; sets its own, which is what puts its letters off their line.
   (sync_numbers
      {foreach $row ((gs_band.sld gs_easy.lbl easy) (gs_guitar.sld gs_hard.lbl hard) (gs_sfx.sld gs_length.lbl length))
         {do
            ($tenths
               {if_else {== {elem $row 2} length}
                  {highway_length}
                  {note_speed tenths {elem $row 2}}
               }
            )
            {{elem $row 1} set color {slider_scales colour {elem $row 0}}}
            {{elem $row 1} set_localized_text {sprintf "%d.%d" {int {/ $tenths 10}} {mod $tenths 10}}}
         }
      }
   )
   ; GH1's scenes, known by their rows' text, which is centred.
   (gh1_scene {== {gs_stereo.btn get alignment} 34})
   ; A measure of the rows' look: the panel's own, or in GH1's scene what
   ; [gh1] has for it.
   (look ($key)
      {if_else {&& {$this gh1_scene} {find_exists [gh1] $key}}
         {elem {find [gh1] $key} 1}
         {$this get $key}
      }
   )
   (sync_look
      {$this sync_numbers}
      ; A token with no string reads as itself: GH1's scenes in a song have
      ; none of ours.
      {if {exists gm_engine.btn}
         {gm_engine.btn set text_token {if_else {== gh1 {note_engine}} "ENGINE GH1" "ENGINE GH2"}}
      }
      {if {exists gm_unlock.btn}
         {gm_unlock.btn set text_token {if_else {campaigns unlock_all} "UNLOCK ALL ON" "UNLOCK ALL OFF"}}
      }
      {$this sync_rows}
      {helpbar set_display
         {if_else {$this slider_selected}
            ((fret1 help_confirm) (fret2 help_cancel) (fret3 help_reset) (strum help_updown))
            {if_else {$this on_slider}
               ((fret1 help_select) (fret2 help_back) (fret3 help_reset) (strum help_updown))
               {if_else {|| {== [at] "gm_lag.btn"} {== [at] "gm_engine.btn"} {== [at] "gm_unlock.btn"}}
                  ((fret1 help_select) (fret2 help_back) (strum help_updown))
                  ((fret1 help_onoff) (fret2 help_back) (strum help_updown))
               }
            }
         }
      }
   )
   (on_slider {|| {== [at] "gs_band.sld"} {== [at] "gs_guitar.sld"} {== [at] "gs_sfx.sld"}})
   ; The rows under the sliders, each its button or, for one in [steady],
   ; its label: in the colour the scene has for a row that is lit, off or
   ; neither, and none of them while a slider is being tuned. The lefty
   ; row's name is lit with either of its boxes, and P2's is off with one
   ; player.
   (sync_rows
      ; Not before lay_out has made them: the focus is given first.
      {foreach $row {if_else {exists gm_lag.lbl} [rows] ()}
         {do
            ($b {elem $row 0})
            ($l {elem $row 3})
            ($steady FALSE)
            ($dir {$this loaded_dir})
            {foreach $s [steady] {if {== $s $b} {set $steady TRUE}}}
            {{$this find $b} set_showing
               {&& {! $steady} {! [tuning]} {! {&& {== $b gm_unlock.btn} {$this in_song}}}}}
            {{$this find $l} set_showing {&& $steady {! [tuning]}}}
            {if $steady
               {{$this find $l} set color
                  {cond
                     ({&& {== $b gm_p2.btn} {! {$this two_players}}} {$dir get disabled_color})
                     ({|| {== [at] {sprint $b}} {&& {== $b gm_lefty.btn} {|| {== [at] "gm_p1.btn"} {== [at] "gm_p2.btn"}}}}
                        {$dir get focus_color})
                     (TRUE {$dir get normal_color})
                  }
               }
               ; A label given a colour goes back to its token's text.
               {{$this find $l} set_localized_text {elem $row 2}}
            }
         }
      }
   )
   ; The highway's length is 50 to 200 by fives; one the settings file has
   ; past that is on the last.
   (length_stop {min 30 {int {/ {'-' {highway_length} 50} 5}}})
   ; That slider's setting, put to that stop: when it is another stop, so
   ; a setting past the last, which the settings file alone can make, is
   ; kept until its slider is moved.
   (keep ($slider $stop)
      {switch $slider
         (gs_band.sld {if {!= $stop {note_speed stop easy}} {note_speed set_stop easy $stop} {$this retrack}})
         (gs_guitar.sld {if {!= $stop {note_speed stop hard}} {note_speed set_stop hard $stop} {$this retrack}})
         (gs_sfx.sld
            {if {!= $stop {$this length_stop}}
               {highway_length set {'+' 50 {'*' 5 $stop}}}
               {ghc_highway}
               {$this retrack}
            }
         )
      }
   )
   ; In a song its tracks are made again as they are set, where the song
   ; has got to: as the game makes them when its intro is skipped
   ; (track_panel.dta's intro_skip).
   (retrack {if {$this in_song} {track_panel intro_skip}})
   (in_song {== {$this name} pause_game_settings_panel})
   ; In a song, the one note speed its tracks go by, easy or hard, and the
   ; other is put away: none where there are both to set, out of a song or
   ; with two players a pair apart.
   (one_speed
      {if_else {$this in_song}
         {do
            ($first {>= {game get_difficulty 0} kDifficultyHard})
            {if_else {&& {> {game num_players} 1} {!= $first {>= {game get_difficulty 1} kDifficultyHard}}}
               none
               {if_else $first hard easy}
            }
         }
         none
      }
   )
   ; A slider picked in a song is tuned by eye: the poster, its title and
   ; every other row go, and the slider stands to the right of the tracks
   ; until it is let go. What went comes back as the screen is entered.
   (sync_tune
      {if {$this in_song}
         {do
            ($now {if_else {$this slider_selected} 1 0})
            {if {!= $now [tuning]}
               {set [tuning] $now}
               {$this tune $now}
            }
         }
      }
   )
   (tune ($on)
      {do
         ($x 0) ($y 0) ($z 0)
         ($view {gs_band.sld get trans_parent})
         {foreach $o
            (gs_tile1.mesh gs_tile2.mesh gs_tile3.mesh gs_tile4.mesh gs_title.lbl gm_p1.chk gm_p2.chk)
            {if {exists $o} {{$this find $o} set_showing {! $on}}}
         }
         {$this sync_rows}
         {foreach $row ((gs_band.sld gs_easy.lbl easy) (gs_guitar.sld gs_hard.lbl hard) (gs_sfx.sld gs_length.lbl length))
            {do
               ($shown
                  {if_else $on
                     {== [at] {sprint {elem $row 0}}}
                     {|| {== {$this one_speed} none} {== {elem $row 2} length} {== {elem $row 2} {$this one_speed}}}
                  }
               )
               {{elem $row 0} set_showing $shown}
               {{elem $row 1} set_showing $shown}
            }
         }
         {$view get_local_pos $x $y $z}
         {if $on {set [tune_x] $x}}
         {$view set_local_pos {if_else $on {'+' $x [tune_dx]} [tune_x]} $y $z}
         ; Black behind it, to read over the venue, a little of the venue
         ; left through it: a round-ended box (box.dta) drawn before the
         ; rows. It stands a little behind the row, whose scale is tested
         ; against it.
         {if {! {exists gs_tune_bg.mat}}
            {ghc_box_make $this gs_tune_bg $view -1}
            {ghc_box_color $this gs_tune_bg 0 0 0 [tune_bg_alpha]}
            {{$this loaded_dir} sync_objects}
         }
         {{$this find [at]} get_local_pos $x $y $z}
         {ghc_box_put $this gs_tune_bg
            {'+' $x {elem {$this look tune_bg} 0}}
            {'+' $y 2}
            {'+' $z {elem {$this look tune_bg} 1}}
            {'*' 16 {elem {$this look tune_bg} 2}}
            {'*' 40 {elem {$this look tune_bg} 3}}
            [tune_bg_end]
            [tune_bg_end]
         }
         {ghc_box_show $this gs_tune_bg $on}
      }
   )
   (FOCUS_MSG
      {set [at] {$new_focus name}}
      {$this sync_look}
   )
   ; Sent by the slider each time its value moves (BandSlider::SetCurrent,
   ; 0x296d18).
   (slider_start_msg
      ($component)
      {$this keep $component {$component current}}
      {$this sync_look}
   )
   (slider_select_cancel
      ($component)
      {$component set_current [picked_at]}
      {$this keep $component [picked_at]}
      {$this sync_look}
      kDataUnhandled
   )
   (SELECT_START_MSG
      ; A slider's is the panel's to take; a row's is done here.
      {if_else {$this on_slider}
         {do
            {set [picked_at] {$component current}}
            {$this sync_look}
            kDataUnhandled
         }
         {do
            {switch $component
               ; A track is made the way its player plays (Track::Track reads
               ; it, 0x14febc), so in a song it turns round as the box does,
               ; where the game's own Video Settings asked for a restart.
               (gm_p1.btn {gm_p1.chk toggle} {options set_lefty 0 {gm_p1.chk get_check}} {$this retrack})
               (gm_p2.btn {gm_p2.chk toggle} {options set_lefty 1 {gm_p2.chk get_check}} {$this retrack})
               (gm_lag.btn {lag_panel set from_panel $this} {ui goto_screen {ghc_pause_screen [lag_screen]}})
               ; Judged from the next song loaded: in one, this one again.
               (gm_engine.btn
                  {if {&& {note_engine set {note_engine next {note_engine}}} {$this in_song}}
                     {pause_screen restart}
                  }
               )
               ; Every song, venue, guitarist and guitar open outside a
               ; career, from the next list shown (campaigns.cpp).
               (gm_unlock.btn {campaigns unlock_all {! {campaigns unlock_all}}})
            }
            {synth play_sequence button_toggle}
            {$this sync_look}
         }
      }
   )
   (BUTTON_DOWN_MSG
      {if_else {&& {== $button kPad_Circle} {$this on_slider}}
         {do
            ; The game's own: the length's is 110, its twelfth stop past 50.
            {cond
               ({== [at] "gs_band.sld"} {gs_band.sld set_current {note_speed reset easy}})
               ({== [at] "gs_guitar.sld"} {gs_guitar.sld set_current {note_speed reset hard}})
               (TRUE {gs_sfx.sld set_current 12} {$this keep gs_sfx.sld 12})
            }
            {synth play_sequence button_toggle}
            {$this sync_look}
         }
         kDataUnhandled
      }
   )
)
#define PAUSE_GAME_SCREEN (
   (focus pause_game_settings_panel)
   (in_game TRUE)
   (allow_back FALSE)
   (animate_transition FALSE)
   (BUTTON_DOWN_MSG
      {if {&& {! {pause_game_settings_panel slider_selected}} {== $button kPad_Tri}}
         {synth play_sequence button_back.cue}
         {ui goto_screen {ghc_pause_screen pause_settings_screen}}
      }
      kDataUnhandled
   )
)
; Made once, where this is run again.
{if {! {exists game_settings_screen}}
{new SliderPanel game_settings_panel
   (file ui/game_settings.milo)
   (shift 0)
   (shift_gh1 -10)
   (value_dx 147)
   (value_dz -19)
   (value_size 42)
   (value_squish 0.5)
   (value_shrink 0.72)
   (value_dip 1)
   (value_tilt 4)
   ; Closer, and its button rows smaller, than the pause menu's: out of a
   ; song it has unlock all's row too.
   (pitch 0.65)
   (block (0.88 0 38))
   (text_x (-124 54 132 35 35 35))
   (box_x (26 104))
   (text_dz 0)
   (box_dz 0)
   (lefty_size 21)
   (lag_size 24)
   (fit (0 0 0 0 0 0))
   (gh1 ((block (0.88 0 12)) (lefty_size 29) (lag_size 36) (fit (0 24 24 250 250 250)) (text_x (-132 74 142 35 35 35)) (box_x (52 120))))
   (lag_screen lag_screen)
   ; As the main menu has it for its two-player row (main.dta).
   (two_players {! {game is_missing_multi_controller}})
   GAME_SETTINGS_HANDLERS
}
{new GHScreen game_settings_screen
   (panels meta game_settings_panel helpbar)
   (focus game_settings_panel)
   (allow_back FALSE)
   (BUTTON_DOWN_MSG
      {if {&& {! {game_settings_panel slider_selected}} {== $button kPad_Tri}}
         {$this backwards_anim}
         {synth play_sequence button_back.cue}
         {ui goto_screen options_screen}
      }
      kDataUnhandled
   )
}
{new SliderPanel pause_game_settings_panel
   (file ui/pause_audio_settings.milo)
   (shift -10)
   (value_dx 147)
   (value_dz -17)
   (value_size 34)
   (value_squish 0.5)
   (value_shrink 0.8)
   (value_dip 1)
   (value_tilt 4)
   (pitch 0.75)
   (block (0.88 0 30))
   (text_x (-124 54 132 35 35 35))
   (box_x (26 104))
   (text_dz 0)
   (box_dz 0)
   (lefty_size 21)
   (lag_size 30)
   (fit (0 0 0 0 0 0))
   (gh1 ((block (0.88 16 -2)) (lefty_size 29) (lag_size 44) (fit (0 24 24 250 250 250)) (text_x (-132 74 148 35 35 35)) (box_x (52 126)) (tune_bg (-183 -5 26.4 1.4))))
   (lag_screen pause_lag_screen)
   (two_players {> {game num_players} 1})
   GAME_SETTINGS_HANDLERS
}
{new GHScreen pause_game_settings_screen (panels GAME_PANELS pause_game_settings_panel helpbar) PAUSE_GAME_SCREEN}
}
{retype ghc_practice_game_screen ((panels PRACTICE_PANELS pause_game_settings_panel helpbar) PAUSE_GAME_SCREEN)}
; The lag screen from it, as the game's own (options.dta's pause_lag_screen),
; in practice.
{retype ghc_practice_lag_screen
   (
      (panels PRACTICE_PANELS lag_panel helpbar)
      (focus lag_panel)
      (clear_vram TRUE)
      (enter {hud set_showing FALSE} {track_panel set_showing FALSE})
   )
}

; The port's text, in place of the disc's for the same tokens (ui/locale.cpp).
;
; The save dialogs (ui/mem_card.dta), which spoke of a memory card (8MB) in
; MEMORY CARD slot 1. MemcardMgr's localize adds _ps2 to the token the
; dialog names. Each is the disc's wording with the least changed: the card
; is the save file or the drive, or goes where the sentence stands without
; it, the console is the system, and the game is Guitar Hero Classic. Above
; each is the disc's (ui/eng/locale.dta, SLUS-21447).
;
; The game has no card now, so the dialogs for a missing, changed, full or
; unformatted one cannot come up; they are reworded all the same, so none
; can ever name a card.

; "memory card error"
(mc_title_error "save file error")

; Boot

; "Checking status of memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. Do not remove the memory card, reset, or switch off console."
(mc_checking_ps2 "Checking status of save file. Do not remove drive, reset, or switch off system.")

; "Loading Guitar Hero II data. Do not remove memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}, reset, or switch off the console."
(load_loading_ps2 "Loading Guitar Hero Classic data. Do not remove drive, reset, or switch off the system.")

; "No Guitar Hero II save data present on memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. Guitar Hero II uses an Autosave feature. {REQ_SPACE} of free space is required to save game data. Do you want to create a save file now?"
(bootup_create_save_check_ps2 "No Guitar Hero Classic save data present. Guitar Hero Classic uses an Autosave feature. {REQ_SPACE} of free space is required to save game data. Do you want to create a save file now?")

; "Creating Guitar Hero II save file. Do not remove memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}, reset, or switch off console."
(bootup_create_save_ps2 "Creating Guitar Hero Classic save file. Do not remove drive, reset, or switch off system.")

; "Caution! Guitar Hero II uses an Autosave feature. Insertion of a memory card (8MB)(for PlayStation®2) beyond this point may cause data to be overwritten. Continue without saving?"
(bootup_caution_ps2 "Caution! Guitar Hero Classic uses an Autosave feature. Continue without saving?")

; "Caution! No Guitar Hero II save data found on memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. {REQ_SPACE} of free space is required to save game data. Continue without saving?"
(bootup_caution_nodata_ps2 "Caution! No Guitar Hero Classic save data found. {REQ_SPACE} of free space is required to save game data. Continue without saving?")

; "Corrupt data detected on memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. {REQ_SPACE} of free space is required to save game data. Replace the corrupt file and create a new save file?"
(bootup_corrupt_data_ps2 "Corrupt data detected. {REQ_SPACE} of free space is required to save game data. Replace the corrupt file and create a new save file?")

; "SAVE ERROR: A Guitar Hero II save file already exists on the memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. Select REPLACE to create a brand new save file, or LOAD to use that save data."
(bootup_replace_save_check_ps2 "SAVE ERROR: A Guitar Hero Classic save file already exists. Select REPLACE to create a brand new save file, or LOAD to use that save data.")

; Saving

; "Saving Guitar Hero II data. Do not remove memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}, reset, or switch off console."
(save_saving_ps2 "Saving Guitar Hero Classic data. Do not remove drive, reset, or switch off system.")

; "SAVE ERROR: Data was not saved successfully to the memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. Retry or Continue without saving?"
(save_error_ps2 "SAVE ERROR: Data was not saved successfully. Retry or Continue without saving?")

; "SAVE ERROR: Guitar Hero II data already exists on the memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. Overwrite previous data?"
(file_exists_error_ps2 "SAVE ERROR: Guitar Hero Classic data already exists. Overwrite previous data?")

; "WARNING: Saving will overwrite any existing Guitar Hero II data on the memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. Are you sure you want to save?"
(mc_save_confirm_ps2 "WARNING: Saving will overwrite any existing Guitar Hero Classic data. Are you sure you want to save?")

; "Before deleting a band, your current progress must be saved to a memory card (8MB)(for PlayStation®2). Any existing Guitar Hero II data may be overwritten."
(pre_delete_confirm_ps2 "Before deleting a band, your current progress must be saved. Any existing Guitar Hero Classic data may be overwritten.")

; Loading

; "WARNING: \nIf you load data from a memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}, you will lose your current game progress. Continue with load?"
(mc_load_confirm_ps2 "WARNING: \nIf you load data, you will lose your current game progress. Continue with load?")

; "LOAD FAILED: Corrupt data detected on the memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. Try loading again?"
(mc_corrupt_error_ps2 "LOAD FAILED: Corrupt data detected. Try loading again?")

; "No Guitar Hero II data on memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. Do you wish to insert a memory card (8MB)(for PlayStation®2) containing Guitar Hero II data and try loading again?"
(mc_nodata_error_ps2 "No Guitar Hero Classic data. Do you wish to try loading again?")

; No card, a changed card, no room

; "No memory card (8MB)(for PlayStation®2) detected in MEMORY CARD slot {SLOT}. Guitar Hero II uses an Autosave feature. {REQ_SPACE} of space is required to save game data. Do you want to start the game without saving?"
(bootup_nocard_ps2 "No save file detected. Guitar Hero Classic uses an Autosave feature. {REQ_SPACE} of space is required to save game data. Do you want to start the game without saving?")

; "No memory card (8MB)(for PlayStation®2) inserted in MEMORY CARD slot {SLOT}. Guitar Hero II uses an Autosave feature. {REQ_SPACE} of space is required to save game data. Do you want to start the game without saving?"
(bootup_save_card_removed_ps2 "No save file detected. Guitar Hero Classic uses an Autosave feature. {REQ_SPACE} of space is required to save game data. Do you want to start the game without saving?")

; "SAVE ERROR: No memory card (8MB)(for PlayStation®2) detected in MEMORY CARD slot {SLOT}. Do you wish to continue the game without saving?"
(no_card_error_ps2 "SAVE ERROR: No save file detected. Do you wish to continue the game without saving?")

; "No memory card (8MB)(for PlayStation®2) inserted in MEMORY CARD slot {SLOT}. Do you wish to insert a memory card (8MB)(for PlayStation®2) containing Guitar Hero II data and try loading again?"
(mc_nocard_error_ps2 "No save file detected. Do you wish to try loading again?")

; "LOAD FAILED:  No memory card (8MB)(for PlayStation®2) detected in MEMORY CARD slot {SLOT}. Do you wish to insert a memory card containing Guitar Hero II data and reattempt load?"
(mc_card_removed_error_ps2 "LOAD FAILED: No save file detected. Do you wish to reattempt load?")

; "The status of the memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT} has changed. Data may be overwritten. Proceed with save?"
(different_card_ps2 "The status of the save file has changed. Data may be overwritten. Proceed with save?")

; "Insufficient space on the memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. Insert a memory card with at least {REQ_SPACE} of free space, or create some space using the console browser. Continue without saving?"
(bootup_create_save_no_space_ps2 "Insufficient space on the drive. Continue without saving?")

; "Insufficient space on the memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. Insert a memory card with at least {REQ_SPACE} of free space, or create some space using the console browser. Continue without saving?"
(bootup_nospace_ps2 "Insufficient space on the drive. Continue without saving?")

; "Insufficient space on the memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. At least {REQ_SPACE} is needed to save this game data. Do you want to start the game without saving?"
(bootup_space_check_failed_ps2 "Insufficient space on the drive. At least {REQ_SPACE} is needed to save this game data. Do you want to start the game without saving?")

; "SAVE ERROR: Insufficient space on memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. {REQ_SPACE} of free space is required to save data. Do you want to continue without saving?"
(no_space_error_ps2 "SAVE ERROR: Insufficient space on the drive. {REQ_SPACE} of free space is required to save data. Do you want to continue without saving?")

; Formatting

; "The memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT} is unformatted. You must format this memory card to save game data. Do you wish to format the memory card in MEMORY CARD slot {SLOT}?"
(unformatted_card_ps2 "The save file is unformatted. You must format this save file to save game data. Do you wish to format the save file?")

; "Formatting memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. Do not remove your memory card, reset, or switch off the console."
(format_card_ps2 "Formatting save file. Do not remove your drive, reset, or switch off the system.")

; "FORMAT ERROR: An error occurred while attempting to format the memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. Retry format?"
(format_card_error_ps2 "FORMAT ERROR: An error occurred while attempting to format the save file. Retry format?")

; "FORMAT ERROR: There is no memory card (8MB)(for PlayStation®2) detected in MEMORY CARD slot {SLOT}. Please reinsert the memory card (8MB)(for PlayStation®2) and select retry to continue formatting."
(format_no_card_error_ps2 "FORMAT ERROR: There is no save file detected. Please select retry to continue formatting.")

; "FORMAT ERROR: The memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT} has already been formatted! Please reinsert unformatted memory card and select retry."
(already_formatted_error_ps2 "FORMAT ERROR: The save file has already been formatted! Please select retry.")

; "SAVE ERROR: Data could not be saved to the unformatted memory card (8MB)(for PlayStation®2) in MEMORY CARD slot {SLOT}. Retry or continue without saving?"
(no_format_warn_ps2 "SAVE ERROR: Data could not be saved to the unformatted save file. Retry or continue without saving?")

; A career without encores (content/encores.h) asks for songs of the venue's
; five where the disc's song_current_venue_encore asks for the encore.
(song_current_venue_gh1 "Beat %i/5 songs to continue")

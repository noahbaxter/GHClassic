; The high score screen, as the game's own (endgame.dta) but for its wait: once
; a name is in, the game flushed and then held the screen for 7 seconds with
; an empty help bar. It now moves on when the flush animation ends, 1 second
; in, and leaves the flush sound playing. One player with a profile
; (save/profiles.h) goes in under its name, already on the board, and
; continuing flushes it; a guest types a name, a career's starting as its
; band's.
{retype highscore_panel
   (
      ; From the ARK root: a path resolves against the file its array came
      ; from, and this one comes from no file.
      (file ui/highscore.milo)
      (active_ten 0)
      (auto_add TRUE)
      (placed FALSE)
      (flushed FALSE)
      (enter
         {set [auto_add] {&& {== {game num_players} 1} {!= {ghc_profile name 0} ""}}}
         {set [placed] FALSE}
         {set [flushed] FALSE}
         {hs_stats.lbl set_localized_text
            {sprintf
               {localize highscore_score_fmt}
               {game get_song_text}
               {localize {game get_difficulty_sym 0}}
            }
         }
         ; A custom song is in no table (its best is save.bin's), nor a run
         ; at another speed (content/song_speed.h), so on.
         {if_else {|| {custom ours {game get_song}} {!= {song_speed} 100}}
            {ui goto_screen complete_screen}
            {do
               ($score {player0 score})
               ($index {get_highscore_index $score})
               {$this fill_scores $index $score {$this get_default_name}}
               {if_else {!= $index 0}
                  {$this enter_score $index}
                  {if_else {== career {gamecfg get mode}}
                     {ui goto_screen complete_screen}
                     {$this view_scores}
                  }
               }
            }
         }
         {highscore_screen update_help_bar}
      )
      (fill_scores
         ($new_index $new_score $new_name)
         {do
            ($slot 0)
            {foreach_int $i 1 6
               {do
                  ($name 0)
                  ($score 0)
                  {if_else {== $i $new_index}
                     {$this set_entry $i $new_name $new_score}
                     {do
                        {highscores get_highscore $slot $name $score}
                        {$this set_entry $i $name $score}
                        {'++' $slot}
                     }
                  }
               }
            }
         }
      )
      (get_default_name
         {cond
            ({!= {ghc_profile name 0} ""} {ghc_profile name 0})
            ({== career {gamecfg get mode}} {campaign profile_name {campaign profile_slot}})
            (TRUE {highscores get_default_name})
         }
      )
      (set_entry
         ($index $name $score)
         {do
            ($name_lbl {sprintf "hs_name%d.lbl" $index})
            ($score_lbl {sprintf "hs_score%d.lbl" $index})
            {$name_lbl set_localized_text $name}
            {$score_lbl set_text {sprintf "%d" $score}}
         }
      )
      (get_text_entry
         ($index)
         {sprintf "hs_entry%d.ten" $index}
      )
      (get_name_label
         ($index)
         {sprintf "hs_name%d.lbl" $index}
      )
      (enter_score
         ($index)
         {hs_flush.tnm set_frame 0}
         {do
            ($ten {$this get_text_entry $index})
            {$ten set_text {$this get_default_name}}
            {if_else [auto_add]
               {do
                  {set [active_ten] 0}
                  {set [placed] TRUE}
                  {$this set_text_entry -1}
                  {hs_start.lbl set_showing FALSE}
                  ; The table keeps the name it is given, not a copy, so
                  ; the profile's as a symbol, which lasts.
                  {highscores add {symbol {$this get_default_name}} {player0 score}}
               }
               {do
                  {set [active_ten] $ten}
                  {$this set_text_entry $index}
                  {$this set_focus $ten}
               }
            }
            {printf {$ten get_text}}
         }
      )
      (view_scores
         {printf "view_scores\n"}
         {set [active_ten] 0}
         {$this set_text_entry -1}
         {hs_start.lbl set_showing FALSE}
      )
      (set_text_entry
         ($index)
         {foreach_int $i 1 6
            {{$this get_text_entry $i} set_showing {== $i $index}}
            {{$this get_name_label $i} set_showing {!= $i $index}}
         }
      )
      (get_active_ten
         {if_else [active_ten]
            {$this find [active_ten]}
            NULL
         }
      )
      (poll
         {if
            {&&
               {!= {$this get_active_ten} NULL}
               {{$this get_active_ten} is_done}
               {! [flushed]}
            }
            {$this flush}
         }
      )
      (flush
         {set [flushed] TRUE}
         {hs_flush.tnm animate (range 0 17) (period 1) (units kTaskUISeconds)}
         {play_sfx flush}
         {highscore_screen update_help_bar}
         {script_task
            (delay 1) ; the game's 7
            (units kTaskUISeconds)
            (script {ui goto_screen complete_screen})
         }
      )
   )
}
; The game's own (endgame.dta), but that continuing past a placed name
; flushes it first.
{amend highscore_screen
   (BUTTON_DOWN_MSG
      {if_else {== $button kPad_X}
         {do
            ($ten {highscore_panel get_active_ten})
            {cond
               ({highscore_panel get flushed} 0)
               ({highscore_panel get placed} {synth play_sequence button_select} {highscore_panel flush})
               ({|| {== $ten NULL} {$ten is_done}}
                  {synth play_sequence button_select}
                  {ui goto_screen complete_screen}
               )
            }
            kDataUnhandled
         }
         {if_else {highscore_panel get_active_ten} kDataUnhandled TRUE}
      }
   )
}

; Career, once a band is picked: which game's campaign to play, each with
; how far that band is through it. The band is the same band in every game.
; With one game there is nothing to pick, and the band leads to the
; difficulty screen as it always did.
;
; The picker is the practice speed screen's scene (sel_speed.milo, four
; buttons), in the skin of the game being played. Picking another game
; goes through ghc_switch_screen, which has no panels: there the switch
; happens ({campaigns switch}, content/campaigns.h), with nothing loaded that
; it changes.
{func ghc_campaigns {> {campaigns count} 1}}
{if {! {exists ghc_campaign_panel}} {new GHPanel ghc_campaign_panel}}
{retype ghc_campaign_panel
   (
      ; From the ARK root: a path resolves against the file its array came
      ; from, and this one comes from no file.
      (file ui/sel_speed.milo)
      (focus speed0.btn)
      (buttons (speed0.btn speed1.btn speed2.btn speed3.btn))
      (games ()) ; the games with a campaign, as the buttons list them
      (picked 0)
      (enter
         {title.lbl set_text ghc_select_campaign}
         {resize [games] 0}
         {foreach $g (gh1 gh2 gh2x gh80s)
            {if {campaigns has $g} {push_back [games] $g}}
         }
         {do
            ($count {size [games]})
            ($band {campaign profile_slot})
            {foreach_int $i 0 {size [buttons]}
               {do
                  ($btn {elem [buttons] $i})
                  {if_else {< $i $count}
                     {do
                        ($game {elem [games] $i})
                        {{{$this loaded_dir} find $btn} set_showing TRUE}
                        {$this enable $btn}
                        {$this label $i}
                        ; Down steps through the listed ones and wraps.
                        {{{$this loaded_dir} find $btn} set nav_down
                           {{$this loaded_dir} find {elem [buttons] {mod {'+' $i 1} $count}}}
                        }
                        {if {== $game {campaigns active}} {set [picked] $i}}
                     }
                     ; A hidden button links to itself, out of the way
                     ; (PanelDir::ComponentNav, 0x211040).
                     {do
                        {{{$this loaded_dir} find $btn} set_showing FALSE}
                        {$this disable $btn}
                        {{{$this loaded_dir} find $btn} set nav_down {{$this loaded_dir} find $btn}}
                     }
                  }
               }
            }
            {$this set_focus {elem [buttons] [picked]}}
         }
      )
      ; Button $i: its game, how far the band is through its career under
      ; the note engine picked, and that engine.
      (label
         ($i)
         {do
            ($game {elem [games] $i})
            ($engine {note_engine picked})
            ; The engine named only where there is another to pick.
            {{{$this loaded_dir} find {elem [buttons] $i}} set_localized_text
               {sprint {localize {sprint "campaign_" $game}} "  "
                  {campaigns progress $game {campaign profile_slot} $engine} "%"
                  {if_else {> {note_engine choices} 1} {sprint "  " {localize {sprint "ghc_engine_" $engine}}} ""}
               }
            }
         }
      )
      ; Every career to the next engine.
      (next_engine
         {note_engine pick {note_engine next {note_engine picked}}}
         {foreach_int $i 0 {size [games]} {$this label $i}}
      )
      (FOCUS_MSG
         {foreach_int $i 0 {size [games]}
            {if {== {sprint {$new_focus name}} {sprint {elem [buttons] $i}}} {set [picked] $i}}
         }
         kDataUnhandled
      )
   )
}
; The campaigns' help bar: yellow names the engine picked, and changes it.
{func ghc_campaign_helpbar
   {do
      ($array)
      ($engine {note_engine picked})
      {set $array ()}
      {resize $array 0}
      {push_back $array (fret1 help_select)}
      {push_back $array (fret2 help_back)}
      {if {> {note_engine choices} 1}
         {push_back $array {if_else {== gh1 $engine} (fret3 ghc_engine_gh1) (fret3 ghc_engine_gh2)}}
      }
      {push_back $array (strum help_updown)}
      {helpbar set_display $array}
   }
}
{if {! {exists ghc_campaign_screen}} {new GHScreen ghc_campaign_screen}}
{retype ghc_campaign_screen
   (
      (panels meta ghc_campaign_panel helpbar)
      (focus ghc_campaign_panel)
      (allow_back FALSE)
      ; The help bar puts up a screen's (helpbar ...) after its enter, so
      ; this one has none and sets its own.
      (enter {ghc_campaign_helpbar})
      ; Into that game's career, all its own, under the engine picked: by
      ; way of the switch, which goes straight on where there is nothing to
      ; change.
      (SELECT_START_MSG
         {set $ghc_switch {elem {ghc_campaign_panel get games} {ghc_campaign_panel get picked}}}
         {set $ghc_switch_next sel_difficulty_screen}
         {set $ghc_switch_as career}
         {ui goto_screen ghc_switch_screen}
         kDataUnhandled
      )
      (BUTTON_DOWN_MSG
         {cond
            ({== $button kPad_Tri}
               {$this backwards_anim}
               {synth play_sequence button_back.cue}
               {ui goto_screen chooseprof_screen}
               kDataUnhandled
            )
            ({&& {== $button kPad_Circle} {> {note_engine choices} 1} {! {ui in_transition}}}
               {synth play_sequence button_toggle}
               {ghc_campaign_panel next_engine}
               {ghc_campaign_helpbar}
               TRUE
            )
            (TRUE kDataUnhandled)
         }
      )
   )
}
; To $ghc_switch's menus outside a career, or with $ghc_switch_as career
; into its career, then on to $ghc_switch_next.
{set $ghc_switch_as menus}
{if {! {exists ghc_switch_screen}} {new GHScreen ghc_switch_screen}}
{retype ghc_switch_screen
   (
      (panels)
      (allow_back FALSE)
      (animate_transition FALSE)
      ; With no switch to make (that game's is what is up, or it is not
      ; there), straight on.
      (TRANSITION_COMPLETE_MSG
         {do
            ($as $ghc_switch_as)
            {set $ghc_switch_as menus}
            {if {! {campaigns switch $ghc_switch $ghc_switch_next $as}} {ui goto_screen $ghc_switch_next}}
         }
      )
   )
}
; The band list, as the game's own (manage_bands.dta) but that a band leads
; to the campaigns.
{retype chooseprof_screen
   (
      (panels meta chooseprof_panel helpbar)
      (focus chooseprof_panel)
      (allow_back FALSE)
      (helpbar
         (default
            (
               (fret1 help_select)
               (fret2 help_back)
               (strum help_updown)
            )
         )
      )
      (SELECT_START_MSG
         {do
            ($index {{ui focus_panel} get button_idx})
            ($next {if_else {ghc_campaigns} ghc_campaign_screen sel_difficulty_screen})
            {campaign set_profile_slot $index}
            {if_else {! {campaign is_empty_profile $index}}
               {ui goto_screen $next}
               {do
                  {nameprof_screen set profile_slot $index}
                  {nameprof_screen set back_screen chooseprof_screen}
                  {nameprof_screen set next_screen $next}
                  {nameprof_screen set is_editing FALSE}
                  {ui goto_screen nameprof_screen}
               }
            }
         }
         kDataUnhandled
      )
      (BUTTON_DOWN_MSG
         {if {== $button kPad_Tri}
            {$this backwards_anim}
            {synth play_sequence button_back.cue}
            {ui goto_screen main_screen}
         }
         kDataUnhandled
      )
   )
}
; The difficulty screen, as the game's own (career.dta) but that back leads
; to the campaigns.
{retype sel_difficulty_screen
   (
      (panels meta sel_diff_career_panel helpbar char_single)
      (focus sel_diff_career_panel)
      (helpbar
         (default
            (
               (fret1 help_continue)
               (fret2 help_back)
               (strum help_updown)
            )
         )
      )
      (SELECT_START_MSG
         {sel_diff_career_panel set_difficulty $component 0}
         {if_else {campaign new_campaign}
            {ui goto_screen sel_character_new_screen}
            {do
               {campaign get_character_info}
               {ui goto_screen career_screen}
            }
         }
         kDataUnhandled
      )
      (BUTTON_DOWN_MSG
         {if {== $button kPad_Tri}
            {$this backwards_anim}
            {synth play_sequence button_back.cue}
            {ui goto_screen {if_else {ghc_campaigns} ghc_campaign_screen chooseprof_screen}}
         }
         kDataUnhandled
      )
   )
}
; The venue map, as the game's own (career.dta) but that a venue the
; campaign has none of is off it: GH1's career plays in six of GH2's eight.
{retype sel_venue_panel
   (
      ; From the ARK root: a path resolves against the file its array came
      ; from, and this one comes from no file.
      (file ui/sel_venue.milo)
      (focus sv_battle.btn)
      (enter
         {foreach $v
            (
               (battle sv_battle.btn) (small1 sv_small1.btn) (small2 sv_small2.btn) (big sv_big.btn)
               (theatre sv_theatre.btn) (fest sv_fest.btn) (arena sv_arena.btn) (stone sv_stone.btn)
            )
            {if {&& {exists {elem $v 1}} {! {find_elem {find $syscfg venues} {elem $v 0}}}}
               {$this disable {elem $v 1}}
               {{$this find {elem $v 1}} set_showing FALSE}
            }
         }
      )
   )
}
; The store's first screen without the categories the campaign sells nothing
; in (GH1 has no outfits): each off, and down stepping through the rest.
{func ghc_store_categories
   {do
      ($dir {store_panel loaded_dir})
      ($shown)
      {set $shown ()}
      {resize $shown 0}
      {foreach $c
         (
            (guitar st_guitars.btn) (skin st_skins.btn) (song st_songs.btn)
            (character st_characters.btn) (outfit st_outfits.btn) (video st_videos.btn)
         )
         {if {$dir exists {elem $c 1}}
            {if_else {&& {find_exists $syscfg store {elem $c 0}} {> {size {find $syscfg store {elem $c 0}}} 1}}
               {push_back $shown {elem $c 1}}
               {do
                  {{$dir find {elem $c 1}} set_showing FALSE}
                  {store_screen disable {$dir find {elem $c 1}}}
                  {{$dir find {elem $c 1}} set nav_down {$dir find {elem $c 1}}}
               }
            }
         }
      }
      {foreach_int $i 0 {size $shown}
         {{$dir find {elem $shown $i}} set nav_down
            {$dir find {elem $shown {mod {'+' $i 1} {size $shown}}}}
         }
      }
   }
}
; The guitars' price range over those in stock: the game's own counts one
; the band has yet to earn (a reward guitar, the controller), which the
; store names no price for.
{func ghc_store_range
   {if {== {store_panel get category} guitar}
      {do
         ($low 0)
         ($high 0)
         ($some FALSE)
         {foreach_int $i 0 {store_guitar_provider list_length}
            {if {store_guitar_provider in_stock $i}
               {do
                  ($price {store_panel price guitar {store_guitar_provider get_symbol $i}})
                  {if {|| {! $some} {< $price $low}} {set $low $price}}
                  {if {|| {! $some} {> $price $high}} {set $high $price}}
                  {set $some TRUE}
               }
            }
         }
         {if $some
            {{store_panel find st_costrange.lbl} set_localized_text
               {sprintf {localize category_cost} $low $high}
            }
         }
      }
   }
}
; The store, as the game's own (career.dta) with those on entering.
{retype store_screen
   (
      (panels meta store_back_panel store_guitar_display_panel store_video_panel char_store store_panel helpbar)
      (focus store_panel)
      (enter {ghc_store_categories} {ghc_store_range})
      ; After the panel's own, which writes the game's range.
      (FOCUS_MSG
         {script_task (delay 0) (units kTaskUISeconds) (script {ghc_store_range})}
         kDataUnhandled
      )
      (BUTTON_DOWN_MSG
         {cond
            ({&& {is_updown_button $button} {{store_panel find st_screen2.view} showing}}
               {store_panel update_index {if_else {== $button kPad_DDown} 1 -1}}
            )
            ({== $button kPad_Tri}
               {synth play_sequence button_back.cue}
               {if_else {{store_panel find st_screen1.view} showing}
                  {do {store_screen backwards_anim} {autosave_goto career_screen}}
                  {do {store_panel hide_models} {store_panel show_store_screen_1}}
               }
               kDataUnhandled
            )
            ({&& {== $button kPad_X} {{store_panel find st_screen2.view} showing}}
               {if_else {store_panel can_buy_item}
                  {do
                     {campaign buy_item {store_panel get item_name} {store_panel get_item_price}}
                     {store_panel update_store_item_sold}
                     {store_panel update_total_cash_display}
                     {if {== {store_panel get category} guitar} {store_skin_provider init_data}}
                     {ui push_screen store_bought_screen}
                     {play_sfx cash_register}
                  }
                  {play_sfx button_error}
               }
               TRUE
            )
            (TRUE kDataUnhandled)
         }
      )
   )
}

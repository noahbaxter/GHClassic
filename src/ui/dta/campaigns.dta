; Career, once a band is picked: which game's campaign to play, each with
; how far that band is through it. The band is the same band in every game.
; With one game there is nothing to pick, and the band leads to the
; difficulty screen as it always did.
;
; The picker is the practice speed screen's scene (sel_speed.milo, four
; buttons), in the skin of the game being played: in GH2's and the 80s',
; the Demo's amp poster and a case for each game, the picked one spinning
; over how far the band is through it, and the note engine's mark
; (content/campaign_case.h). Picking another game
; goes through ghc_switch_screen, which has no panels: there the switch
; happens ({campaigns switch}, content/campaigns.h), with nothing loaded that
; it changes.
{func ghc_campaigns {> {campaigns count} 1}}
{if {! {exists ghc_campaign_panel}} {new GHPanel ghc_campaign_panel}}
{retype ghc_campaign_panel
   (
      ; From the ARK root: a path resolves against the file its array came
      ; from, and this one comes from no file.
      (file ui/sel_speed.milo)
      (focus speed0.btn)
      (buttons (speed0.btn speed1.btn speed2.btn speed3.btn))
      (games ()) ; the games with a campaign, as the buttons list them
      (picked 0)
      (enter
         {title.lbl set_text ghc_select_campaign}
         {resize [games] 0}
         {foreach $g (gh1 gh2 gh2x gh80s)
            {if {campaigns has $g} {push_back [games] $g}}
         }
         {do
            ($count {size [games]})
            ($band {campaign profile_slot})
            ($x 0) ($y 0) ($z 0)
            ; The one line shown, the picked game's, just over the title,
            ; under the case, across where the scene's buttons stand. Taken
            ; once: the buttons are all moved there.
            ; A scene with no cases (GH1's own, content/campaign_case.h)
            ; keeps its list. GH2's is always listed, so has one where any do.
            {set [cased] {exists ghc_cover_gh2.mesh}}
            {if {&& [cased] {== [line_z] none}}
               {speed3.btn get_local_pos $x $y $z}
               {set [line_x] $x}
               {set [line_y] $y}
               {title.lbl get_local_pos $x $y $z}
               {set [title_z] $z}
               {set [line_z] {'+' {'-' $z [title_drop]} [line_above]}}
            }
            {foreach_int $i 0 {size [buttons]}
               {do
                  ($btn {elem [buttons] $i})
                  {if_else {< $i $count}
                     {do
                        ($game {elem [games] $i})
                        {$this enable $btn}
                        {$this label $i}
                        {if [cased]
                           {{{$this loaded_dir} find $btn} set_local_pos [line_x] [line_y] [line_z]}
                        }
                        ; Down steps through the listed ones and wraps.
                        {{{$this loaded_dir} find $btn} set nav_down
                           {{$this loaded_dir} find {elem [buttons] {mod {'+' $i 1} $count}}}
                        }
                        {if {== $game {campaigns active}} {set [picked] $i}}
                     }
                     ; A hidden button links to itself, out of the way
                     ; (PanelDir::ComponentNav, 0x211040).
                     {do
                        {{{$this loaded_dir} find $btn} set_showing FALSE}
                        {$this disable $btn}
                        {{{$this loaded_dir} find $btn} set nav_down {{$this loaded_dir} find $btn}}
                     }
                  }
               }
            }
            {$this set_focus {elem [buttons] [picked]}}
            {$this tint_line}
         }
         {set [spin_from] {taskmgr ui_seconds}}
         {$this show_line}
         {$this place_title}
         {$this lay_cases}
         {$this mark_engine}
      )
      ; The note engine picked, at the poster's foot on the right: its
      ; numeral, I for GH1's and II for GH2's, in a ring (content/
      ; campaign_case.h). The ring: where its middle is and how big, in the
      ; poster's units. The numeral: a copy of the title, this far across and
      ; down from where the title stands, its text this much of the title's.
      (engine_x 150)
      (engine_y -20)
      (engine_z -150)
      (engine_scale 14)
      (numeral_x 152)
      (numeral_z -63)
      (numeral_size 0.45)
      (mark_engine
         {if [cased]
            {do
               ($ring {$this find ghc_engine.mesh})
               ($title {$this find title.lbl})
               ($group {$title get trans_parent})
               ($x 0) ($y 0) ($z 0)
               {{$this find ghc_engine.mat} set prelit TRUE}
               {$ring set_local_pos [engine_x] [engine_y] [engine_z]}
               {$this turn $ring 0 [engine_scale]}
               {if {! {{$this loaded_dir} exists ghc_numeral.lbl}}
                  {do
                     ($lbl {new {$title class_name} ghc_numeral.lbl})
                     {$lbl copy $title 0}
                     {$lbl set trans_parent $group}
                     {$lbl set fit_text 0}
                     {$lbl set text_size {'*' [numeral_size] {$title get text_size}}}
                     {$group insert (objects {$group size objects}) $lbl}
                  }
               }
               {$title get_local_pos $x $y $z}
               {{$this find ghc_numeral.lbl} set_local_pos {'+' $x [numeral_x]} $y {'+' $z [numeral_z]}}
               {{$this find ghc_numeral.lbl} set_localized_text {if_else {== gh1 {note_engine picked}} "I" "II"}}
               ; Only where there is another to pick.
               {$ring set_showing {> {note_engine choices} 1}}
               {{$this find ghc_numeral.lbl} set_showing {> {note_engine choices} 1}}
            }
         }
      )
      ; With cases, the title moves down off the poster's red and white
      ; into its black below the city, where it reads: by this much, in its
      ; parent's units, and the line stands this far over it.
      (title_drop 70)
      (line_above 77)
      (title_z none)
      (place_title
         {if [cased]
            {do
               ($x 0) ($y 0) ($z 0)
               {title.lbl get_local_pos $x $y $z}
               {title.lbl set_local_pos $x $y {'-' [title_z] [title_drop]}}
            }
         }
      )
      (cased FALSE)
      (line_x 0)
      (line_y 0)
      (line_z none)
      ; With cases, only the picked game's button shows.
      (show_line
         {foreach_int $i 0 {size [games]}
            {{{$this loaded_dir} find {elem [buttons] $i}} set_showing {|| {! [cased]} {== $i [picked]}}}
         }
      )
      ; Each game's front cover, flat, in a row along the poster's foot, the
      ; picked one bigger and nearer; and over the city, large, the picked
      ; game's case, spinning (content/campaign_case.h). The row: how big a
      ; cover is and the picked one, how far apart their middles stand, how
      ; high the row is and how far in front of the poster, the picked one's
      ; too. The case: how big, where its middle is, the angle it starts at,
      ; and how fast it spins, in degrees a second.
      (cover_scale 17)
      (cover_picked_scale 20)
      (cover_gap 58)
      (cover_z -144)
      (cover_y -12)
      (cover_picked_y -20)
      ; A cover not picked, dimmed to this much of its light.
      (cover_dim 0.45)
      (case_scale 40)
      (case_x 0)
      (case_y -40)
      (case_z 75)
      ; Its spin is the store's guitar's way, negative about the upright
      ; (store.milo's guitar_single.tnm: 0, -120, -240), from a little
      ; short of facing front, a wind-up before it comes round head on.
      (case_turn 45)
      (case_spin 90)
      ; When the picked case began to spin, from where it stood turned.
      (spin_from 0)
      ; The scene has a case for each game listed and no other
      ; (content/campaign_case.cpp), where the pack has its art.
      (lay_cases
         {foreach_int $i 0 {size [games]}
            {if {exists {symbol {sprint "ghc_cover_" {elem [games] $i} ".mesh"}}}
               {$this lay_case {elem [games] $i} $i}
            }
         }
      )
      ; Game $g's cover, the row's $i'th, and its case, shown while it is
      ; picked: the case's sleeve and plastic placed alike, drawn by depth,
      ; the plastic in the console's colour.
      (lay_case
         ($g $i)
         {do
            ($count {size [games]})
            ($picked {== $i [picked]})
            ($cover {$this find {symbol {sprint "ghc_cover_" $g ".mesh"}}})
            {$cover set_local_pos
               {'*' [cover_gap] {'-' $i {/ {'-' $count 1} 2.0}}}
               {if_else $picked [cover_picked_y] [cover_y]}
               [cover_z]
            }
            {$this turn $cover 0 {if_else $picked [cover_picked_scale] [cover_scale]}}
            ; Its Mat is the sleeve's too, which shows only while picked.
            {do
               ($light {if_else $picked 1 [cover_dim]})
               {{$this find {symbol {sprint "ghc_case_" $g ".mat"}}} set color {pack_color $light $light $light}}
            }
            {{$this find {symbol {sprint "ghc_case_" $g ".mat"}}} set z_mode 1}
            {{$this find {symbol {sprint "ghc_shell_" $g ".mat"}}} set z_mode 1}
            ; Its colour and light are in its vertex colours
            ; (content/campaign_case.cpp): drawn only by a prelit material.
            {{$this find {symbol {sprint "ghc_shell_" $g ".mat"}}} set prelit TRUE}
            {foreach $part (_sleeve.mesh _shell.mesh)
               {do
                  ($mesh {$this find {symbol {sprint "ghc_case_" $g $part}}})
                  {$mesh set_showing $picked}
                  {$mesh set_local_pos [case_x] [case_y] [case_z]}
                  {$this turn $mesh [case_turn] [case_scale]}
               }
            }
         }
      )
      ; A mesh turned $deg about the upright, at that size: a turn is set as
      ; a rotation alone, which drops the scale, so the scale is set after.
      (turn
         ($mesh $deg $scale)
         {$mesh set_local_rot 0 0 $deg}
         {$mesh set_local_scale $scale $scale $scale}
      )
      ; The picked game's case spins.
      (poll
         {do
            ($g {elem [games] [picked]})
            ($angle
               {mod {'-' {'+' [case_turn] 360} {mod {'*' [case_spin] {'-' {taskmgr ui_seconds} [spin_from]}} 360}} 360}
            )
            {foreach $part (_sleeve.mesh _shell.mesh)
               {if {exists {symbol {sprint "ghc_case_" $g $part}}}
                  {$this turn {$this find {symbol {sprint "ghc_case_" $g $part}}} $angle [case_scale]}
               }
            }
         }
      )
      ; Button $i: how far the band is through its game's career under the
      ; note engine picked ({campaigns progress}); once that is all of it,
      ; in gold, its share of the game's songs full combo'd on expert
      ; ({campaigns full_combos}). With cases that alone, the case naming
      ; the game, at line_size times the button's own size; in a list, the
      ; game's name before it.
      (line_size 1.5)
      (gold (1 0.78 0.16))
      (beaten
         ($game)
         {== {campaigns progress $game {campaign profile_slot} {note_engine picked}} 100}
      )
      (label
         ($i)
         {do
            ($game {elem [games] $i})
            ($btn {{$this loaded_dir} find {elem [buttons] $i}})
            ($band {campaign profile_slot})
            ($done {campaigns progress $game $band {note_engine picked}})
            ($shown
               {if_else {== $done 100}
                  {sprint {campaigns full_combos $game $band {note_engine picked}} "% FC"}
                  {sprint $done "%"}
               }
            )
            ; Its size first: setting it reads the button's own text again.
            {if [cased]
               {if {== [own_size] none} {set [own_size] {$btn get text_size}}}
               {$btn set fit_text 0}
               {$btn set text_size {'*' [line_size] [own_size]}}
            }
            {$btn set_localized_text
               {if_else [cased] $shown {sprint {localize {sprint "campaign_" $game}} "  " $shown}}
            }
         }
      )
      (own_size none)
      ; The picked game's line in gold once its career is beaten: a button
      ; draws in its dir's focus colour, the only one focused the picked
      ; game's. A colour set reads the buttons' own text again, so each is
      ; labelled after one.
      (own_focus_color none)
      ; Its scene is practice's speed picker's too.
      (exit
         {if {!= [own_focus_color] none} {{$this loaded_dir} set focus_color [own_focus_color]}}
      )
      (tint_line
         {do
            ($dir {$this loaded_dir})
            ($color)
            {if {== [own_focus_color] none} {set [own_focus_color] {$dir get focus_color}}}
            {set $color
               {if_else {&& [cased] {$this beaten {elem [games] [picked]}}}
                  {pack_color {elem [gold] 0} {elem [gold] 1} {elem [gold] 2}}
                  [own_focus_color]
               }
            }
            {if {!= $color {$dir get focus_color}}
               {$dir set focus_color $color}
               {foreach_int $i 0 {size [games]} {$this label $i}}
            }
         }
      )
      ; Every career to the next engine.
      (next_engine
         {note_engine pick {note_engine next {note_engine picked}}}
         {foreach_int $i 0 {size [games]} {$this label $i}}
         {$this tint_line}
         {$this mark_engine}
      )
      (FOCUS_MSG
         {foreach_int $i 0 {size [games]}
            {if {== {sprint {$new_focus name}} {sprint {elem [buttons] $i}}} {set [picked] $i}}
         }
         ; The case left stands turned again, and its line goes; the one
         ; picked spins from where it stood.
         {set [spin_from] {taskmgr ui_seconds}}
         {$this show_line}
         {$this lay_cases}
         {$this tint_line}
         kDataUnhandled
      )
   )
}
; The campaigns' help bar: yellow changes the engine, whose mark is on the
; poster.
{func ghc_campaign_helpbar
   {do
      ($array)
      {set $array ()}
      {resize $array 0}
      {push_back $array (fret1 help_select)}
      {push_back $array (fret2 help_back)}
      {if {> {note_engine choices} 1}
         {push_back $array (fret3 ghc_engine)}
      }
      {push_back $array (strum help_updown)}
      {helpbar set_display $array}
   }
}
{if {! {exists ghc_campaign_screen}} {new GHScreen ghc_campaign_screen}}
{retype ghc_campaign_screen
   (
      (panels meta ghc_campaign_panel helpbar)
      (focus ghc_campaign_panel)
      (allow_back FALSE)
      ; The help bar puts up a screen's (helpbar ...) after its enter, so
      ; this one has none and sets its own.
      (enter {ghc_campaign_helpbar})
      ; Into that game's career, all its own, under the engine picked: by
      ; way of the switch, which goes straight on where there is nothing to
      ; change.
      (SELECT_START_MSG
         {set $ghc_switch {elem {ghc_campaign_panel get games} {ghc_campaign_panel get picked}}}
         {set $ghc_switch_next sel_difficulty_screen}
         {set $ghc_switch_as career}
         {ui goto_screen ghc_switch_screen}
         kDataUnhandled
      )
      (BUTTON_DOWN_MSG
         {cond
            ({== $button kPad_Tri}
               {$this backwards_anim}
               {synth play_sequence button_back.cue}
               {ui goto_screen chooseprof_screen}
               kDataUnhandled
            )
            ; The engine changed, with a sound of the game it plays as: the
            ; guitar slider's lick for GH1's, the song start for GH2's.
            ({&& {== $button kPad_Circle} {> {note_engine choices} 1} {! {ui in_transition}}}
               {ghc_campaign_panel next_engine}
               {if_else {== gh1 {note_engine picked}}
                  {play_sfx slider_gtr}
                  {synth play_sequence button_play}
               }
               {ghc_campaign_helpbar}
               TRUE
            )
            (TRUE kDataUnhandled)
         }
      )
   )
}
; To $ghc_switch's menus outside a career, or with $ghc_switch_as career
; into its career, then on to $ghc_switch_next.
{set $ghc_switch_as menus}
{if {! {exists ghc_switch_screen}} {new GHScreen ghc_switch_screen}}
{retype ghc_switch_screen
   (
      (panels)
      (allow_back FALSE)
      (animate_transition FALSE)
      ; With no switch to make (that game's is what is up, or it is not
      ; there), straight on.
      (TRANSITION_COMPLETE_MSG
         {do
            ($as $ghc_switch_as)
            {set $ghc_switch_as menus}
            {if {! {campaigns switch $ghc_switch $ghc_switch_next $as}} {ui goto_screen $ghc_switch_next}}
         }
      )
   )
}
; The band list, as the game's own (manage_bands.dta) but that a band leads
; to the campaigns.
{retype chooseprof_screen
   (
      (panels meta chooseprof_panel helpbar)
      (focus chooseprof_panel)
      (allow_back FALSE)
      (helpbar
         (default
            (
               (fret1 help_select)
               (fret2 help_back)
               (strum help_updown)
            )
         )
      )
      (SELECT_START_MSG
         {do
            ($index {{ui focus_panel} get button_idx})
            ($next {if_else {ghc_campaigns} ghc_campaign_screen sel_difficulty_screen})
            {campaign set_profile_slot $index}
            {if_else {! {campaign is_empty_profile $index}}
               {ui goto_screen $next}
               {do
                  {nameprof_screen set profile_slot $index}
                  {nameprof_screen set back_screen chooseprof_screen}
                  {nameprof_screen set next_screen $next}
                  {nameprof_screen set is_editing FALSE}
                  {ui goto_screen nameprof_screen}
               }
            }
         }
         kDataUnhandled
      )
      (BUTTON_DOWN_MSG
         {if {== $button kPad_Tri}
            {$this backwards_anim}
            {synth play_sequence button_back.cue}
            {ui goto_screen main_screen}
         }
         kDataUnhandled
      )
   )
}
; The difficulty screen, as the game's own (career.dta) but that back leads
; to the campaigns.
{retype sel_difficulty_screen
   (
      (panels meta sel_diff_career_panel helpbar char_single)
      (focus sel_diff_career_panel)
      (helpbar
         (default
            (
               (fret1 help_continue)
               (fret2 help_back)
               (strum help_updown)
            )
         )
      )
      (SELECT_START_MSG
         {sel_diff_career_panel set_difficulty $component 0}
         {if_else {campaign new_campaign}
            {ui goto_screen sel_character_new_screen}
            {do
               {campaign get_character_info}
               {ui goto_screen career_screen}
            }
         }
         kDataUnhandled
      )
      (BUTTON_DOWN_MSG
         {if {== $button kPad_Tri}
            {$this backwards_anim}
            {synth play_sequence button_back.cue}
            {ui goto_screen {if_else {ghc_campaigns} ghc_campaign_screen chooseprof_screen}}
         }
         kDataUnhandled
      )
   )
}
; The venue map, as the game's own (career.dta) but that a venue the
; campaign has none of is off it: GH1's career plays in six of GH2's eight.
{retype sel_venue_panel
   (
      ; From the ARK root: a path resolves against the file its array came
      ; from, and this one comes from no file.
      (file ui/sel_venue.milo)
      (focus sv_battle.btn)
      (enter
         {foreach $v
            (
               (battle sv_battle.btn) (small1 sv_small1.btn) (small2 sv_small2.btn) (big sv_big.btn)
               (theatre sv_theatre.btn) (fest sv_fest.btn) (arena sv_arena.btn) (stone sv_stone.btn)
            )
            {if {&& {exists {elem $v 1}} {! {find_elem {find $syscfg venues} {elem $v 0}}}}
               {$this disable {elem $v 1}}
               {{$this find {elem $v 1}} set_showing FALSE}
            }
         }
      )
   )
}
; The store's first screen without the categories the campaign sells nothing
; in (GH1 has no outfits): each off, and down stepping through the rest.
{func ghc_store_categories
   {do
      ($dir {store_panel loaded_dir})
      ($shown)
      {set $shown ()}
      {resize $shown 0}
      {foreach $c
         (
            (guitar st_guitars.btn) (skin st_skins.btn) (song st_songs.btn)
            (character st_characters.btn) (outfit st_outfits.btn) (video st_videos.btn)
         )
         {if {$dir exists {elem $c 1}}
            {if_else {&& {find_exists $syscfg store {elem $c 0}} {> {size {find $syscfg store {elem $c 0}}} 1}}
               {push_back $shown {elem $c 1}}
               {do
                  {{$dir find {elem $c 1}} set_showing FALSE}
                  {store_screen disable {$dir find {elem $c 1}}}
                  {{$dir find {elem $c 1}} set nav_down {$dir find {elem $c 1}}}
               }
            }
         }
      }
      {foreach_int $i 0 {size $shown}
         {{$dir find {elem $shown $i}} set nav_down
            {$dir find {elem $shown {mod {'+' $i 1} {size $shown}}}}
         }
      }
   }
}
; The guitars' price range over those in stock: the game's own counts one
; the band has yet to earn (a reward guitar, the controller), which the
; store names no price for.
{func ghc_store_range
   {if {== {store_panel get category} guitar}
      {do
         ($low 0)
         ($high 0)
         ($some FALSE)
         {foreach_int $i 0 {store_guitar_provider list_length}
            {if {store_guitar_provider in_stock $i}
               {do
                  ($price {store_panel price guitar {store_guitar_provider get_symbol $i}})
                  {if {|| {! $some} {< $price $low}} {set $low $price}}
                  {if {|| {! $some} {> $price $high}} {set $high $price}}
                  {set $some TRUE}
               }
            }
         }
         {if $some
            {{store_panel find st_costrange.lbl} set_localized_text
               {sprintf {localize category_cost} $low $high}
            }
         }
      }
   }
}
; The store, as the game's own (career.dta) with those on entering.
{retype store_screen
   (
      (panels meta store_back_panel store_guitar_display_panel store_video_panel char_store store_panel helpbar)
      (focus store_panel)
      (enter {ghc_store_categories} {ghc_store_range})
      ; After the panel's own, which writes the game's range.
      (FOCUS_MSG
         {script_task (delay 0) (units kTaskUISeconds) (script {ghc_store_range})}
         kDataUnhandled
      )
      (BUTTON_DOWN_MSG
         {cond
            ({&& {is_updown_button $button} {{store_panel find st_screen2.view} showing}}
               {store_panel update_index {if_else {== $button kPad_DDown} 1 -1}}
            )
            ({== $button kPad_Tri}
               {synth play_sequence button_back.cue}
               {if_else {{store_panel find st_screen1.view} showing}
                  {do {store_screen backwards_anim} {autosave_goto career_screen}}
                  {do {store_panel hide_models} {store_panel show_store_screen_1}}
               }
               kDataUnhandled
            )
            ({&& {== $button kPad_X} {{store_panel find st_screen2.view} showing}}
               {if_else {store_panel can_buy_item}
                  {do
                     {campaign buy_item {store_panel get item_name} {store_panel get_item_price}}
                     {store_panel update_store_item_sold}
                     {store_panel update_total_cash_display}
                     {if {== {store_panel get category} guitar} {store_skin_provider init_data}}
                     {ui push_screen store_bought_screen}
                     {play_sfx cash_register}
                  }
                  {play_sfx button_error}
               }
               TRUE
            )
            (TRUE kDataUnhandled)
         }
      )
   )
}
